@model Orapmshms.Models.AutoPaymentPageViewModel
@{
    Layout = null;
    var ok = Model.Success;
    var idle = !Model.Attempted;
    var statusClass = idle ? "idle" : (ok ? "ok" : "err");
    var icon = idle ? "…" : (ok ? "✓" : "×");
    var title = idle ? "Automatic Payment" : (ok ? "Payment Completed" : "Payment Failed");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <style>
        :root { --ink:#0b1b33; --muted:#667085; --line:#e4e7ec; --bg:#f6f8fb; --ok:#11875d; --err:#d92d20; --idle:#315a9b; }
        * { box-sizing:border-box; }
        body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--bg); font-family:Inter,Segoe UI,Arial,sans-serif; color:var(--ink); }
        .card { width:min(520px,92vw); background:#fff; border:1px solid var(--line); border-radius:18px; box-shadow:0 20px 55px rgba(16,24,40,.12); padding:30px; }
        .icon { width:62px; height:62px; border-radius:50%; display:grid; place-items:center; color:#fff; font-size:30px; font-weight:800; margin-bottom:18px; }
        .icon.ok { background:var(--ok); } .icon.err { background:var(--err); } .icon.idle { background:var(--idle); }
        h1 { margin:0 0 8px; font-size:26px; } p { color:var(--muted); line-height:1.55; margin:0; }
        .details { margin-top:22px; border-top:1px solid var(--line); padding-top:14px; }
        .row { display:flex; justify-content:space-between; gap:18px; padding:8px 0; font-size:14px; }
        .row span:first-child { color:var(--muted); } .row strong { text-align:right; overflow-wrap:anywhere; }
        .receipt { display:inline-block; margin-top:18px; padding:11px 16px; border-radius:10px; background:var(--ink); color:#fff; text-decoration:none; font-weight:700; }
    </style>
</head>
<body>
<div class="card">
    <div class="icon @statusClass">@icon</div>
    <h1>@title</h1>
    <p>@Model.Message</p>

    @if (Model.Attempted)
    {
        <div class="details">
            @if (!string.IsNullOrWhiteSpace(Model.RegId))
            {
                <div class="row"><span>Reservation</span><strong>@Model.RegId</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.GuestName))
            {
                <div class="row"><span>Guest</span><strong>@Model.GuestName</strong></div>
            }
            @if (Model.Amount > 0)
            {
                <div class="row"><span>Amount</span><strong>@Model.Currency @Model.Amount.ToString("0.00")</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.PaymentIntentId))
            {
                <div class="row"><span>Payment ID</span><strong>@Model.PaymentIntentId</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ChargeId))
            {
                <div class="row"><span>Charge ID</span><strong>@Model.ChargeId</strong></div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ReceiptUrl))
        {
            <a class="receipt" href="@Model.ReceiptUrl" target="_blank" rel="noopener noreferrer">View Receipt</a>
        }
    }
</div>
</body>
</html>
