@model Orapmshms.Models.CheckInPageViewModel
@using System.Text.Json
@using System.Linq
@using Orapmshms.Models
@{
    ViewData["Title"] = "Guest Check-In";

    var g = Model.Guest ?? new GuestCheckInInput();

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    var stateJson = JsonSerializer.Serialize(Model, jsonOptions);

    var showDiscountColumn = Model.Charges.Any(x => x.Discount != 0m);

    var showTaxColumn = Model.Charges.Any(x => x.Gst != 0m);

    var showBedTaxColumn = Model.Charges.Any(x => x.BedTax != 0m);

    string Money(decimal value) => $"{Model.Currency}{value:N2}";

    string DateValue(DateTime value) => value == default ? "" : value.ToString("yyyy-MM-dd");

    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "—";

    string SecurityType(string status)

    {

        status = (status ?? string.Empty).Trim();

        if (status.Equals("refund", StringComparison.OrdinalIgnoreCase)) return "Refund";

        if (status.StartsWith("deduct", StringComparison.OrdinalIgnoreCase)) return "Deduct";

        return status.Equals("Deposit", StringComparison.OrdinalIgnoreCase) ? "Deposit" : (string.IsNullOrWhiteSpace(status) ? "Deposit" : status);

    }

    string SecurityStatus(string status)

    {

        status = (status ?? string.Empty).Trim();

        if (status.Equals("Deposit", StringComparison.OrdinalIgnoreCase)) return "On Hold";

        if (status.Equals("refund", StringComparison.OrdinalIgnoreCase)) return "Refunded";

        if (status.StartsWith("deduct", StringComparison.OrdinalIgnoreCase)) return "Deduct";

        return string.IsNullOrWhiteSpace(status) ? "On Hold" : status;

    }

    string SecurityMode(CheckInSecurityRow row)

    {

        var pm = (row.Method ?? string.Empty).Trim();

        var isMovement = row.Status.Equals("refund", StringComparison.OrdinalIgnoreCase) || row.Status.StartsWith("deduct", StringComparison.OrdinalIgnoreCase);

        var isCard = !string.IsNullOrWhiteSpace(row.PaymentIntentId) || !string.IsNullOrWhiteSpace(row.ChargeId) ||

                     pm.Contains("card", StringComparison.OrdinalIgnoreCase) || pm.Contains("pdq", StringComparison.OrdinalIgnoreCase) || pm.Contains("stripe", StringComparison.OrdinalIgnoreCase);

        if (isMovement) return isCard ? "Card" : "Cash";

        var isPreAuth = pm.Contains("pre-authorization", StringComparison.OrdinalIgnoreCase) || pm.Contains("pre-auth", StringComparison.OrdinalIgnoreCase);

        if (isPreAuth) return string.IsNullOrWhiteSpace(row.Last4) ? "Card Pre-Auth" : $"Card Pre-Auth (*** {row.Last4})";

        if (isCard) return string.IsNullOrWhiteSpace(row.Last4) ? "Card Terminal Hold" : $"Card Terminal (*** {row.Last4})";

        return "Cash";

    }
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/checkin-mvc.css")" asp-append-version="true" />
    <style>
        /* Critical layout fallback: keeps the Check-In screen usable and aligned even if
                   a browser/cache serves an older external stylesheet during deployment. */
        .ora-checkin {
            font-family: Inter,"Segoe UI",Arial,sans-serif;
            color: #102c4b;
            background: #f5f7f7;
            padding-bottom: 8px
        }

            .ora-checkin * {
                box-sizing: border-box
            }

            .ora-checkin .page-title {
                display: grid;
                grid-template-columns: minmax(0,2fr) minmax(340px,.88fr);
                align-items: center;
                gap: 10px;
                padding: 10px 18px 8px
            }

            .ora-checkin .checkin-title-copy h1 {
                margin: 0;
                color: #0b3768;
                font-size: 20px;
                font-weight: 800
            }

            .ora-checkin .checkin-title-copy p {
                margin: 1px 0 0;
                color: #60758d
            }

            .ora-checkin .search-wrap {
                position: relative;
                margin-left: 0;
                width: 100%
            }

            .ora-checkin .search {
                display: flex;
                position: relative;
                width: 100%
            }

                .ora-checkin .search input {
                    padding-left: 34px
                }

            .ora-checkin .search-icon {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                z-index: 2;
                color: #60758d
            }

            .ora-checkin .checkin-action-toolbar {
                display: none
            }

            .ora-checkin .layout {
                display: grid;
                grid-template-columns: minmax(0,2fr) minmax(340px,.88fr);
                gap: 10px;
                padding: 0 18px 4px
            }

            .ora-checkin .stack {
                display: grid;
                gap: 10px;
                align-content: start;
                min-width: 0
            }

            .ora-checkin .card {
                background: #fff;
                border: 1px solid #c8d5e4;
                border-radius: 7px;
                overflow: hidden;
                box-shadow: 0 1px 3px rgba(16,44,75,.07)
            }

            .ora-checkin .card-head {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 12px;
                background: #f1f6fc;
                border-bottom: 1px solid #d4dfec;
                color: #0b3768
            }

            .ora-checkin .card-body {
                padding: 10px 12px
            }

            .ora-checkin .grid {
                display: grid;
                grid-template-columns: repeat(4,minmax(0,1fr));
                gap: 8px 12px
            }

            .ora-checkin .span-2 {
                grid-column: span 2
            }

            .ora-checkin .field {
                min-width: 0
            }

                .ora-checkin .field > label, .ora-checkin .field-label {
                    display: block;
                    margin-bottom: 4px;
                    font-weight: 600;
                    color: #173653
                }

            .ora-checkin input, .ora-checkin select, .ora-checkin textarea {
                width: 100%;
                min-height: 34px;
                padding: 6px 9px;
                border: 1px solid #b9c9dc;
                border-radius: 4px;
                background: #fff;
                color: #173653
            }

                .ora-checkin input[type="checkbox"] {
                    width: 15px !important;
                    height: 15px !important;
                    min-width: 15px !important;
                    min-height: 15px !important;
                    padding: 0 !important;
                    margin: 0 !important;
                    vertical-align: middle;
                    flex: 0 0 15px
                }

            .ora-checkin textarea {
                min-height: 58px
            }

            .ora-checkin .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                min-height: 34px;
                padding: 6px 13px;
                border: 1px solid #0b3768;
                border-radius: 4px;
                font-weight: 700
            }

            .ora-checkin .btn-primary {
                background: #0b3768;
                color: #fff
            }

            .ora-checkin .btn-outline {
                background: #fff;
                color: #0b3768
            }

            .ora-checkin .table-wrap {
                overflow: auto;
                border: 1px solid #c5d3e3;
                border-radius: 6px
            }

            .ora-checkin .table {
                width: 100%;
                border-collapse: collapse
            }

                .ora-checkin .table th {
                    background: #dce8f8;
                    color: #173653
                }

                .ora-checkin .table th, .ora-checkin .table td {
                    padding: 7px 8px;
                    border-bottom: 1px solid #c5d3e3;
                    white-space: nowrap
                }

            .ora-checkin .totals {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 8px;
                margin-top: 9px
            }

            .ora-checkin .total {
                display: flex;
                justify-content: space-between;
                padding: 9px 11px;
                background: #edf4fc;
                color: #0b3768;
                border-radius: 6px
            }

        @@media(max-width:1100px) {
            .ora-checkin .layout,
            .ora-checkin .page-title {
                grid-template-columns: 1fr
            }

            .ora-checkin .search-wrap {
                width: 100%
            }
        }

        @@media(max-width:760px) {
            .ora-checkin .page-title {
                align-items: flex-start
            }

            .ora-checkin .search-wrap {
                width: 100%;
                margin-left: 0
            }

            .ora-checkin .layout {
                padding: 0 12px
            }

            .ora-checkin .checkin-action-toolbar {
                padding: 0 12px 12px
            }

            .ora-checkin .grid {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }
        }

        @@media(max-width:520px) {
            .ora-checkin .grid {
                grid-template-columns: 1fr
            }

            .ora-checkin .span-2 {
                grid-column: span 1
            }

            .ora-checkin .totals {
                grid-template-columns: 1fr
            }
        }

        /* Requested Check-In alignment overrides. */
        .ora-checkin #chargeEntry label,
        .ora-checkin #chargeOptionsRow label {
            font-size: 13px;
            line-height: 1.25;
            font-weight: 600;
            margin-bottom: 4px
        }

        .ora-checkin .charge-table th:last-child,
        .ora-checkin .charge-table td.row-actions {
            text-align: center
        }

        .ora-checkin .charge-table td.row-actions {
            justify-content: center;
            align-items: center
        }

        .ora-checkin .charge-table td.row-actions .icon-action {
            margin-left: auto;
            margin-right: auto
        }
    </style>
}

<div id="checkinApp"
     class="ora-checkin app"
     data-reg-id="@Model.ReservationId"
     data-visit-id="@Model.VisitId"
     data-currency="@Model.Currency"
     data-currency-code="@Model.CurrencyCode"
     data-date-mode="@Model.ReservationDateMode"
     data-month-wise="@(Model.IsMonthWise ? "1" : "0")"
     data-allow-dirty="@(Model.AllowDirtyRoom ? "1" : "0")"
     data-stripe="@(Model.IsStripeConfigured ? "1" : "0")"
     data-clover="@(Model.IsCloverConfigured ? "1" : "0")"
     data-card-permission="@(Model.CanCardPayment ? "1" : "0")"
     data-terminal-url="@Url.Content("~/TerminalCardPayment.aspx")"
     data-fbr="@(Model.FbrEnabled ? "1" : "0")">

    <form id="antiForgeryForm" class="hidden">@Html.AntiForgeryToken()</form>
    <script id="checkinInitialState" type="application/json">@Html.Raw(stateJson)</script>

    @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.LoadError)))

    {
        <div class="checkin-alert is-error"><i class="fa-solid fa-triangle-exclamation"></i><span>@ViewBag.LoadError</span></div>
    }

    <section class="page-title">
        <div class="checkin-title-copy">
            <h1>GUEST CHECK-IN</h1>
            <p>Register the guest, manage room/services, payments and stay actions from one screen.</p>
        </div>
        <div class="search-wrap">
            <div class="search" role="search">
                <label for="guestSearch" class="sr-only">Search guests</label>
                <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
                <input id="guestSearch" type="search" value="@(Model.IsExistingBooking ? Model.ReservationId : string.Empty)" placeholder="Search by reservation no. ,Phone no or name" autocomplete="off" />
                <button id="guestSearchButton" type="button" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
            <div id="searchResults" class="search-results hidden" role="listbox"></div>
        </div>
    </section>

    <form id="checkinForm" novalidate>
        <div class="layout">
            <div class="stack">
                <section class="card guest-card" aria-labelledby="guestHeading">
                    <div class="card-head">
                        <span class="card-icon"><i class="fa-regular fa-user"></i></span>
                        <div class="card-title"><h2 id="guestHeading">Guest &amp; Registration</h2></div>
                        <span class="card-meta">Hotel date: @Model.HotelToday.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="card-body">
                        <div id="guestRegistrationGrid" class="grid guest-grid-mvc">
                            <div class="field"><label for="firstName">First Name <b class="req">*</b></label><input id="firstName" maxlength="20" required autocomplete="given-name" value="@g.FirstName" /></div>
                            <div class="field"><label for="lastName">Last Name</label><input id="lastName" maxlength="20" autocomplete="family-name" value="@g.LastName" /></div>
                            <div class="field"><label for="phone">Contact Number</label><input id="phone" maxlength="50" type="tel" autocomplete="tel" value="@g.Phone" /></div>
                            <div class="field"><label for="email">Email</label><input id="email" maxlength="150" type="email" autocomplete="email" value="@g.Email" /></div>

                            <div class="field"><label for="passportNo">ID / Passport</label><input id="passportNo" maxlength="30" value="@g.PassportNo" /></div>
                            <div class="field"><label for="vatNo">VAT / CNIC No.</label><input id="vatNo" maxlength="30" value="@g.VatNo" /></div>
                            <div class="field"><label for="country">Country</label><select id="country"><option value="">--Select--</option>@foreach (var o in Model.Countries)
                                    {
                                        <option value="@o.Value">@o.Text</option>
                                    }</select></div>
                            <div class="field"><label for="city">City</label><select id="city"><option value="">--Select--</option>@foreach (var o in Model.Cities)
                                    {
                                        <option value="@o.Value">@o.Text</option>
                                    }</select></div>

                            <div class="field span-2 guest-address-field"><label for="address">Complete Address</label><input id="address" maxlength="200" value="@g.Address" /></div>
                            <div id="guestStayDatesField" class="field stay-date-field">
                                <label for="stayDateDisplay">Stay Dates</label>
                                <div id="stayDatePicker" class="date-picker">
                                    <input id="stayDateDisplay" class="date-picker-input" readonly aria-haspopup="dialog" aria-expanded="false" aria-controls="dateCalendar" />
                                    <input id="checkIn" type="hidden" value="@DateValue(g.ArrivalDate)" />
                                    <input id="checkOut" type="hidden" value="@DateValue(g.DepartureDate)" />
                                    <div id="dateCalendar" class="calendar-panel hidden" role="dialog" aria-label="Choose stay dates">
                                        <div class="calendar-header">
                                            <button id="previousMonth" type="button" class="calendar-nav" aria-label="Previous month"><i class="fa-solid fa-chevron-left"></i></button>
                                            <strong id="calendarMonth"></strong>
                                            <button id="nextMonth" type="button" class="calendar-nav" aria-label="Next month"><i class="fa-solid fa-chevron-right"></i></button>
                                        </div>
                                        <div class="calendar-weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                                        <div id="calendarDays" class="calendar-days"></div>
                                        <div id="calendarHint" class="calendar-hint">Select arrival date</div>
                                    </div>
                                </div>
                            </div>

                            <div id="guestStayCountField" class="field"><label for="stayCount">@(Model.IsMonthWise ? "Months" : "Nights")</label><input id="stayCount" readonly /></div>
                            <div class="field"><label for="source">Booking Source</label><div class="select-with-button"><select id="source"><option value="">--Select--</option>@foreach (var o in Model.Sources)
                                        {
                                            <option value="@o.Value">@o.Text</option>
                                        }</select><button id="manageSource" type="button" class="mini-action" title="Manage source"><i class="fa-solid fa-plus"></i></button></div></div>
                            <div class="field"><label for="company">Company</label><div class="select-with-button"><select id="company"><option value="">--Select--</option>@foreach (var o in Model.Companies)
                                        {
                                            <option value="@o.Value">@o.Text</option>
                                        }</select><button id="manageCompany" type="button" class="mini-action" title="Manage company"><i class="fa-solid fa-plus"></i></button></div></div>

                            <div id="guestActionRow" class="guest-inline-actions" aria-label="Guest actions">
                                <button id="guestProceedCheckIn" type="button" class="btn btn-primary @((Model.IsExistingBooking) ? "hidden" : "")"><i class="fa-solid fa-arrow-right-to-bracket"></i>Proceed Check-In</button>
                                <button id="updateGuest" type="button" class="btn btn-primary @((!Model.IsExistingBooking || !Model.CanUpdateGuest) ? "hidden" : "")"><i class="fa-solid fa-user-pen"></i>Update Guest Info</button>
                            </div>
                        </div>

                        <!-- Runtime-only values retained for WebForms parity; intentionally not shown in Guest Info. -->
                        <div class="checkin-runtime-fields hidden" aria-hidden="true">
                            <input id="arrivalTime" type="hidden" value="@g.ArrivalTime" />
                            <input id="departureTime" type="hidden" value="@g.DepartureTime" />
                            <select id="reservationType" tabindex="-1"><option value="Individual">Individual</option><option value="Group">Group</option></select>
                            <select id="reservationDateMode" tabindex="-1"><option value="groupSame">Same dates for all rooms</option><option value="groupDifferent">Different dates by room</option></select>
                            <input id="bookingId" type="hidden" value="@g.BookingId" />
                            <input id="groupName" type="hidden" value="@g.GroupName" />
                            <input id="complementary" type="checkbox" @(g.Complementary ? "checked" : null) tabindex="-1" />
                        </div>


                    </div>
                </section>

                <section class="card" aria-labelledby="roomsHeading">
                    <div class="card-head">
                        <span class="card-icon"><i class="fa-solid fa-bed"></i></span>
                        <div class="card-title"><h2 id="roomsHeading">Rooms &amp; Services</h2></div>
                    </div>
                    <div class="card-body">
                        <div id="chargeRoomDatesRow" class="charge-options-row charge-room-dates-row">
                            <div class="field room-date-col hidden"><label for="chargeArrival">Arrival</label><input id="chargeArrival" type="date" value="@DateValue(g.ArrivalDate)" /></div>
                            <div class="field room-date-col hidden"><label for="chargeDeparture">Departure</label><input id="chargeDeparture" type="date" value="@DateValue(g.DepartureDate)" /></div>
                            <input id="chargeNights" type="hidden" value="@Math.Max(0, (g.DepartureDate.Date - g.ArrivalDate.Date).Days)" />
                        </div>

                        <div id="chargeEntry" class="charge-row charge-row-mvc">
                            <div class="field charge-category-field">
                                <label for="chargeCategory">Categories</label>
                                <select id="chargeCategory">
                                    <option value="">--Select--</option>
                                    @foreach (var o in Model.Categories)

                                    {
                                        <option value="@o.Text" data-category-id="@o.Value" data-adult-limit="@o.AdultLimit" data-child-limit="@o.ChildLimit" data-infant-limit="@o.InfantLimit" data-occupancy-configured="@(o.HasOccupancySettings ? 1 : 0)">@o.Text</option>
                                    }
                                    <option value="Services" data-service="1">Services / Charges</option>
                                </select>
                            </div>

                            <div id="chargeDetailWrap" class="field charge-detail-wrap hidden">
                                <label for="chargeDetail">Details</label>
                                <input id="chargeDetail" maxlength="500" placeholder="Enter service / charge details" />
                            </div>

                            <div id="chargeRoomWrap" class="field charge-room-field hidden">
                                <label for="chargeRoom">Room No.</label>
                                <select id="chargeRoom"><option value="">--Select--</option></select>
                            </div>

                            <div id="ratePlanWrap" class="field rate-plan-field hidden">
                                <label for="ratePlan">Rate Plan</label>
                                <select id="ratePlan"><option value="">--Select--</option></select>
                            </div>

                            <div class="field charge-total-field">
                                <label for="chargeTotal">Total (@Model.Currency)</label>
                                <input id="chargeTotal" type="number" min="-999999999" step="0.01" />
                            </div>

                            @if (Model.HasDiscountPermission)

                            {
                                <div class="field charge-discount-field"><label for="discount">Discount (@Model.Currency)</label><input id="discount" type="number" min="0" step="0.01" value="0" /></div>
                            }

                            @if ((Model.HasGstPermission && Model.HasGst) ||
                                 (Model.HasBedTaxPermission && Model.HasBedTax && !Model.TaxLabel.Equals("VAT", StringComparison.OrdinalIgnoreCase)))
                            {
                                <div class="field charge-tax-field">
                                    <label class="charge-tax-caption">Tax</label>
                                    <div class="tax-group charge-tax-group" role="group" aria-label="Taxes">
                                        @if (Model.HasGstPermission && Model.HasGst)
                                        {
                                            <label class="check"><input id="gst" type="checkbox" /> @Model.TaxLabel (@Model.GstPercent.ToString("0.##")%)</label>
                                        }
                                        @if (Model.HasBedTaxPermission && Model.HasBedTax && !Model.TaxLabel.Equals("VAT", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <label class="check"><input id="bedTax" type="checkbox" /> Bed Tax (@Model.BedTaxPercent.ToString("0.##")%)</label>
                                        }
                                    </div>
                                </div>
                            }

                            <div id="roomAdultsWrap" class="field room-occupancy-field hidden">
                                <label for="roomAdults">Adults <span id="roomAdultsLimit" class="occupancy-limit-inline">(Max 0)</span></label>
                                <input id="roomAdults" type="number" min="0" max="0" value="0" inputmode="numeric" />
                            </div>
                            <div id="roomChildrenWrap" class="field room-occupancy-field hidden">
                                <label for="roomChildren">Children <span id="roomChildrenLimit" class="occupancy-limit-inline">(Max 0)</span></label>
                                <input id="roomChildren" type="number" min="0" max="0" value="0" inputmode="numeric" />
                            </div>
                            <div id="roomInfantsWrap" class="field room-occupancy-field hidden">
                                <label for="roomInfants">Infants <span id="roomInfantsLimit" class="occupancy-limit-inline">(Max 0)</span></label>
                                <input id="roomInfants" type="number" min="0" max="0" value="0" inputmode="numeric" />
                            </div>

                            <button id="addCharge" type="button" class="btn btn-primary charge-add-btn"><i class="fa-solid fa-plus"></i>Add</button>
                        </div>

                        <div id="chargeOptionsRow" class="charge-options-row">
                            <div id="promoCodeWrap" class="field hidden" hidden aria-hidden="true"><select id="promoCode" tabindex="-1"><option value="" selected></option></select></div>
                            <div id="monthlyRateWrap" class="field hidden"><label for="monthlyRate">Monthly Rate</label><input id="monthlyRate" type="number" min="0" step="0.01" /></div>
                            <input id="numberOfRooms" type="hidden" value="1" />
                        </div>

                        <div class="table-wrap charge-table-wrap">
                            <table class="table charge-table">
                                <thead>
                                    <tr><th aria-label="Room selection"></th><th>Description</th><th>Type</th><th>Room</th><th>Adult</th><th>Child</th><th>Infant</th><th>Guest</th><th>Stay</th><th>Rate Plan</th><th class="num">Rate / Night</th><th data-charge-col="discount" class="num @(!showDiscountColumn ? "is-column-hidden" : "")">Discount</th><th data-charge-col="gst" class="num @(!showTaxColumn ? "is-column-hidden" : "")">@Model.TaxLabel</th><th data-charge-col="bedtax" class="num @(!showBedTaxColumn ? "is-column-hidden" : "")">Bed Tax</th><th class="num">Total</th><th>Actions</th></tr>
                                </thead>
                                <tbody id="chargeRows">
                                    @if (Model.Charges.Count == 0)

                                    {
                                        <tr class="table-empty"><td colspan="16">No charges added yet. Save the guest, then add a room or service.</td></tr>
                                    }

                                    else

                                    {

                                        foreach (var row in Model.Charges)

                                        {

                                            var isRoomRentRow = row.Description.Equals("Room Rent", StringComparison.OrdinalIgnoreCase);
                                            var rowStatusKey = (row.ReservationStatus ?? string.Empty).Replace("-", string.Empty).Replace("_", string.Empty).Replace(" ", string.Empty).ToLowerInvariant();
                                            var isCheckedOutRoomRow = isRoomRentRow && (rowStatusKey == "checkout" || rowStatusKey == "checkedout");
                                            <tr class="@(isCheckedOutRoomRow ? "charge-row-checkedout" : string.Empty)" data-charge-id="@row.Id" data-room="@row.RoomNo" data-category="@row.Category" data-status="@row.ReservationStatus" data-arrival="@(row.ArrivalDate?.ToString("yyyy-MM-dd") ?? "")" data-departure="@(row.DepartureDate?.ToString("yyyy-MM-dd") ?? "")">
                                                <td>@if (row.CanSelectForCheckIn)
                                                    {
                                                        <input class="room-check" type="checkbox" value="@row.Id" data-room="@row.RoomNo" checked="@row.SelectedForCheckIn" title="Select this pending room for check-in" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-lock table-lock" title="This row is not available for check-in selection."></i>
                                                    }</td>
                                                <td>@(isRoomRentRow ? row.Description : (!string.IsNullOrWhiteSpace(row.DeductionInfo) ? row.DeductionInfo : row.Description))</td>
                                                <td>@(isRoomRentRow ? row.Category : string.Empty)</td>
                                                <td class="room-cell reservation-room-number-cell">
                                                    @if (isRoomRentRow)
                                                    {
                                                        <span class="room-number-text">@(string.IsNullOrWhiteSpace(row.RoomNo) ? "—" : row.RoomNo)</span>
                                                        @if (row.CanChangeRoom)
                                                        {
                                                            <button type="button" class="reservation-room-edit-btn" data-room-change="@row.Id" title="Change this room" aria-label="Change room @row.RoomNo"><i class="fa-solid fa-pen"></i></button>
                                                        }
                                                    }
                                                </td>
                                                <td class="num occupancy-cell">@(isRoomRentRow ? row.RoomAdults.ToString() : string.Empty)</td>
                                                <td class="num occupancy-cell">@(isRoomRentRow ? row.RoomChildren.ToString() : string.Empty)</td>
                                                <td class="num occupancy-cell">@(isRoomRentRow ? row.RoomInfants.ToString() : string.Empty)</td>
                                                <td class="guest-cell inline-editable-cell" data-value="@(isRoomRentRow ? row.GuestName : string.Empty)" data-can-edit-guest="@(isRoomRentRow ? "1" : "0")" title="@(isRoomRentRow ? "Double-click to edit guest name" : "")">@(isRoomRentRow ? (string.IsNullOrWhiteSpace(row.GuestName) ? "—" : row.GuestName) : string.Empty)</td>
                                                <td>@if (isRoomRentRow)
                                                    {
                                                        @DateText(row.ArrivalDate) <text> → </text> @DateText(row.DepartureDate)<br /><small>@row.Nights.ToString("0.##") @(Model.IsMonthWise ? "month(s)" : "night(s)")</small>
                                                    }</td>
                                                <td>@(string.IsNullOrWhiteSpace(row.RatePlanName) ? row.RatePlanId : row.RatePlanName)</td>
                                                @{
                                                    var ratePerNight = isRoomRentRow && row.Nights > 1m && Math.Abs(row.Rate - row.Charge) < 0.01m ? Math.Round(row.Rate / row.Nights, 2) : row.Rate;
                                                }
                                                <td class="num rate-cell inline-editable-cell" data-value="@ratePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-can-edit-rate="@(row.CanEditRate && row.Description.Equals("Room Rent", StringComparison.OrdinalIgnoreCase) ? "1" : "0")" title="@(row.CanEditRate && row.Description.Equals("Room Rent", StringComparison.OrdinalIgnoreCase) ? "Double-click to edit rate per night" : "Rate update not permitted")">@Money(ratePerNight)</td>
                                                <td data-charge-col="discount" data-value="@row.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="num @(!showDiscountColumn ? "is-column-hidden" : "")">@Money(row.Discount)</td>
                                                <td data-charge-col="gst" data-value="@row.Gst.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="num @(!showTaxColumn ? "is-column-hidden" : "")">@Money(row.Gst)</td>
                                                <td data-charge-col="bedtax" data-value="@row.BedTax.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="num @(!showBedTaxColumn ? "is-column-hidden" : "")">@Money(row.BedTax)</td>
                                                <td class="num charge-total-cell" data-value="@row.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"><b>@Money(row.TotalAmount)</b></td>
                                                <td class="row-actions">
                                                    @if (row.CanDelete)
                                                    {
                                                        <button type="button" class="icon-action danger" data-action="delete" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(row.DeleteLockTitle))
                                                    {
                                                        <span class="icon-action is-disabled" title="@row.DeleteLockTitle"><i class="fa-solid fa-lock"></i></span>
                                                    }
                                                </td>
                                            </tr>
                                        }

                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="hidden" aria-hidden="true">
                            <span id="subTotal">@Model.Totals.SubTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                            <span id="taxTotal">@Model.Totals.TaxTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                            <span id="grandTotal">@Model.Totals.GrandTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>
                    </div>
                </section>

                <section class="card additional-stay-items hidden" aria-labelledby="extraHeading" aria-hidden="true">
                    <div class="card-head">
                        <span class="card-icon"><i class="fa-solid fa-bell-concierge"></i></span>
                        <div class="card-title"><h2 id="extraHeading">Additional Stay Items</h2><small>Laundry, discount codes and notes from the original page.</small></div>
                    </div>
                    <div class="card-body">
                        <div class="utility-tabs" role="tablist">
                            <button type="button" class="utility-tab active" data-panel="notesPanel">Notes</button>
                            <button type="button" class="utility-tab" data-panel="laundryPanel">Laundry</button>
                            <button type="button" class="utility-tab" data-panel="discountPanel">Discount Code</button>
                        </div>
                        <div id="notesPanel" class="utility-panel active"><label for="notes">Notes</label><textarea id="notes" placeholder="Add any notes about this stay...">@g.Notes</textarea></div>
                        <div id="laundryPanel" class="utility-panel hidden">
                            <div class="utility-grid">
                                <div class="field"><label for="laundryCategory">Category</label><select id="laundryCategory"><option value="">--Select--</option></select></div>
                                <div class="field"><label for="laundryItem">Item</label><select id="laundryItem"><option value="">--Select--</option></select></div>
                                <div class="field"><label for="laundrySubCategory">Sub Category</label><input id="laundrySubCategory" readonly /></div>
                                <div class="field"><label for="laundryQty">Quantity</label><input id="laundryQty" type="number" min="1" value="1" /></div>
                                <div class="field"><label for="laundryRate">Rate</label><input id="laundryRate" type="number" min="0" step="0.01" readonly /></div>
                                <div class="field"><label for="laundryAmount">Amount</label><input id="laundryAmount" readonly /></div>
                                <button id="addLaundry" type="button" class="btn btn-primary"><i class="fa-solid fa-plus"></i>Add Laundry</button>
                            </div>
                            <div class="table-wrap compact-table">
                                <table class="table">
                                    <thead><tr><th>#</th><th>Category</th><th>Item</th><th>Qty</th><th class="num">Rate</th><th class="num">Amount</th><th>Action</th></tr></thead>
                                    <tbody id="laundryRows">
                                        @if (Model.Laundry.Count == 0)
                                        {
                                            <tr class="table-empty"><td colspan="7">No laundry items.</td></tr>
                                        }
                                        else
                                        {
                                            var li = 0; foreach (var row in Model.Laundry)
                                            {
                                                li++;
                                                <tr><td>@li</td><td>@row.Category</td><td>@row.Item</td><td>@row.Quantity</td><td class="num">@Money(row.Rate)</td><td class="num">@Money(row.Amount)</td><td><button type="button" class="btn btn-ghost" data-laundry-delete="@row.Id"><i class="fa-solid fa-trash"></i> Delete</button></td></tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div id="discountPanel" class="utility-panel hidden">
                            <div class="inline-tool"><div class="field"><label for="discountCode">Discount Code</label><input id="discountCode" /></div><button id="applyDiscount" type="button" class="btn btn-primary">Apply Code</button></div>
                            <div id="discountList" class="discount-list">@if (Model.Discounts.Count == 0)
                                {
                                    <span class="muted-text">No discount code applied.</span>
                                }
                                else
                                {
                                    foreach (var d in Model.Discounts)
                                    {
                                        <span class="discount-chip"><b>@d.Code</b> @Money(d.Amount)</span>
                                    }
                                }</div>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="stack" aria-label="Payment">
                <section class="card" aria-labelledby="paymentHeading">
                    <div class="card-head"><span class="card-icon"><i class="fa-regular fa-credit-card"></i></span><div class="card-title"><h2 id="paymentHeading">Charges &amp; Payment</h2></div></div>
                    <div class="card-body summary">
                        <div class="pay-row"><label>Total</label><div class="money-input money-input-suffix" data-currency="@Model.Currency"><input id="paymentTotal" readonly value="@Model.Totals.GrandTotal.ToString("N2")" /></div></div>
                        <div class="pay-row"><label for="paymentMethod">Payment Method</label><select id="paymentMethod"><option value="">Select</option>@foreach (var o in Model.PaymentMethods)
                                {
                                    <option value="@o.Value">@o.Text</option>
                                }<option value="Complementary">Complementary</option></select></div>
                        <div class="pay-row"><label for="paidAmount">Paid Amount</label><div class="money-input money-input-suffix" data-currency="@Model.Currency"><input id="paidAmount" type="number" min="0" step="0.01" value="0" /></div></div>
                        <div class="pay-row"><label>Already Paid</label><div class="money-input money-input-suffix" data-currency="@Model.Currency"><input id="alreadyPaid" readonly value="@Model.Totals.PaidAmount.ToString("N2")" /></div></div>

                        <input id="advancePaid" type="hidden" value="@Model.Totals.AdvancePaid.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <input id="roomSecurity" type="hidden" value="@Model.Totals.RoomSecurity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <input id="payableAmount" type="hidden" value="@Model.Totals.Payable.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />

                        <div class="balance-box"><span>Outstanding Balance</span><b><span id="balance">@Model.Totals.Remaining.ToString("N2")</span><span class="balance-currency">@Model.Currency</span></b></div>
                        <button id="recordPayment" type="button" class="btn btn-primary btn-block"><i class="fa-solid fa-wallet"></i>Record Payment</button>
                        @if (Model.CanCardPayment && (Model.IsStripeConfigured || Model.IsCloverConfigured))

                        {
                            <div class="payment-method-actions">
                                <button id="openPdqPayment" type="button" class="btn btn-outline"><i class="fa-solid fa-credit-card"></i>PDQ Payment</button>
                                @if (Model.IsStripeConfigured)

                                {
                                    <button id="openStripeCardPayment" type="button" class="btn btn-outline"><i class="fa-brands fa-stripe"></i>Card Payment</button>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="card" aria-labelledby="logHeading">
                    <div class="card-head"><span class="card-icon"><i class="fa-solid fa-receipt"></i></span><div class="card-title"><h2 id="logHeading">Payment Log</h2></div></div>
                    <div class="card-body payment-log-wrap">
                        <table class="payment-log">
                            <thead><tr><th>Sr#</th><th>Date</th><th class="num">Amount</th><th>Method</th><th>Receipt</th><th>Option</th></tr></thead>
                            <tbody id="paymentLogRows">
                                @if (Model.PaymentLog.Count == 0)
                                {
                                    <tr><td colspan="6" class="payment-log-empty">No payment recorded yet.</td></tr>
                                }
                                else
                                {
                                    var pi = 0; foreach (var p in Model.PaymentLog)
                                    {
                                        pi++;
                                        <tr data-payment-log-id="@p.Id" data-amount="@p.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-refundable="@p.RemainingRefundable.ToString(System.Globalization.CultureInfo.InvariantCulture)"><td>@pi</td><td>@(p.Date?.ToString("dd MMM yyyy HH:mm") ?? "—")</td><td class="num">@Money(p.Amount)</td><td>@p.Method</td><td>@if (!string.IsNullOrWhiteSpace(p.Receipt))
                                                {
                                                    <a href="@p.Receipt" target="_blank" rel="noopener">Receipt</a>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }</td><td class="payment-option-cell">@if (p.CanRefund)
                                                {
                                                    <button type="button" class="btn btn-ghost" data-payment-refund="@p.Id"><i class="fa-solid fa-rotate-left"></i> Refund</button>
                                                }<button type="button" class="btn btn-ghost btn-icon payment-log-audit-btn" data-payment-audit="@p.Id" title="View audit log" aria-label="View audit log"><i class="fa-solid fa-clipboard-list"></i></button></td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>


                <section class="card" aria-labelledby="depositHeading">
                    <div class="card-head"><span class="card-icon"><i class="fa-solid fa-shield-halved"></i></span><div class="card-title"><h2 id="depositHeading">Security Deposit</h2></div><small class="card-meta">Separate from stay total</small></div>
                    <div class="card-body">
                        <div class="deposit-row"><span>Refundable Balance</span><b id="depositDisplay">@Money(Model.Totals.RoomSecurity)</b></div>
                        <button id="openRoomSecurity" type="button" class="btn btn-outline btn-block"><i class="fa-solid fa-shield-halved"></i>Room Security</button>
                        <div class="table-wrap compact-table security-table">
                            <table class="table">
                                <thead><tr><th>Type</th><th>Mode</th><th class="num">Amount</th><th>Status</th><th>Action</th><th>Receipt</th></tr></thead>
                                <tbody id="securityRows">
                                    @if (Model.SecurityLog.Count == 0)

                                    {
                                        <tr class="table-empty"><td colspan="6">No security deposit movement found for this reservation.</td></tr>
                                    }

                                    else

                                    {

                                        foreach (var row in Model.SecurityLog)

                                        {

                                            var movementAmount = row.Amount > 0 ? row.Amount : (row.Refunded > 0 ? row.Refunded : row.Deducted);
                                            <tr data-security-id="@row.Id"
                                                data-security-amount="@row.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-security-pi="@row.PaymentIntentId"
                                                data-security-charge="@row.ChargeId"
                                                data-security-method="@row.Method">
                                                <td>@SecurityType(row.Status)</td>
                                                <td>@SecurityMode(row)</td>
                                                <td class="num">@Money(movementAmount)</td>
                                                <td><span class="security-status-badge">@SecurityStatus(row.Status)</span></td>
                                                <td>@if (row.CanSettle)
                                                    {
                                                        <button type="button" class="security-row-action" data-security-settle="@row.Id"><i class="fa-solid fa-rotate-left"></i> Refund / Deduct</button>
                                                    }</td>
                                                <td class="security-receipt-cell">@if (!string.IsNullOrWhiteSpace(row.ReceiptUrl))
                                                    {
                                                        <a class="security-info-btn" href="@row.ReceiptUrl" target="_blank" rel="noopener" title="View Receipt"><i class="fa-solid fa-receipt"></i></a>
                                                    }
                                                    else
                                                    {
                                                        <span class="security-receipt-empty">—</span>
                                                    }</td>
                                            </tr>
                                        }

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <div id="message" class="message" role="status" aria-live="polite"></div>
            </aside>
        </div>
    </form>

    <div class="fixed-action-bar-spacer" aria-hidden="true"></div>
    <div id="checkinFixedActions" class="checkin-fixed-action-bar" aria-label="Check-in actions">
        <div class="checkin-fixed-action-inner">
            <div class="checkin-footer-left">
                <button id="checkOutAction" type="button" class="footer-action-btn footer-checkout @(!Model.ShowCheckOutAction ? "hidden" : "")"><i class="fa-solid fa-right-from-bracket"></i>Check-Out</button>
            </div>

            <div class="checkin-footer-right">
                <button id="complete" type="button" class="footer-action-btn footer-checkin @(!Model.ShowCheckInAction ? "hidden" : "")"><i class="fa-solid fa-right-to-bracket"></i>Check-In</button>
                <button id="undoCheckIn" type="button" class="footer-action-btn footer-undo @(!Model.ShowUndoCheckInAction ? "hidden" : "")"><i class="fa-solid fa-rotate-left"></i>Undo Check-In</button>
                <button id="printInvoice" type="button" class="footer-action-btn footer-print @(!Model.IsExistingBooking ? "hidden" : "")"><i class="fa-solid fa-print"></i>Print</button>
            </div>
        </div>
    </div>

    <div id="dateTaxModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="dateTaxModalTitle">
        <section class="dialog">
            <div class="modal-head"><i class="modal-dot"></i><h2 id="dateTaxModalTitle">TAX FOR EXTENDED STAY</h2><button id="dateTaxClose" type="button" class="modal-close">×</button></div>
            <div class="modal-body">
                <div class="checkin-note">The stay has been extended. Select the property-configured tax(es) that should apply to the newly added night(s).</div>
                @if (Model.HasGstPermission && Model.HasGst)

                {
                    <div class="modal-field">
                        <label class="check"><input id="dateTaxGst" type="checkbox" /> @Model.TaxLabel (@Model.GstPercent.ToString("0.##")%)</label>
                    </div>
                }
                @if (Model.HasBedTaxPermission && Model.HasBedTax && !Model.TaxLabel.Equals("VAT", StringComparison.OrdinalIgnoreCase))

                {
                    <div class="modal-field">
                        <label class="check"><input id="dateTaxBed" type="checkbox" /> Bed Tax (@Model.BedTaxPercent.ToString("0.##")%)</label>
                    </div>
                }
                <div class="modal-actions">
                    <button id="dateTaxContinue" type="button" class="btn btn-primary">Apply &amp; Update Stay</button>
                    <button id="dateTaxCancel" type="button" class="btn btn-outline">Cancel</button>
                </div>
            </div>
        </section>
    </div>

    <div id="securityModal" class="modal-backdrop hidden room-security-overlay" role="dialog" aria-modal="true" aria-labelledby="securityModalTitle">
        <section class="room-security-modal">
            <div class="room-security-modal-header">
                <div>
                    <div class="room-security-modal-title"><span class="room-security-title-dot"></span><span id="securityModalTitle">Room Security</span></div>
                    <div class="room-security-modal-subtitle">Secure deposits, refunds and deductions</div>
                </div>
                <button type="button" class="room-security-close-btn" data-close-modal="securityModal">×</button>
            </div>
            <div class="room-security-modal-body">
                <input id="securityMovement" type="hidden" value="deposit" />
                <input id="securityLockedMethod" type="hidden" value="" />

                <div class="security-mode-tabs">
                    <button id="securityDepositTab" type="button" class="security-mode-tab active"><i class="fa-solid fa-plus-circle"></i> Deposit</button>
                    <button id="securitySettleTab" type="button" class="security-mode-tab"><i class="fa-solid fa-rotate-left"></i> Refund / Deduct</button>
                </div>

                <div id="securityPaymentMethodArea">
                    <label class="security-method-label">Select Payment Method</label>
                    <div class="security-pill-row">
                        @if (Model.IsStripeConfigured)

                        {
                            <button type="button" class="security-pill active" data-security-method="card"><i class="fa-solid fa-credit-card"></i> Card Terminal</button>
                            <button type="button" class="security-pill" data-security-method="manualcard"><i class="fa-solid fa-keyboard"></i> Card Pre-Authorization</button>
                        }
                        <button type="button" class="security-pill @(!Model.IsStripeConfigured ? "active" : "")" data-security-method="cash"><i class="fa-solid fa-money-bill-wave"></i> Cash</button>
                    </div>
                    <select id="securityMethod" class="hidden" aria-hidden="true">
                        @if (Model.IsStripeConfigured)
                        {
                            <option value="card">Card Terminal</option>
                            <option value="manualcard">Card Pre-Authorization</option>
                        }
                        <option value="cash">Cash</option>
                    </select>
                </div>

                <div id="securityDepositFields">
                    <div id="securityReaderWrap" class="modal-field">
                        <label for="securityReader">Reader</label>
                        <select id="securityReader"><option value="">--Select--</option>@foreach (var r in Model.StripeReaders)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }</select>
                    </div>
                    <div class="modal-field"><label for="securityNote">Note <b class="req">*</b></label><input id="securityNote" placeholder="Additional Info required..." /></div>
                    <div class="modal-field"><label for="securityAmount">Amount</label><div class="money-input" data-currency="@Model.Currency"><input id="securityAmount" type="number" min="0.01" step="0.01" /></div></div>
                </div>

                <div id="securitySettleFields" class="hidden">
                    <div class="modal-field"><label for="securityCurrentAmount">Current Room Security</label><div class="money-input" data-currency="@Model.Currency"><input id="securityCurrentAmount" type="number" readonly /></div></div>
                    <div class="modal-field"><label for="securityRefundAmount">Refund Amount</label><div class="money-input" data-currency="@Model.Currency"><input id="securityRefundAmount" type="number" min="0" step="0.01" /></div></div>
                    <div class="modal-field"><label for="securitySettleNote">Note <b class="req">*</b></label><input id="securitySettleNote" placeholder="Additional Info required..." /></div>
                    <div id="securityDeductionPreview" class="checkin-note hidden"></div>
                </div>

                <div class="security-popup-actions">
                    <button id="saveSecurity" type="button" class="security-charge-btn">Charge Now</button>
                    <button type="button" class="security-cancel-btn" data-close-modal="securityModal">Cancel</button>
                </div>
                <div class="security-status-card">
                    <div class="security-status-title" id="securityActionStatusTitle">Ready</div>
                    <div class="security-status-subtitle" id="securityActionStatusMsg">Select method and press Charge Now.</div>
                </div>
            </div>
        </section>
    </div>

    <div id="cardModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="cardModalTitle">
        <section class="payment-modal card-payment-modal">
            <div class="modal-head"><i class="modal-dot"></i><h2 id="cardModalTitle">CARD TERMINAL</h2><button type="button" class="modal-close" data-close-modal="cardModal">×</button></div>
            <div class="modal-body">
                <div class="pay-tabs provider-tabs" id="cardProviderTabs">
                    @if (Model.IsStripeConfigured)
                    {
                        <button type="button" class="pay-tab active" data-card-provider="stripe">Stripe Terminal</button>
                    }
                    @if (Model.IsCloverConfigured)
                    {
                        <button type="button" class="pay-tab @(Model.IsStripeConfigured ? "" : "active")" data-card-provider="clover">Clover PDQ</button>
                    }
                </div>
                <div id="cardReaderWrap" class="modal-field"><label for="cardReader">Reader / Device</label><select id="cardReader"><option value="">--Select--</option>@foreach (var r in Model.StripeReaders)
                        {
                            <option value="@r.Value">@r.Text</option>
                        }</select></div>
                <div class="modal-field"><label for="cardAmount">Amount</label><div class="money-input" data-currency="@Model.Currency"><input id="cardAmount" type="number" min="0.01" step="0.01" /></div></div>
                <div class="modal-field"><label for="cardNote">Note</label><input id="cardNote" /></div>
                @if (Model.ShowSimulation)
                {
                    <div id="cardSimulationWrap" class="simulation security-simulation-box">
                        <div class="simulation-head">
                            <strong>Simulation</strong>
                            <label><input id="cardSimulate" type="checkbox" /> Use simulated card</label>
                        </div>
                        <select id="cardSimulationResult">
                            <option value="success">Success (Visa 4242...4242)</option>
                            <option value="decline">Decline</option>
                            <option value="insufficient_funds">Insufficient Funds</option>
                        </select>
                        <button id="simulateCardNow" type="button" class="btn btn-outline btn-block" disabled>Simulate</button>
                        <small>Use after “Handing off to reader...”.</small>
                    </div>
                }
                <div id="cardTerminalStatus" class="terminal-status"><b>Ready</b><span>Select a terminal/PDQ device and process the payment.</span></div>
                <div class="modal-actions"><button id="chargeCardNow" type="button" class="btn btn-primary">Charge Now</button><button id="cancelTerminal" type="button" class="btn btn-outline">Cancel</button></div>
            </div>
        </section>
    </div>

    <div id="roomChangeModal" class="modal-backdrop hidden reservation-room-change-overlay" role="dialog" aria-modal="true" aria-labelledby="roomChangeTitle">
        <section class="reservation-room-change-modal">
            <div class="reservation-room-change-header">
                <div class="reservation-room-change-heading">
                    <span class="reservation-room-change-heading-icon"><i class="fa-solid fa-right-left"></i></span>
                    <div>
                        <h2 id="roomChangeTitle" class="reservation-room-change-title">Change Reservation Room</h2>
                        <div class="reservation-room-change-subtitle">Only rooms available for this room category and stay period are shown.</div>
                    </div>
                </div>
                <div class="reservation-room-change-header-actions">
                    <div class="reservation-room-change-current-only">
                        <span class="reservation-room-change-label">Current room</span>
                        <span id="roomChangeCurrent" class="reservation-room-change-current-number">—</span>
                    </div>
                    <button type="button" class="reservation-room-change-close" data-close-modal="roomChangeModal" aria-label="Close">×</button>
                </div>
            </div>
            <div class="reservation-room-change-body">
                <input id="roomChangePaymentId" type="hidden" />
                <input id="roomChangeSelected" type="hidden" />
                <div class="reservation-room-change-list-title">Available rooms</div>
                <div id="roomChangeChoices" class="reservation-room-change-grid"></div>
                <div id="roomChangeEmpty" class="reservation-room-change-empty hidden"><i class="fa-regular fa-calendar-xmark"></i>No other rooms are available in this category for the selected arrival and departure dates.</div>
            </div>
            <div class="reservation-room-change-footer">
                <button type="button" class="reservation-room-change-btn reservation-room-change-cancel" data-close-modal="roomChangeModal">Cancel</button>
                <button id="roomChangeSave" type="button" class="reservation-room-change-btn reservation-room-change-confirm is-disabled" disabled><i class="fa-solid fa-check"></i>Confirm Room Change</button>
            </div>
        </section>
    </div>

    <div id="sourceModal" class="modal-backdrop hidden" role="dialog" aria-modal="true"><section class="dialog"><div class="modal-head"><i class="modal-dot"></i><h2>MANAGE SOURCE</h2><button type="button" class="modal-close" data-close-modal="sourceModal">×</button></div><div class="modal-body"><div class="modal-field"><label for="sourceValue">Source</label><input id="sourceValue" /></div><div class="modal-actions"><button id="addSource" type="button" class="btn btn-primary">Add</button><button id="deleteSource" type="button" class="btn btn-outline">Delete</button></div></div></section></div>

    <div id="companyModal" class="modal-backdrop hidden" role="dialog" aria-modal="true"><section class="dialog"><div class="modal-head"><i class="modal-dot"></i><h2>MANAGE COMPANY</h2><button type="button" class="modal-close" data-close-modal="companyModal">×</button></div><div class="modal-body company-modal-grid"><div class="modal-field"><label for="companyValue">Company</label><input id="companyValue" /></div><div class="modal-field"><label for="companyPerson">Contact Person</label><input id="companyPerson" /></div><div class="modal-field"><label for="companyEmail">Email</label><input id="companyEmail" type="email" /></div><div class="modal-field"><label for="companyPhone">Phone</label><input id="companyPhone" /></div><div class="modal-field"><label for="companyAddress">Address</label><input id="companyAddress" /></div><div class="modal-field"><label for="companyCountry">Country</label><select id="companyCountry"><option value="">--Select--</option>@foreach (var o in Model.Countries)
                        {
                            <option value="@o.Value">@o.Text</option>
                        }</select></div><div class="modal-actions"><button id="addCompany" type="button" class="btn btn-primary">Add</button><button id="deleteCompany" type="button" class="btn btn-outline">Delete</button></div></div></section></div>

    <div id="refundPaymentModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="refundPaymentTitle">
        <section class="dialog">
            <div class="modal-head"><i class="modal-dot"></i><h2 id="refundPaymentTitle">REFUND PAYMENT</h2><button type="button" class="modal-close" data-close-modal="refundPaymentModal">×</button></div>
            <div class="modal-body">
                <input id="refundPaymentLogId" type="hidden" />
                <div class="modal-field"><label for="refundPaymentAmount">Refund Amount</label><input id="refundPaymentAmount" type="number" min="0.01" step="0.01" /></div>
                <div id="refundPaymentMax" class="checkin-note"></div>
                <div class="modal-field"><label for="refundPaymentReason">Refund Reason</label><textarea id="refundPaymentReason" rows="3" placeholder="Enter refund reason..."></textarea></div>
                <div class="modal-actions"><button id="refundPaymentSubmit" type="button" class="btn btn-primary">Refund Now</button><button type="button" class="btn btn-outline" data-close-modal="refundPaymentModal">Cancel</button></div>
            </div>
        </section>
    </div>

    <div id="auditModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="auditModalTitle">
        <section class="dialog payment-audit-dialog">
            <div class="payment-audit-header">
                <div>
                    <h2 id="auditModalTitle" class="payment-audit-title">Payment Log</h2>
                    <div class="payment-audit-subtitle">Created date, user, IP and PC information</div>
                </div>
                <button type="button" class="payment-audit-close" data-close-modal="auditModal" aria-label="Close">×</button>
            </div>
            <div class="payment-audit-body">
                <div id="auditContent" class="payment-audit-loading">Loading...</div>
                <div class="payment-audit-footer">
                    <button type="button" class="payment-audit-btn" data-close-modal="auditModal">Close</button>
                </div>
            </div>
        </section>
    </div>

    <div id="confirmDialog" class="modal-backdrop hidden" role="alertdialog" aria-modal="true" aria-labelledby="confirmTitle"><section class="dialog"><div class="modal-head"><i class="modal-dot"></i><h2 id="confirmTitle">Confirm</h2></div><div class="dialog-body"><p id="confirmMessage"></p></div><div class="dialog-actions"><button id="confirmCancel" type="button" class="btn btn-outline">No</button><button id="confirmOk" type="button" class="btn btn-primary">Confirm</button></div></section></div>
    <div id="inputDialog" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="inputDialogTitle"><section class="dialog"><div class="modal-head"><i class="modal-dot"></i><h2 id="inputDialogTitle">Enter Value</h2><button id="inputDialogClose" type="button" class="modal-close">×</button></div><div class="modal-body"><div class="modal-field"><label id="inputDialogLabel" for="inputDialogValue">Value</label><input id="inputDialogValue" /></div><div id="inputDialogHint" class="checkin-note hidden"></div><div class="modal-actions"><button id="inputDialogCancel" type="button" class="btn btn-outline">Cancel</button><button id="inputDialogOk" type="button" class="btn btn-primary">OK</button></div></div></section></div>
    <div id="toastHost" class="toast-host"></div>
    <div id="busyOverlay" class="busy-overlay hidden"><div class="busy-card"><i class="fa-solid fa-circle-notch fa-spin"></i><span id="busyText">Processing…</span></div></div>
</div>

@section Scripts {
    <script src="~/js/checkin-mvc.js" asp-append-version="true"></script>
}
