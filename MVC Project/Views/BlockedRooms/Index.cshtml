@model Orapmshms.Models.BlockedRoomsPageViewModel
@{
    ViewData["Title"] = "Blocked Rooms";
}

@*
    Blocked Rooms - was BlockedRooms.aspx.

    The grid is loaded asynchronously. The page provides the antiforgery token, the endpoint
    URLs (via Url.Action), and the room category options. The Bulk Room form uses the bulk
    endpoint for one or many selected rooms.

    The hotel id and the user id are NOT in the markup. The old page read them from ?hd= and
    ?UD=, which meant anyone could edit them; the server now takes both from the session.

    The ?v= on the stylesheet and the script is a cache buster and it is not decoration: a
    browser that has already opened this page keeps the old files for days, so copying new
    ones onto the server changes nothing on screen until every user clears their cache.
    Raise the number whenever the css or the js changes.
*@

@{
    const string blockedroomsAssetVersion = "20261119bulkroom2";
    var blockedroomsCssUrl = Url.Content("~/css/blocked-rooms.css") + "?v=" + blockedroomsAssetVersion;
    var blockedroomsJsUrl = Url.Content("~/js/blocked-rooms.js") + "?v=" + blockedroomsAssetVersion;
}

<link rel="stylesheet" href="@blockedroomsCssUrl" />

@* data-hotel is a diagnostic: F12 -> Elements -> compare it with RoomBlocksTB.HotelID.
   If the two differ, the session is handing this page a different hotel than the one the
   blocks were written under, and the grid is correctly showing nothing. *@
<div class="blockedrooms-page"
     data-hotel="@Model.HotelId"
     data-list-url="@Url.Action("List", "BlockedRooms")"
     data-rooms-url="@Url.Action("Rooms", "BlockedRooms")"
     data-bulk-block-url="@Url.Action("BulkBlock", "BlockedRooms")"
     data-update-url="@Url.Action("Update", "BlockedRooms")">

    @Html.AntiForgeryToken()

    <div class="blockedrooms-topbar">
        <div class="blockedrooms-topbar-left">
            <span class="blockedrooms-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18M8 2.5v3M16 2.5v3" /><path d="m9.5 15.5 5-3.5M9.5 12l5 3.5" /></svg>
            </span>
            <div>
                <h1 class="blockedrooms-title">Blocked Rooms</h1>

                <p class="blockedrooms-subtitle">Manage room blocks in one place. Availability refresh is queued after each change.</p>
            </div>
        </div>

        @if (!Model.HasError)
        {
            @* The search filters existing blocks locally without a server round trip. *@
            <div class="blockedrooms-search" id="blockedroomsSearchWrap">
                <svg class="blockedrooms-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="text" id="blockedroomsSearch" class="blockedrooms-search-input" placeholder="Search room, category or reason"
                       autocomplete="off" aria-label="Search blocked rooms" />
                <button type="button" class="blockedrooms-search-clear" id="blockedroomsSearchClear" aria-label="Clear search">&times;</button>
            </div>

            <button type="button" class="blockedrooms-open-bulk" id="blockedroomsOpenBulk"
                    aria-controls="blockedroomsPanel" aria-expanded="false" title="Block one or multiple rooms">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/><path d="m15 18 2 2 4-5"/></svg>
                Block Room
            </button>
        }
    </div>

    @if (Model.HasError)
    {
        <div class="blockedrooms-notice" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
            <span>@Model.LoadError</span>
        </div>
    }
    else
    {
        @* A single Bulk Room picker supports one room or many. All blocks use the same atomic endpoint. *@
        <div class="blockedrooms-card is-form" id="blockedroomsPanel" hidden>
            <div class="blockedrooms-editor-header">
                <div class="blockedrooms-editor-heading">
                    <span class="blockedrooms-editor-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="m14.5 17.5 2.2 2.2 4.3-5"/></svg>
                    </span>
                    <div>
                        <h2 class="blockedrooms-editor-title">Bulk Room</h2>
                        <p class="blockedrooms-editor-description">Select one or more rooms, set a date range and provide a reason.</p>
                    </div>
                </div>
                <button type="button" class="blockedrooms-panel-close" id="blockedroomsPanelClose" aria-label="Close Bulk Room panel" title="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="blockedrooms-form">

                <div class="blockedrooms-field">
                    <label for="blockedroomsCat">Room Category <span class="blockedrooms-req">*</span></label>
                    <select id="blockedroomsCat" class="blockedrooms-select blockedrooms-cat">
                        <option value="">--Select Category--</option>
                        @foreach (var option in Model.Categories)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                </div>

                <div class="blockedrooms-field is-bulk-picker">
                    <div class="blockedrooms-room-chooser-heading">
                        <div>
                            <label for="blockedroomsBulkSearch">Select Rooms <span class="blockedrooms-req">*</span></label>
                            <p>Choose a single room or select multiple rooms from the category.</p>
                        </div>
                        <span class="blockedrooms-bulk-count" aria-live="polite">0 selected</span>
                    </div>
                    <div class="blockedrooms-bulk-toolbar">
                        <div class="blockedrooms-bulk-search-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                            <input type="search" id="blockedroomsBulkSearch" class="blockedrooms-input blockedrooms-bulk-search"
                                   autocomplete="off" placeholder="Search room number" aria-label="Find a room in the selected category" />
                        </div>
                        <button type="button" class="blockedrooms-bulk-selectall">Select All</button>
                        <button type="button" class="blockedrooms-bulk-clear">Clear</button>
                    </div>
                    <div class="blockedrooms-bulk-list" role="group" aria-label="Select rooms to block">
                        <span class="blockedrooms-bulk-placeholder">Select a category above to view rooms.</span>
                    </div>
                    <div class="blockedrooms-bulk-list-footer">
                        <span class="blockedrooms-bulk-selection-summary" aria-live="polite">Select a category to get started.</span>
                        <span class="blockedrooms-bulk-footnote">Maximum 200 rooms per request</span>
                    </div>
                </div>

                <div class="blockedrooms-field is-range">
                    <label for="blockedroomsRange">Block Date Range <span class="blockedrooms-req">*</span></label>

                    @* Both hidden fields use the service's dd/MM/yyyy input format. *@
                    <div class="blockedrooms-daterange" data-range-name="block">
                        <input type="hidden" data-start value="" />
                        <input type="hidden" data-end value="" />

                        <button type="button" id="blockedroomsRange" class="blockedrooms-daterange-input"
                                aria-haspopup="dialog" aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" /></svg>
                            <span class="blockedrooms-daterange-text is-empty">dd/mm/yyyy &rarr; dd/mm/yyyy</span>
                            <svg class="blockedrooms-daterange-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                        </button>

                        <div class="blockedrooms-daterange-panel" role="dialog" aria-label="Choose a date range" hidden>
                            <div class="blockedrooms-cal-nav">
                                <button type="button" class="blockedrooms-nav-btn" data-month="-1" aria-label="Previous month">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                                </button>
                                <div class="blockedrooms-cal-months">
                                    <span class="blockedrooms-cal-month"></span>
                                    <span class="blockedrooms-cal-month"></span>
                                </div>
                                <button type="button" class="blockedrooms-nav-btn" data-month="1" aria-label="Next month">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                                </button>
                            </div>

                            <div class="blockedrooms-cals">
                                <div class="blockedrooms-cal"><div class="blockedrooms-cal-grid blockedrooms-cal-body"></div></div>
                                <div class="blockedrooms-cal"><div class="blockedrooms-cal-grid blockedrooms-cal-body"></div></div>
                            </div>

                            <div class="blockedrooms-daterange-foot">
                                <span class="blockedrooms-daterange-hint"></span>
                                <div class="blockedrooms-daterange-actions">
                                    <button type="button" class="blockedrooms-btn is-ghost is-small" data-range="cancel">Cancel</button>
                                    <button type="button" class="blockedrooms-btn is-primary is-small" data-range="apply">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="blockedrooms-field">
                    <label for="blockedroomsReason">Reason <span class="blockedrooms-req">*</span></label>
                    <input type="text" id="blockedroomsReason" class="blockedrooms-input blockedrooms-reason-input"
                           autocomplete="off" maxlength="500" placeholder="Why is this room out of use?" />
                </div>

            </div>
            <div class="blockedrooms-form-footer">
                <div class="blockedrooms-refresh-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v6h-6"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Availability recalculation is queued after a successful block.</span>
                </div>
                <button type="button" class="blockedrooms-btn is-primary blockedrooms-block">Block Selected Rooms</button>
            </div>
        </div>

        <div class="blockedrooms-card is-list">
            <div class="blockedrooms-list-heading">
                <div>
                    <h2>Current Room Blocks</h2>
                    <p>View, edit or unblock rooms from the list below.</p>
                </div>
                <span class="blockedrooms-current-count" aria-live="polite">Loading...</span>
            </div>
            <div class="blockedrooms-tablewrap">
                <table class="blockedrooms-table">
                    <thead>
                        <tr>
                            <th class="is-mid">Sr #</th>
                            <th>Room No.</th>
                            <th>Room Category</th>
                            <th>Block From</th>
                            <th>Block To</th>
                            <th>Reason</th>
                            <th class="is-mid">Action</th>
                        </tr>
                    </thead>
                    <tbody class="blockedrooms-tbody"></tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (!Model.HasError)
{
    @* the popup the pencil opens - was changestatuspopup, with its own overlay *@
    <div class="blockedrooms-backdrop" hidden></div>

    <div class="blockedrooms-modal" role="dialog" aria-modal="true" aria-label="Unblock room" hidden>
        <div class="blockedrooms-modal-head">
            <h2 class="blockedrooms-modal-title">Unblock Room</h2>
            <button type="button" class="blockedrooms-modal-close" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>

        <div class="blockedrooms-modal-body">

            <div class="blockedrooms-field">
                <label for="blockedroomsModalCat">Category</label>
                <input type="text" id="blockedroomsModalCat" class="blockedrooms-input blockedrooms-modal-cat" disabled />
            </div>

            <div class="blockedrooms-field">
                <label for="blockedroomsModalRoom">Room No</label>
                <input type="text" id="blockedroomsModalRoom" class="blockedrooms-input blockedrooms-modal-room" disabled />
            </div>

            <div class="blockedrooms-field is-wide">
                <label for="blockedroomsModalStatus">Action</label>
                <select id="blockedroomsModalStatus" class="blockedrooms-select blockedrooms-modal-status">
                    <option value="Active">Active (blocked between dates)</option>
                    <option value="Inactive">Inactive (unblocked)</option>
                </select>
            </div>

            <div class="blockedrooms-field is-wide">
                <label for="blockedroomsEditRange">Current Block Date Range</label>

                <div class="blockedrooms-daterange blockedrooms-modal-daterange" data-range-name="edit">
                    <input type="hidden" data-start value="" />
                    <input type="hidden" data-end value="" />

                    <button type="button" id="blockedroomsEditRange" class="blockedrooms-daterange-input"
                            aria-haspopup="dialog" aria-expanded="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" /></svg>
                        <span class="blockedrooms-daterange-text is-empty">dd/mm/yyyy &rarr; dd/mm/yyyy</span>
                        <svg class="blockedrooms-daterange-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>

                    <div class="blockedrooms-daterange-panel" role="dialog" aria-label="Choose a date range" hidden>
                        <div class="blockedrooms-cal-nav">
                            <button type="button" class="blockedrooms-nav-btn" data-month="-1" aria-label="Previous month">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                            </button>
                            <div class="blockedrooms-cal-months">
                                <span class="blockedrooms-cal-month"></span>
                                <span class="blockedrooms-cal-month"></span>
                            </div>
                            <button type="button" class="blockedrooms-nav-btn" data-month="1" aria-label="Next month">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                            </button>
                        </div>

                        <div class="blockedrooms-cals">
                            <div class="blockedrooms-cal"><div class="blockedrooms-cal-grid blockedrooms-cal-body"></div></div>
                            <div class="blockedrooms-cal"><div class="blockedrooms-cal-grid blockedrooms-cal-body"></div></div>
                        </div>

                        <div class="blockedrooms-daterange-foot">
                            <span class="blockedrooms-daterange-hint"></span>
                            <div class="blockedrooms-daterange-actions">
                                <button type="button" class="blockedrooms-btn is-ghost is-small" data-range="cancel">Cancel</button>
                                <button type="button" class="blockedrooms-btn is-primary is-small" data-range="apply">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="blockedrooms-field is-wide">
                <label for="blockedroomsModalReason">Reason</label>
                <textarea id="blockedroomsModalReason" class="blockedrooms-textarea blockedrooms-modal-reason" rows="3" disabled></textarea>
            </div>

        </div>

        <div class="blockedrooms-modal-foot">
            <button type="button" class="blockedrooms-btn is-ghost blockedrooms-cancel">Cancel</button>
            <button type="button" class="blockedrooms-btn is-primary blockedrooms-apply">Apply</button>
        </div>
    </div>

    @* was every alert() on the old page *@
    <div class="blockedrooms-toasts" aria-live="polite"></div>

    <script src="@blockedroomsJsUrl"></script>
}
