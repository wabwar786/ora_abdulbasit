@model Orapmshms.Models.FrontDeskCalendarMWPageViewModel
@{
    ViewData["Title"] = "Front Desk Calendar - Month View";
    Layout = "_PmsLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/frontdesk-calendar-mw.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/record-payment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/room-security.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/refund-payment.css" asp-append-version="true" />
}

<div class="fdc-page fdc-mw-page" id="frontDeskCalendarMWPage"
     data-start="@Model.StartDate.ToString("yyyy-MM-dd")"
     data-end="@Model.EndDate.ToString("yyyy-MM-dd")"
     data-hotel-today="@Model.HotelToday.ToString("yyyy-MM-dd")"
     data-currency="@Model.CurrencySymbol"
     data-hotel-id="@Model.HotelId"
     data-user-id="@Model.UserId"
     data-user-name="@Model.UserName"
     data-hotel-name="@Model.HotelName"
     data-role="@Model.Role"
     data-can-online-card="@(Model.CanOnlineCardPayment ? "1" : "0")"
     data-can-pdq-payment="@(Model.CanPdqPayment ? "1" : "0")"
     data-can-refund="@(Model.Permissions.CanRefund ? "1" : "0")"
     data-data-url="@Url.Action("Data", "FrontDeskCalendarMW")"
     data-actions-base-url="@Url.Content("~/Calendar")"
     data-details-url="@Url.Action("BookingDetails", "FrontDeskCalendar")"
     data-update-room-guest-url="@Url.Action("UpdateChargeGuestName", "CheckIn")"
     data-history-url="@Url.Action("GuestHistory", "FrontDeskCalendar")"
     data-note-url="@Url.Action("SaveNote", "FrontDeskCalendar")"
     data-clean-url="@Url.Action("MarkRoomClean", "FrontDeskCalendar")"
     data-block-url="@Url.Action("BlockRoom", "FrontDeskCalendar")"
     data-update-block-url="@Url.Action("UpdateBlock", "FrontDeskCalendar")"
     data-remove-block-url="@Url.Action("RemoveBlock", "FrontDeskCalendar")"
     data-activate-room-url="@Url.Action("ActivateRoom", "FrontDeskCalendar")"
     data-move-url="@Url.Action("MoveBooking", "FrontDeskCalendar")"
     data-resize-url="@Url.Action("ResizeBooking", "FrontDeskCalendar")"
     data-mw-resize-check-url="@Url.Action("CheckResizeAvailability", "FrontDeskCalendarMW")"
     data-mw-resize-plans-url="@Url.Action("ResizePlans", "FrontDeskCalendarMW")"
     data-mw-resize-url="@Url.Action("ResizeBooking", "FrontDeskCalendarMW")"
     data-mw-swap-url="@Url.Action("SwapBooking", "FrontDeskCalendarMW")"
     data-no-show-url="@Url.Action("NoShow", "FrontDeskCalendar")"
     data-cancel-url="@Url.Action("CancelReservation", "FrontDeskCalendar")"
     data-undo-url="@Url.Action("UndoCheckIn", "CheckIn")"
     data-checkout-url="@Url.Action("CheckOut", "CheckIn")"
     data-payment-url="@Url.Action("RecordPayment", "CheckIn")"
     data-checkin-url="@Url.Action("Index", "CheckIn")"
     data-reservation-url="@Url.Action("Index", "CreateReservation")"
     data-direct-checkin-url="@Url.Action("DirectCheckIn", "FrontDeskCalendar")"
     data-history-page-url="@Url.Action("GuestHistoryPage", "FrontDeskCalendar")"
     data-send-payment-link-url="@Url.Action("SendPaymentLink", "CreateReservation")"
     data-prepare-email-url="@Url.Action("PrepareEmail", "FrontDeskCalendar")"
     data-send-calendar-email-url="@Url.Action("SendEmail", "FrontDeskCalendar")"
     data-pdq-url="/TerminalCardPayment.aspx">

    <form id="fdcAntiForgery" class="fdc-hidden">@Html.AntiForgeryToken()</form>

    <section class="fdc-card">
        <div class="fdc-timeline fdc-mw-timeline">
            <div class="fdc-title"><i class="fa-regular fa-calendar-days"></i><span>Front Desk Calendar</span></div>

            <div class="fdc-date-nav fdc-mw-nav">
                <button type="button" id="fdcPrev" title="Previous period">‹</button>
                <button type="button" id="fdcToday">Today</button>
                <button type="button" id="fdcRange" class="fdc-range">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</button>
                <button type="button" id="fdcNext" title="Next period">›</button>
            </div>

            <div class="fdc-tools">
                <button type="button" class="fdc-tool" id="fdcRefresh" title="Refresh"><i class="fa-solid fa-rotate"></i></button>
                <button type="button" class="fdc-tool" id="fdcLegendToggle" title="Legend" aria-expanded="false"><i class="fa-solid fa-circle-info"></i></button>
                <div class="fdc-legend-pop" id="fdcLegend" hidden>
                    <strong>Status legend</strong>
                    <div><i class="confirmed"></i>Reserved</div>
                    <div><i class="inhouse"></i>Checked in</div>
                    <div><i class="tentative"></i>Provisional</div>
                    <div><i style="background:#a5a5a5"></i>Checked out</div>
                    <div><i class="blocked"></i>Blocked room</div>
                    <div><i class="dirty"></i>Dirty room</div>
                    <div><i style="background:#fff3cd;border:1px solid #e4cf8c"></i>Council assigned</div>
                    <span class="fdc-legend-group-title">Payment indicator</span>
                    <div><i class="pay-full"></i>Fully paid</div>
                    <div><i class="pay-partial"></i>Partially paid</div>
                    <div><i class="pay-not-paid"></i>Not paid</div>
                </div>
            </div>
        </div>

        <div class="fdc-scroll" id="fdcScroll">
            <div class="fdc-calendar" id="fdcCalendar">
                <div class="fdc-loading" id="fdcLoading"><span></span><b>Loading month-wise calendar…</b></div>
            </div>
        </div>
    </section>

    <aside class="fdc-drawer" id="fdcDrawer" aria-hidden="true">
        <div class="fdc-drawer-head">
            <div class="fdc-avatar" id="fdcAvatar">G</div>
            <div><h3 id="fdcDrawerTitle">Guest</h3><small id="fdcDrawerSub"></small></div>
            <button type="button" class="fdc-close" id="fdcDrawerClose">×</button>
        </div>
        <div class="fdc-drawer-body" id="fdcDrawerBody"></div>
        <div class="fdc-drawer-pay" id="fdcDrawerPay"></div>
        <div class="fdc-drawer-foot" id="fdcDrawerFoot"></div>
    </aside>

    <div class="fdc-overlay" id="fdcOverlay" aria-hidden="true">
        <div class="fdc-modal" role="dialog" aria-modal="true">
            <div class="fdc-modal-head"><h2 id="fdcModalTitle"></h2><button type="button" id="fdcModalClose">×</button></div>
            <div class="fdc-modal-body" id="fdcModalBody"></div>
            <div class="fdc-modal-foot" id="fdcModalFoot"></div>
        </div>
    </div>

    <div class="fdc-context" id="fdcContext"></div>
    <div class="fdc-tip" id="fdcTip"></div>
    <div class="fdc-range-picker" id="fdcRangePicker"></div>
    <div class="fdc-toast" id="fdcToast"></div>
</div>

@await Html.PartialAsync("~/Views/Shared/_RecordPaymentModal.cshtml")
@await Html.PartialAsync("~/Views/Shared/_RoomSecurityModal.cshtml")
@await Html.PartialAsync("~/Views/Shared/_RefundPaymentModal.cshtml")

@section Scripts {
    <script src="~/js/record-payment.js" asp-append-version="true"></script>
    <script src="~/js/room-security.js" asp-append-version="true"></script>
    <script src="~/js/refund-payment.js" asp-append-version="true"></script>
    <script src="~/js/frontdesk-calendar-mw.js" asp-append-version="true"></script>
}
