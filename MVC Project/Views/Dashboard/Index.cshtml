@model DashboardViewModel
@using System.Text.Json
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";



    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);



    var occupancyJson = JsonSerializer.Serialize(Model.OccupancySeries, jsonOptions);



    var occupancyLyJson = JsonSerializer.Serialize(Model.OccupancyLastYearSeries, jsonOptions);



    var financialJson = JsonSerializer.Serialize(Model.FinancialSeries, jsonOptions);



    var exceptionJson = JsonSerializer.Serialize(Model.ExceptionSeries, jsonOptions);







    string Money(decimal value) => Model.CurrencySymbol + value.ToString("N2", CultureInfo.InvariantCulture);



    string Money0(decimal value) => Model.CurrencySymbol + value.ToString("N0", CultureInfo.InvariantCulture);



    decimal ChangePct(decimal current, decimal previous) => previous == 0m ? (current == 0m ? 0m : 100m) : Math.Round((current - previous) * 100m / Math.Abs(previous), 1);



    var revenueChange = ChangePct(Model.RevenueToday, Model.RevenueTodayLastYear);



    var revenue30Change = ChangePct(Model.RevenueLast30, Model.RevenueLast30LastYear);



    var profit30Change = ChangePct(Model.ProfitLast30, Model.ProfitLast30LastYear);



    var occupancyDelta = Math.Round(Model.OccupancyNext30 - Model.OccupancyNext30LastYear, 1);



    var dialCircumference = 157m;



    var dialOffset = dialCircumference - (dialCircumference * Math.Clamp(Model.OccupancyToday, 0m, 100m) / 100m);



    var dialOffsetText = dialOffset.ToString("0.0", CultureInfo.InvariantCulture);



    var dialAria = $"Today occupancy {Model.OccupancyToday:0.#} percent";



    var todayIso = Model.HotelToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var rangeStartIso = Model.FilterStartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var rangeEndIso = Model.FilterEndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var rangeLabel = Model.FilterStartDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) + " – " + Model.FilterEndDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);



    var tomorrowIso = Model.ActualHotelToday.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);



    string RoomBucket(string? state, bool isDirty)

    {

        var value = (state ?? string.Empty).Trim().ToLowerInvariant().Replace(" ", string.Empty).Replace("-", string.Empty);



        if (isDirty || value is "dirty" or "checkout" or "checkedout")

            return "checkout";



        if (value is "checkin" or "checkedin" or "inhouse")

            return "checkin";



        if (value is "reservation" or "reserved")

            return "reservation";



        if (value is "ooo" or "blocked" or "block" or "outoforder")

            return "ooo";



        return "vacant";

    }





    var roomCheckIn = Model.RoomStatus.Count(x => RoomBucket(x.State, x.IsDirty) == "checkin");



    var roomReservation = Model.RoomStatus.Count(x => RoomBucket(x.State, x.IsDirty) == "reservation");



    var roomCheckout = Model.RoomStatus.Count(x => RoomBucket(x.State, x.IsDirty) == "checkout");



    var roomVacant = Model.RoomStatus.Count(x => RoomBucket(x.State, x.IsDirty) == "vacant");



    var roomBlocked = Model.RoomStatus.Count(x => RoomBucket(x.State, x.IsDirty) == "ooo");



    var roomPendingPayment = Model.RoomStatus.Count(x => x.PaymentState == "pending");



    var roomPartialPayment = Model.RoomStatus.Count(x => x.PaymentState == "partial");



    var roomPaidPayment = Model.RoomStatus.Count(x => x.PaymentState == "paid");



    var roomTotal = Model.RoomStatus.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-roomstatus-template.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-layout-fix.css" asp-append-version="true" />
}

<div class="dashboard-page"
     data-room-status-url="@Url.Action("RoomStatus", "Dashboard")"
     data-statistic-url="@Url.Action("StatisticDetails", "Dashboard")"
     data-analytics-url="@Url.Action("Analytics", "Dashboard")"
     data-yearly-url="@Url.Action("YearlySection", "Dashboard")"
     data-dashboard-date="@todayIso"
     data-hotel-today="@Model.ActualHotelToday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
     data-range-start="@rangeStartIso"
     data-range-end="@rangeEndIso"
     data-currency="@Model.CurrencySymbol">
    @if (!string.IsNullOrWhiteSpace(Model.Message))



    {
        <div class="dashboard-alert"><i class="fa-solid fa-triangle-exclamation"></i><span>@Model.Message</span></div>
    }

    <section class="dashboard-hero">
        <div class="dashboard-hero-copy">
            <span class="dashboard-eyebrow">Property overview</span>
            <h1>Overview · @Model.HotelName</h1>
            <p>
                Today's hotel snapshot · @Model.ActualHotelToday.ToString("dd MMM yyyy") ·
                <strong>@Model.RoomsSoldToday of @Model.SellableRoomsToday sellable rooms booked</strong>
            </p>
        </div>

        <div class="dashboard-hero-metrics">
            <div class="dashboard-occupancy-dial">
                <svg width="66" height="66" viewBox="0 0 62 62" role="img" aria-label="@dialAria">
                    <circle cx="31" cy="31" r="25" fill="none" stroke="rgba(255,255,255,.20)" stroke-width="7"></circle>
                    <circle cx="31" cy="31" r="25" fill="none" stroke="#8fc7e8" stroke-width="7" stroke-linecap="round"
                            stroke-dasharray="157" stroke-dashoffset="@dialOffsetText" transform="rotate(-90 31 31)"></circle>
                    <text x="31" y="35" text-anchor="middle" font-size="14" font-weight="700" fill="#fff">@Model.OccupancyToday.ToString("0")%</text>
                </svg>
                <div>
                    <span>Today · @Model.ActualHotelToday.ToString("dd MMM")</span>
                    <strong>@Model.RoomsSoldToday / @Model.SellableRoomsToday rooms</strong>
                    <small>Hotel-local business date</small>
                </div>
            </div>

            <div class="dashboard-hero-stat">
                <span>Revenue · today <span class="dashboard-info-badge dashboard-info-inverse" tabindex="0" role="note" aria-label="About Revenue · today: Revenue payments recorded on today's hotel business date." data-info="Revenue payments recorded on today's hotel business date." title="Revenue payments recorded on today's hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span>
                <strong>@Money0(Model.RevenueToday)</strong>
                <small>Today only</small>
            </div>
            <div class="dashboard-hero-stat">
                <span>ADR <span class="dashboard-info-badge dashboard-info-inverse" tabindex="0" role="note" aria-label="About ADR: Average Daily Rate: accommodation revenue divided by rooms sold." data-info="Average Daily Rate: accommodation revenue divided by rooms sold." title="Average Daily Rate: accommodation revenue divided by rooms sold."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span>
                <strong>@Money0(Model.AdrToday)</strong>
                <small>Accommodation</small>
            </div>
            <div class="dashboard-hero-stat">
                <span>RevPAR <span class="dashboard-info-badge dashboard-info-inverse" tabindex="0" role="note" aria-label="About RevPAR: Revenue per Available Room: accommodation revenue divided by sellable rooms." data-info="Revenue per Available Room: accommodation revenue divided by sellable rooms." title="Revenue per Available Room: accommodation revenue divided by sellable rooms."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span>
                <strong>@Money0(Model.RevParToday)</strong>
                <small>Sellable rooms</small>
            </div>
        </div>

        @* Use the same dual-month date-range picker markup and styling as Availability. *@
        <form id="dashboardDateFilter" class="dashboard-date-filter" action="@Url.Action("Index", "Dashboard")" method="get" aria-label="Dashboard date range">
            <span class="dashboard-filter-title"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i> Date range</span>
            <div class="inventory-range-picker" id="inventoryRangePicker">
                <input type="hidden" id="dashboardStartDate" name="startDate" value="@rangeStartIso" />
                <input type="hidden" id="dashboardEndDate" name="endDate" value="@rangeEndIso" />
                <button type="button" class="inventory-range-display" id="inventoryRangeDisplay" aria-expanded="false" aria-controls="inventoryRangePopover" aria-haspopup="dialog">
                    <span id="inventoryRangeText">@Model.FilterStartDate.ToString("dd/MM/yyyy") - @Model.FilterEndDate.ToString("dd/MM/yyyy")</span>
                    <span class="inventory-calendar-icon"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span>
                </button>
                <div class="inventory-range-popover inventory-calendar-popover" id="inventoryRangePopover" role="dialog" aria-label="Select dashboard date range" hidden>
                    <div class="inventory-calendar-popover-head">
                        <div><strong>Select date range</strong><span>Choose a start and end date</span></div>
                        <button type="button" class="inventory-calendar-close" id="rangeCloseButton" aria-label="Close date picker">×</button>
                    </div>
                    <div class="inventory-calendar-months">
                        <section class="inventory-calendar-month">
                            <div class="inventory-calendar-month-head">
                                <button type="button" class="inventory-calendar-nav" data-calendar-shift="-1" aria-label="Previous month">‹</button>
                                <strong id="leftMonthLabel"></strong>
                                <button type="button" class="inventory-calendar-nav" data-calendar-shift="1" aria-label="Next month">›</button>
                            </div>
                            <div class="inventory-calendar-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                            <div class="inventory-calendar-grid" id="leftCalendarGrid"></div>
                        </section>
                        <section class="inventory-calendar-month">
                            <div class="inventory-calendar-month-head">
                                <button type="button" class="inventory-calendar-nav" data-calendar-shift="-1" aria-label="Previous month">‹</button>
                                <strong id="rightMonthLabel"></strong>
                                <button type="button" class="inventory-calendar-nav" data-calendar-shift="1" aria-label="Next month">›</button>
                            </div>
                            <div class="inventory-calendar-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                            <div class="inventory-calendar-grid" id="rightCalendarGrid"></div>
                        </section>
                    </div>
                    <div class="inventory-calendar-footer">
                        <span id="selectedRangeText">@Model.FilterStartDate.ToString("dd/MM/yyyy") - @Model.FilterEndDate.ToString("dd/MM/yyyy")</span>
                        <div>
                            <button type="button" class="inventory-range-clear" id="rangeClearButton">Clear</button>
                            <button type="button" class="inventory-range-apply" id="rangeApplyButton">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
            <span id="dashboardRangeError" class="dashboard-filter-error" role="alert" hidden></span>
        </form>
    </section>

    <section class="dashboard-kpis" aria-label="Key figures for @rangeLabel">
        <button type="button" class="dashboard-kpi dashboard-kpi-blue dashboard-kpi-button" data-dashboard-statistic="revenue">
            <div class="dashboard-kpi-label">Total Revenue Earned <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Payments received during the date range. Click for transaction details; this is not the same as earned accommodation revenue." title="Payments received during the date range. Click for transaction details; this is not the same as earned accommodation revenue."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.RevenueLast30)</div>
        </button>
        <button type="button" class="dashboard-kpi dashboard-kpi-amber dashboard-kpi-button" data-dashboard-statistic="receivables">
            <div class="dashboard-kpi-label">Receivables <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Unpaid reservation balances for arrivals within the chosen dates. Click for details." title="Unpaid reservation balances for arrivals within the chosen dates. Click for details."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.ReceivablesSelectedPeriod)</div>
        </button>
        <button type="button" class="dashboard-kpi dashboard-kpi-indigo dashboard-kpi-button" data-dashboard-statistic="expenses">
            <div class="dashboard-kpi-label">Total Expenses <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Recorded expenses for the chosen date range. Click to view expense transactions." title="Recorded expenses for the chosen date range. Click to view expense transactions."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.ExpensesLast30)</div>
        </button>
        <button type="button" class="dashboard-kpi dashboard-kpi-green dashboard-kpi-button" data-dashboard-statistic="profit">
            <div class="dashboard-kpi-label">Profit <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Payments less recorded expenses for the chosen dates, not audited net profit. Click for details." title="Payments less recorded expenses for the chosen dates, not audited net profit. Click for details."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.ProfitLast30)</div>
        </button>
        <button type="button" class="dashboard-kpi dashboard-kpi-slate dashboard-kpi-button" data-dashboard-statistic="noshow">
            <div class="dashboard-kpi-label">No-shows <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Reservations marked no-show in the chosen dates. Click to see records." title="Reservations marked no-show in the chosen dates. Click to see records."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.NoShowsLast30</div>
        </button>
        <button type="button" class="dashboard-kpi dashboard-kpi-red dashboard-kpi-button" data-dashboard-statistic="cancellations">
            <div class="dashboard-kpi-label">Cancellations <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Cancelled reservations in the chosen dates. Click to see records." title="Cancelled reservations in the chosen dates. Click to see records."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.CancellationsLast30</div>
        </button>
        <div class="dashboard-kpi dashboard-kpi-blue" role="group" aria-label="Total Inventory">
            <div class="dashboard-kpi-label">Total Room Nights  <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Total room inventory summed over every date in the chosen range (room-nights), not a count of distinct physical rooms." title="Total room inventory summed over every date in the chosen range (room-nights), not a count of distinct physical rooms."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedTotalInventoryNights.ToString("N0")</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-red" role="group" aria-label="Blocked">
            <div class="dashboard-kpi-label">Blocked <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Unavailable room-nights in the chosen dates. Includes active out-of-order room blocks from the occupancy calculation." title="Unavailable room-nights in the chosen dates. Includes active out-of-order room blocks from the occupancy calculation."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedBlockedRoomNights.ToString("N0")</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-teal" role="group" aria-label="Sellable">
            <div class="dashboard-kpi-label">Sellable <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Inventory room-nights minus blocked room-nights, summed across the chosen dates." title="Inventory room-nights minus blocked room-nights, summed across the chosen dates."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedSellableRoomNights.ToString("N0")</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-blue" role="group" aria-label="Sold">
            <div class="dashboard-kpi-label">Sold <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Booked room-nights in the selected date range, not the number of individual reservations." title="Booked room-nights in the selected date range, not the number of individual reservations."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedSoldRoomNights.ToString("N0")</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-slate" role="group" aria-label="Vacant">
            <div class="dashboard-kpi-label">Vacant <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Sellable room-nights not sold in the chosen dates. Each day is clamped at zero." title="Sellable room-nights not sold in the chosen dates. Each day is clamped at zero."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedVacantRoomNights.ToString("N0")</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-indigo" role="group" aria-label="In-house Guests">
            <div class="dashboard-kpi-label">In-house Guests <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Total guest-nights across the selected dates; one guest staying three nights contributes three." title="Total guest-nights across the selected dates; one guest staying three nights contributes three."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Model.SelectedGuestNights.ToString("N0")</div>
        </div>
        <button type="button" class="dashboard-kpi dashboard-kpi-blue dashboard-kpi-button" data-dashboard-statistic="occupancy">
            <div class="dashboard-kpi-label">Occupancy <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Booked room-nights divided by sellable room-nights in the selected dates. Click to see detailed occupancy figures." title="Booked room-nights divided by sellable room-nights in the selected dates. Click to see detailed occupancy figures."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@(Model.OccupancyNext30.ToString("0.#") + "%")</div>
        </button>
        <div class="dashboard-kpi dashboard-kpi-teal" role="group" aria-label="Accommodation (NET)">
            <div class="dashboard-kpi-label">Room Rent (NET) <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Accommodation revenue allocated to room-nights as in the Occupancy Report; not cash collected." title="Accommodation revenue allocated to room-nights as in the Occupancy Report; not cash collected."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.SelectedAccommodationRevenue)</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-blue" role="group" aria-label="Extras (NET)">
            <div class="dashboard-kpi-label">Extras (NET) <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Extras other than room rent posted during the selected dates. Not cash collections." title="Extras other than room rent posted during the selected dates. Not cash collections."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.SelectedExtrasRevenue)</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-orange" role="group" aria-label="Tax / VAT">
            <div class="dashboard-kpi-label">Tax / VAT <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Estimated configured tax on accommodation revenue. Actual invoice tax may differ." title="Estimated configured tax on accommodation revenue. Actual invoice tax may differ."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.SelectedReportTax)</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-teal" role="group" aria-label="ADR">
            <div class="dashboard-kpi-label">ADR <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Average Daily Rate: accommodation revenue divided by rooms sold across the selected dates." title="Average Daily Rate: accommodation revenue divided by rooms sold across the selected dates."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.SelectedAdr)</div>
        </div>
        <div class="dashboard-kpi dashboard-kpi-indigo" role="group" aria-label="RevPAR">
            <div class="dashboard-kpi-label">RevPAR <span class="dashboard-info-badge" tabindex="0" role="note" data-info="Revenue Per Available Room: accommodation revenue divided by all sellable room-nights in the selected dates." title="Revenue Per Available Room: accommodation revenue divided by all sellable room-nights in the selected dates."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></div>
            <div class="dashboard-kpi-value">@Money(Model.SelectedRevPar)</div>
        </div>
    </section>

    <div class="dashboard-overview-columns">
        <div class="dashboard-overview-left">
            <section class="dashboard-card dashboard-room-status-card">
                <header class="dashboard-card-head dashboard-room-status-head">
                    <div>
                        <h2>Room status</h2>
                        <p>Today · @Model.ActualHotelToday.ToString("dd MMM yyyy") · hover for guest details · updated @Model.GeneratedAt.ToString("HH:mm")</p>
                    </div>
                    <div class="dashboard-room-controls">
                        <button type="button" class="dashboard-pill is-active" data-room-filter="all">All <span data-room-filter-count="all">@roomTotal</span></button>
                        <button type="button" class="dashboard-pill" data-room-filter="checkin">Check in <span data-room-filter-count="checkin">@roomCheckIn</span></button>
                        <button type="button" class="dashboard-pill" data-room-filter="reservation">Reservation <span data-room-filter-count="reservation">@roomReservation</span></button>
                        <button type="button" class="dashboard-pill" data-room-filter="checkout">Check out <span data-room-filter-count="checkout">@roomCheckout</span></button>
                        <button type="button" class="dashboard-pill" data-room-filter="vacant">Vacant <span data-room-filter-count="vacant">@roomVacant</span></button>
                        <button type="button" class="dashboard-pill" data-room-filter="ooo">Blocked <span data-room-filter-count="ooo">@roomBlocked</span></button>
                        <select id="dashboardRoomDate" class="dashboard-select" aria-label="Room status date">
                            <option value="@todayIso">Today</option>
                            <option value="@tomorrowIso">Next day</option>
                        </select>
                    </div>
                </header>
                <div class="dashboard-card-body dashboard-room-status-body">
                    <div id="dashboardRoomRack" class="dashboard-room-rack">
                        @foreach (var room in Model.RoomStatus)



                        {



                            var filterState = RoomBucket(room.State, room.IsDirty);



                            var statusText = filterState == "ooo" ? "Out of order"



                            : filterState == "checkin" ? "Checked in"



                            : filterState == "reservation" ? "Reservation"



                            : filterState == "checkout" ? "Checked out"



                            : "Vacant";



                            var dateRange = room.ArrivalDate.HasValue && room.DepartureDate.HasValue



                            ? room.ArrivalDate.Value.ToString("dd MMM") + "–" + room.DepartureDate.Value.ToString("dd MMM")



                            : string.Empty;



                            var roomMeta = "Room " + room.RoomNo;



                            if (!string.IsNullOrWhiteSpace(room.Category)) roomMeta += " · " + room.Category;



                            if (!string.IsNullOrWhiteSpace(room.ReservationId)) roomMeta += " · " + room.ReservationId;
                            <button type="button"
                                    class="dashboard-room dashboard-room-@filterState"
                                    data-room-state="@filterState"
                                    data-room-payment="@room.PaymentState"
                                    aria-label="Room @room.RoomNo @statusText">
                                <span class="dashboard-room-no">@room.RoomNo</span>
                                @if (room.PaymentState == "pending")



                                {
                                    <span class="dashboard-room-dot dashboard-room-dot-pending" aria-hidden="true"></span>
                                }



                                else if (room.PaymentState == "partial")



                                {
                                    <span class="dashboard-room-dot dashboard-room-dot-partial" aria-hidden="true"></span>
                                }



                                else if (room.PaymentState == "paid")



                                {
                                    <span class="dashboard-room-dot dashboard-room-dot-paid" aria-hidden="true"></span>
                                }
                                <span class="dashboard-room-tip" role="tooltip">
                                    @if (!string.IsNullOrWhiteSpace(room.GuestName))



                                    {
                                        <strong>@room.GuestName</strong>
                                    }



                                    else



                                    {
                                        <strong>Room @room.RoomNo</strong>
                                    }
                                    <span>@roomMeta</span>
                                    <span>@statusText@(string.IsNullOrWhiteSpace(dateRange) ? string.Empty : " · " + dateRange)</span>
                                    @if (room.Balance > 0)



                                    {
                                        <b class="@(room.PaymentState == "partial" ? "dashboard-room-balance-partial" : "dashboard-room-balance-pending")">@Money(room.Balance) @(room.PaymentState == "partial" ? "part paid" : "pending")</b>
                                    }



                                    else if (filterState != "vacant" && filterState != "ooo")



                                    {
                                        <b class="dashboard-room-balance-settled">Settled</b>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    <div id="dashboardRoomLegend" class="dashboard-room-legend" aria-label="Room status legend">
                        <span class="dashboard-room-legend-item dashboard-room-total"><i class="dashboard-legend-all"></i>Total rooms <b data-room-legend-count="all">@roomTotal</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-checkin"></i>Checked in <b data-room-legend-count="checkin">@roomCheckIn</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-reservation"></i>Reservation <b data-room-legend-count="reservation">@roomReservation</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-checkout"></i>Checked out <b data-room-legend-count="checkout">@roomCheckout</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-vacant"></i>Vacant <b data-room-legend-count="vacant">@roomVacant</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-ooo"></i>Out of order <b data-room-legend-count="ooo">@roomBlocked</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-pending"></i>Not paid <b data-room-legend-count="pending">@roomPendingPayment</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-partial"></i>Partially paid <b data-room-legend-count="partial">@roomPartialPayment</b></span>
                        <span class="dashboard-room-legend-item"><i class="dashboard-legend-paid"></i>Fully paid <b data-room-legend-count="paid">@roomPaidPayment</b></span>
                    </div>
                </div>
            </section>

            <section class="dashboard-card">
                <header class="dashboard-card-head">
                    <div><h2>Occupancy on the books</h2><p id="dashboardOccupancyDescription">Monthly booked room-nights ÷ sellable room-nights · full year vs last year</p></div><div class="dashboard-annual-legend" aria-label="Occupancy comparison legend"><span><i style="background:#376eaa"></i>Selected year</span><span><i style="background:#c4d5e7"></i>Previous year</span></div>
                    <label class="dashboard-year-selector"><span>Year</span><select class="dashboard-year-select" aria-label="Chart year">
@for (var yr = Math.Max(2000, Model.ActualHotelToday.Year - 5); yr <= Model.ActualHotelToday.Year + 1; yr++) { <option value="@yr" selected="@(yr == Model.ActualHotelToday.Year)">@yr</option> }
</select></label>
                </header>
                <div class="dashboard-card-body">
                    <div class="dashboard-annual-chart-shell" id="dashboardOccupancyShell" aria-busy="true">
                        <svg id="dashboardOccupancyChart" class="dashboard-chart dashboard-chart-large" viewBox="0 0 760 190" role="img" aria-label="Grouped bar chart comparing booked occupancy with last year"></svg>
                        <div id="dashboardOccupancyLoader" class="dashboard-annual-loading" role="status" aria-live="polite">
                            <span class="dashboard-annual-spinner" aria-hidden="true"></span>
                            <span class="dashboard-annual-loading-label">Loading annual occupancy…</span>
                        </div>
                    </div>
                    <div class="dashboard-chart-foot">
                        <div><span>Full-year occupancy</span><strong id="dashboardOcc30">—</strong></div>
                        <div><span>Last-year occupancy</span><strong id="dashboardOccYearLy">—</strong></div>
                        <div><span>Year</span><strong id="dashboardOccYear">@Model.ActualHotelToday.Year</strong></div>
                        <div><span>Room-nights booked</span><strong id="dashboardOccRoomNights">—</strong></div>
                    </div>
                </div>
            </section>


            <section class="dashboard-card">
                <header class="dashboard-card-head"><div><h2>Room type performance</h2><p>Occupancy, ADR and revenue · @rangeLabel</p></div><label class="dashboard-year-selector">Sort <select id="dashboardRoomTypeSort" aria-label="Sort room types"><option value="occupancy">Occupancy</option><option value="share">Revenue share</option><option value="name">Room type</option></select></label></header>
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table dashboard-roomtype-table">
                        <thead><tr><th>Room type</th><th class="dashboard-right">Rooms</th><th>Occupancy</th><th class="dashboard-right">ADR</th><th class="dashboard-right">RevPAR</th><th class="dashboard-right">Revenue</th><th class="dashboard-right">Share</th></tr></thead>
                        <tbody id="dashboardRoomTypesBody">
                            <tr><td colspan="7" class="dashboard-empty-cell dashboard-analytics-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading room-type performance…</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="dashboard-card">
                <header class="dashboard-card-head">
                    <div><h2>Revenue and profit</h2><p id="dashboardRevenueDescription">Monthly revenue, operating profit and last-year revenue · full year</p></div><div class="dashboard-annual-legend" aria-label="Financial chart legend"><span><i style="background:#80a9d2"></i>Revenue</span><span><i style="background:#2d9470"></i>Profit</span><span><i style="background:#a4afbf"></i>Last year</span></div>
                    <label class="dashboard-year-selector"><span>Year</span><select class="dashboard-year-select" aria-label="Chart year">
@for (var yr = Math.Max(2000, Model.ActualHotelToday.Year - 5); yr <= Model.ActualHotelToday.Year + 1; yr++) { <option value="@yr" selected="@(yr == Model.ActualHotelToday.Year)">@yr</option> }
</select></label>
                </header>
                <div class="dashboard-card-body">
                    <svg id="dashboardRevenueChart" class="dashboard-chart" viewBox="0 0 560 175" role="img" aria-label="Revenue columns with profit and last-year revenue lines"></svg>
                    <div class="dashboard-chart-foot">
                        <div><span>Annual revenue</span><strong id="dashboardRevenue30">—</strong></div>
                        <div><span>Annual profit</span><strong id="dashboardProfit30">—</strong></div>
                        <div><span>Annual profit margin</span><strong id="dashboardProfitMargin30">—</strong></div>
                    </div>
                </div>
            </section>

            <section class="dashboard-card">
                <header class="dashboard-card-head">
                    <div><h2>Daily occupancy calendar · @Model.ActualHotelToday.ToString("MMMM yyyy")</h2><p>Current hotel month · booked occupancy by date (future dates = bookings on hand)</p></div>
                    <div class="dashboard-chart-key"><span><i class="dashboard-key-future"></i>Upcoming date</span><span><i class="dashboard-key-today"></i>Today</span></div>
                </header>
                <div class="dashboard-card-body">
                    <div id="dashboardOccupancyTrendChart" class="dashboard-occupancy-heatmap" role="group" aria-label="Calendar heatmap of occupancy for the current hotel month"></div>
                    <div class="dashboard-chart-foot">
                        <div><span>Today booked occupancy</span><strong>@Model.OccupancyToday.ToString("0.#")%</strong></div>
                        <div><span>Upcoming nights this month</span><strong id="dashboardFutureNightsCount">—</strong></div>
                        <div><span>Today's ADR</span><strong>@Money0(Model.AdrToday)</strong></div>
                    </div>
                </div>
            </section>


            <section class="dashboard-card dashboard-pricing-card" aria-labelledby="dashboardPricingTitle">
                <header class="dashboard-card-head dashboard-pricing-head">
                    <div>
                        <h2 id="dashboardPricingTitle">Pricing guidance</h2>
                        <p>Occupancy-based rate suggestions · @Model.FilterStartDate.ToString("dd MMM")–@Model.FilterEndDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <a class="dashboard-pill dashboard-link-pill" href="/Availability">Review inventory <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                </header>
                <div class="dashboard-card-body dashboard-pricing-body">
                    <div class="dashboard-pricing-summary" id="dashboardPricingSummary" style="display:none;"  aria-label="Pricing recommendation summary">
                        <div><span>Rate plans</span><strong id="dashboardPricingTotal">—</strong></div>
                        <div><span>Raise</span><strong id="dashboardPricingRaise">—</strong></div>
                        <div><span>Reduce</span><strong id="dashboardPricingReduce">—</strong></div>
                        <div><span>Hold</span><strong id="dashboardPricingHold">—</strong></div>
                    </div>
                    <div class="dashboard-pricing-toolbar">
                        <div class="dashboard-pricing-filters" role="group" aria-label="Filter pricing recommendations">
                            <button type="button" class="dashboard-pricing-filter is-active" data-price-filter="all" aria-pressed="true">All</button>
                            <button type="button" class="dashboard-pricing-filter" data-price-filter="raise" aria-pressed="false">Raise</button>
                            <button type="button" class="dashboard-pricing-filter" data-price-filter="reduce" aria-pressed="false">Reduce</button>
                            <button type="button" class="dashboard-pricing-filter" data-price-filter="hold" aria-pressed="false">Hold</button>
                        </div>
                        <label class="dashboard-pricing-sort">Sort
                            <select id="dashboardPricingSort" aria-label="Sort rate suggestions">
                                <option value="occupancy">Highest occupancy</option>
                                <option value="change">Largest rate change</option>
                                <option value="category">Room category A–Z</option>
                            </select>
                        </label>
                    </div>
                    <div id="dashboardPrices" class="dashboard-prices dashboard-pricing-list" aria-live="polite" aria-atomic="false">
                        <div class="dashboard-empty-block dashboard-analytics-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading pricing guidance…</div>
                    </div>
                    <div class="dashboard-pricing-footer">
                        <span id="dashboardPricingShowing" class="dashboard-pricing-showing" role="status"></span>
                        <button id="dashboardPricingCopy" class="dashboard-pricing-copy" type="button" disabled><i class="fa-regular fa-copy" aria-hidden="true"></i> Copy visible suggestions</button>
                    </div>
                    <div class="dashboard-pricing-disclaimer"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Advisory only. No rates are changed automatically; review restrictions, costs and market conditions before updating.</div>
                    <details class="dashboard-pricing-method">
                        <summary>How are rates suggested?</summary>
                        <p>Recommendations use room-category occupancy in the selected date range. At 85%+ occupancy: +12%; 75–84%: +8%; 65–74%: +4%; 50–64%: hold; 35–49%: −6%; below 35%: −10%. They are indicative, not live competitor pricing.</p>
                    </details>
                </div>
            </section>
        </div>

        <div class="dashboard-overview-right">
            <section class="dashboard-card dashboard-operations-card">
                <header class="dashboard-card-head">
                    <div><h2>Operations · today</h2><p>Room movements and availability as of @Model.ActualHotelToday.ToString("dd MMM yyyy")</p></div>
                    <a class="dashboard-pill dashboard-link-pill" href="/Calendar">Front desk</a>
                </header>
                <div class="dashboard-card-body">
                    <div class="dashboard-operations">
                        <button type="button" class="dashboard-operation" data-dashboard-statistic="checkin"><span>Check-ins Today <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Check-ins on end date: Arrivals and check-ins counted for the hotel business date (today)." data-info="Arrivals and check-ins counted for the hotel business date (today)." title="Arrivals and check-ins counted for the hotel business date (today)."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.ArrivalsToday</strong></button>
                        <button type="button" class="dashboard-operation" data-dashboard-statistic="checkout"><span>Check-outs Today <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Check-outs on end date: Departures and check-outs counted for the current hotel business date." data-info="Departures and check-outs counted for the current hotel business date." title="Departures and check-outs counted for the current hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.DeparturesToday</strong></button>
                        <button type="button" class="dashboard-operation dashboard-operation-available" data-dashboard-statistic="available"><span>Available rooms <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Available rooms: Rooms available to sell on the current hotel business date." data-info="Rooms available to sell on the current hotel business date." title="Rooms available to sell on the current hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.AvailableRoomsToday</strong></button>
                        <button type="button" class="dashboard-operation dashboard-operation-occupied" data-dashboard-statistic="occupied"><span>Occupied rooms <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Occupied rooms: Rooms occupied or sold for the current hotel business date." data-info="Rooms occupied or sold for the current hotel business date." title="Rooms occupied or sold for the current hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.RoomsSoldToday</strong></button>
                        <button type="button" class="dashboard-operation dashboard-operation-danger" data-dashboard-statistic="blocked"><span>Blocked <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Blocked / OOO: Rooms blocked or out of order on the current hotel business date." data-info="Rooms blocked or out of order on the current hotel business date." title="Rooms blocked or out of order on the current hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.BlockedRoomsToday</strong></button>
                        <button type="button" class="dashboard-operation dashboard-operation-warning" data-dashboard-statistic="dirty"><span>Dirty rooms <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Dirty rooms: Rooms marked dirty for housekeeping on the current hotel business date." data-info="Rooms marked dirty for housekeeping on the current hotel business date." title="Rooms marked dirty for housekeeping on the current hotel business date."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.DirtyRoomsToday</strong></button>
                    </div>
                    <div class="dashboard-mini-stats">
                        <div><span>In-house guests <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About In-house guests: Guests currently checked in according to the dashboard snapshot." data-info="Guests currently checked in according to the dashboard snapshot." title="Guests currently checked in according to the dashboard snapshot."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.InHouseGuests</strong></div>
                        <div><span>Average stay <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Average stay: Average length of stay for the dashboard guest population, in nights." data-info="Average length of stay for the dashboard guest population, in nights." title="Average length of stay for the dashboard guest population, in nights."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.AverageStayNights.ToString("0.#") <small>nights</small></strong></div>
                        <div><span>Repeat guests <span class="dashboard-info-badge" tabindex="0" role="note" aria-label="About Repeat guests: Percentage of dashboard guests identified as returning guests." data-info="Percentage of dashboard guests identified as returning guests." title="Percentage of dashboard guests identified as returning guests."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span></span><strong>@Model.RepeatGuestPercent.ToString("0.#")%</strong></div>
                    </div>
                </div>
            </section>

            @* Monthly booking volume by source, adapted from WebForms Dashboard's
               ReservationChartOption (year selector + stacked columns). *@
            <section class="dashboard-card dashboard-bookings-card">
                <header class="dashboard-card-head dashboard-bookings-head">
                    <div>
                        <h2>Bookings · <span id="dashboardBookingsYearLabel">@Model.FilterEndDate.Year</span></h2>
                        <p>Monthly reservation count by booking source · arrival month</p>
                    </div>
                    <label class="dashboard-bookings-year-label" for="dashboardBookingsYear">
                        <span>Year</span>
                        <select id="dashboardBookingsYear" aria-label="Bookings year" data-bookings-url="/Dashboard/Bookings">
                            @for (var year = Math.Min(2024, Model.FilterEndDate.Year - 2); year <= Math.Max(2035, Model.FilterEndDate.Year + 1); year++)
                            {
                                <option value="@year" selected="@(year == Model.FilterEndDate.Year)">@year</option>
                            }
                        </select>
                    </label>
                </header>
                <div class="dashboard-card-body">
                    <div id="dashboardBookingsMessage" class="dashboard-bookings-message" role="status" aria-live="polite">Loading booking sources…</div>
                    <svg id="dashboardBookingsChart" class="dashboard-chart dashboard-bookings-chart" viewBox="0 0 560 220" role="img" aria-label="Stacked monthly bookings by source" tabindex="0"></svg>
                    <div id="dashboardBookingsLegend" class="dashboard-bookings-legend" role="group" aria-label="Click booking sources to show or hide them"></div>
                    <p class="dashboard-bookings-help">Click a source in the legend to hide or show its bars. Year totals remain unchanged.</p>
                    <div class="dashboard-chart-foot dashboard-bookings-summary">
                        <div><span>Bookings in selected year</span><strong id="dashboardBookingsTotal">—</strong></div>
                        <div><span>Top booking source</span><strong id="dashboardBookingsTopSource">—</strong></div>
                    </div>
                </div>
            </section>

            <section class="dashboard-card dashboard-guest-card">
                <header class="dashboard-card-head">
                    <div><h2>In-house guests</h2><p>@Model.InHouseGuests guest@(Model.InHouseGuests == 1 ? "" : "s") on @Model.ActualHotelToday.ToString("dd MMM")</p></div>
                    <div class="dashboard-guest-filters">
                        <button type="button" class="dashboard-pill is-active" data-guest-filter="all">All</button>
                        <button type="button" class="dashboard-pill" data-guest-filter="due">Due out</button>
                        <button type="button" class="dashboard-pill" data-guest-filter="balance">Balance</button>
                    </div>
                </header>
                <div class="dashboard-table-wrap dashboard-guest-table-wrap">
                    <table class="dashboard-table">
                        <thead><tr><th>Room</th><th>Guest</th><th>Stay</th><th>Nights</th><th class="dashboard-right">Balance</th></tr></thead>
                        <tbody>
                            @if (Model.InHouseGuestRows.Count == 0)



                            {
                                <tr><td colspan="5" class="dashboard-empty-cell">No in-house guests found.</td></tr>
                            }



                            else



                            {



                                foreach (var guest in Model.InHouseGuestRows)



                                {
                                    <tr data-guest-due="@(guest.DueOutToday ? "1" : "0")" data-guest-balance="@(guest.Balance > 0 ? "1" : "0")">
                                        <td><strong>@guest.RoomNo</strong></td>
                                        <td>@guest.GuestName<div class="dashboard-subtext">@guest.ReservationId · @guest.Guests guest@(guest.Guests == 1 ? "" : "s")</div></td>
                                        <td>@guest.ArrivalDate.ToString("dd MMM")–@guest.DepartureDate.ToString("dd MMM")</td>
                                        <td>@guest.Nights</td>
                                        <td class="dashboard-right">
                                            @if (guest.Balance > 0)



                                            {
                                                <span class="dashboard-chip dashboard-chip-warning">@Money(guest.Balance)</span>
                                            }



                                            else



                                            {
                                                <span class="dashboard-chip dashboard-chip-good">Settled</span>
                                            }
                                        </td>
                                    </tr>
                                }



                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="dashboard-card dashboard-money-card">
                <header class="dashboard-card-head"><div><h2>Where the money comes from</h2><p>Accommodation revenue on the books · @rangeLabel</p></div></header>
                <div class="dashboard-table-wrap dashboard-source-table-wrap">
                    <table class="dashboard-table">
                        <thead><tr><th>Channel</th><th class="dashboard-right">Rooms</th><th class="dashboard-right">ADR</th><th class="dashboard-right">Revenue</th><th class="dashboard-right">Share</th></tr></thead>
                        <tbody id="dashboardRevenueSourcesBody">
                            <tr><td colspan="5" class="dashboard-empty-cell dashboard-analytics-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading revenue sources…</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>


            <section class="dashboard-card">
                <header class="dashboard-card-head"><div><h2>Cancellations and no-shows</h2><p>Monthly totals · complete calendar year</p></div><label class="dashboard-year-selector"><span>Year</span><select class="dashboard-year-select" aria-label="Chart year">
@for (var yr = Math.Max(2000, Model.ActualHotelToday.Year - 5); yr <= Model.ActualHotelToday.Year + 1; yr++) { <option value="@yr" selected="@(yr == Model.ActualHotelToday.Year)">@yr</option> }
</select></label></header>
                <div class="dashboard-card-body">
                    <svg id="dashboardExceptionChart" class="dashboard-chart dashboard-chart-small" viewBox="0 0 420 120" role="img" aria-label="Cancellations and no-shows"></svg>
                    <table class="dashboard-table dashboard-exception-table">
                        <thead><tr><th>Type</th><th class="dashboard-right">Annual count</th><th class="dashboard-right">Share of exceptions</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.ExceptionSources)



                            {
                                <tr data-exception-annual="@item.Source"><td>@item.Source</td><td class="dashboard-right">—</td><td class="dashboard-right">—</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="dashboard-card">
                <header class="dashboard-card-head"><div><h2>Decisions waiting on you</h2><p>Ranked operational and revenue signals</p></div></header>
                <div class="dashboard-card-body">
                    <ul id="dashboardDecisions" class="dashboard-decisions">
                        <li class="dashboard-decision dashboard-decision-info dashboard-analytics-loading"><i></i><div><strong>Loading dashboard signals…</strong><p>Revenue and demand analysis is loading after the live dashboard.</p></div></li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
</div>


<div id="dashboardStatisticOverlay" class="dashboard-stat-overlay" hidden></div>
<section id="dashboardStatisticModal" class="dashboard-stat-modal" role="dialog" aria-modal="true" aria-labelledby="dashboardStatisticTitle" hidden>
    <header class="dashboard-stat-modal-head">
        <div>
            <h2 id="dashboardStatisticTitle">Details</h2>
            <p id="dashboardStatisticSubtitle"></p>
        </div>
        <button type="button" class="dashboard-stat-close" data-dashboard-stat-close aria-label="Close details">×</button>
    </header>
    <div class="dashboard-stat-summary">
        <span id="dashboardStatisticSummaryLabel">Total</span>
        <strong id="dashboardStatisticSummaryValue">—</strong>
    </div>
    <div id="dashboardStatisticLoading" class="dashboard-stat-loading">
        <i class="fa-solid fa-spinner fa-spin"></i> Loading details…
    </div>
    <div id="dashboardStatisticTableWrap" class="dashboard-stat-table-wrap" hidden>
        <table class="dashboard-table dashboard-stat-table">
            <thead><tr id="dashboardStatisticHead"></tr></thead>
            <tbody id="dashboardStatisticBody"></tbody>
        </table>
    </div>
    <div id="dashboardStatisticEmpty" class="dashboard-empty-block" hidden>No records found for this statistic.</div>
</section>

<script type="application/json" id="dashboardOccupancyData">@Html.Raw(occupancyJson)</script>
<script type="application/json" id="dashboardOccupancyLyData">@Html.Raw(occupancyLyJson)</script>
<script type="application/json" id="dashboardFinancialData">@Html.Raw(financialJson)</script>
<script type="application/json" id="dashboardExceptionData">@Html.Raw(exceptionJson)</script>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
