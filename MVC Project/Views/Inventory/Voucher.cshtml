@model Orapmshms.Models.HotelInventory.InventoryVoucher
@{
    Layout = null;
}
<!doctype html><html lang="en"><head><meta charset="utf-8" />
<title>@Model.Type #@Model.Id - ORA PMS</title>
<style>
body{font-family:Arial,Helvetica,sans-serif;color:#183454;margin:0;background:#f1f5fa;font-size:13px}.paper{background:#fff;max-width:820px;margin:35px auto;padding:44px;box-shadow:0 4px 30px #122b4322}.top{display:flex;flex-direction:column;align-items:stretch;border-bottom:2px solid #1d487c;padding-bottom:21px;margin-bottom:24px}.hotel-identity{text-align:center;padding:6px 0 22px}.hotel-identity h1{font-size:28px;margin:3px 0;color:#172f53;font-weight:800}.doc-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}h1{font-size:21px;margin:4px 0 0}h2{font-size:14px;margin:0}.muted{color:#718298;font-size:12px}.meta{display:flex;justify-content:space-between;gap:20px;margin-bottom:25px}table{width:100%;border-collapse:collapse}th{text-align:left;background:#edf3fb;font-weight:600}td,th{padding:13px;border-bottom:1px solid #e3e9f1}.right{text-align:right}.totals{text-align:right;margin-top:20px;font-weight:600}.signatures{display:flex;gap:30px;justify-content:space-between;margin-top:80px}.signatures>div{width:45%;border-top:1px solid #a2adbc;padding-top:8px}.toolbar{max-width:820px;margin:20px auto 0;display:flex;justify-content:flex-end}.toolbar{gap:10px;align-items:center}.toolbar button{background:#173f74;color:white;border:0;padding:12px 19px;border-radius:8px;cursor:pointer;font-weight:700;font-size:13px}.toolbar .close-preview{background:#fff;color:#1d4675;border:1px solid #bcd0e5}.toolbar button:hover{filter:brightness(1.08)}@@media print{body{background:#fff}.paper{max-width:none;box-shadow:none;margin:0;padding:20px}.toolbar{display:none}@@page{size:A4;margin:12mm}}
</style></head><body>
<div class="toolbar"><button type="button" class="close-preview" onclick="window.close()">Close preview</button><button type="button" onclick="window.print()">🖨 Print / Save PDF</button></div>
<div class="paper"><div class="top"><div class="hotel-identity"><h1>@(string.IsNullOrWhiteSpace(Model.HotelName)?"Hotel":Model.HotelName)</h1><div class="muted">ORA PMS · INVENTORY MANAGEMENT</div></div><div class="doc-heading"><div><h2 style="font-size:20px">@Model.Type</h2></div><div class="right"><strong>Document #@Model.Id</strong></div></div></div>
<div class="meta"><div><h2>@Model.Description</h2>
@if(!string.IsNullOrWhiteSpace(Model.Destination)){<p><strong>Destination:</strong> @Model.Destination</p>}
@if(!string.IsNullOrWhiteSpace(Model.Purpose)){<p><strong>Purpose:</strong> @Model.Purpose</p>}
@if(!string.IsNullOrWhiteSpace(Model.RequestedBy)){<p><strong>Requested by:</strong> @Model.RequestedBy</p>}
@if(!string.IsNullOrWhiteSpace(Model.ReviewedBy)){<p><strong>Reviewed by:</strong> @Model.ReviewedBy</p>}
@if(!string.IsNullOrWhiteSpace(Model.DecisionNote)){<p><strong>Decision note:</strong> @Model.DecisionNote</p>}
</div><div class="right">Date: @(Model.Historical ? (string.IsNullOrWhiteSpace(Model.SourceDateDisplay) ? "Not recorded" : Model.SourceDateDisplay) : Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))<br/>Status: <strong>@Model.Status</strong>
@if(Model.ReviewedAt.HasValue){<div>Reviewed: @Model.ReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>}
</div></div>
@if(Model.Historical){<p class="muted"><strong>Historical record:</strong> Reproduced from existing Web Forms database records. This is not a copy of an original signed document. Issue/transfer records may contain only the details preserved in the activity log.</p>}
@if(Model.RequestType.Length>0){<p class="muted">This demand note requests approval. It is not a receipt or proof that goods were received or issued.</p>}
<table><thead><tr><th>#</th><th>Item code</th><th>Item</th><th class="right">Quantity</th><th class="right">Unit cost</th></tr></thead><tbody>
@for (var i = 0; i < Model.Lines.Count; i++)
{
    var line = Model.Lines[i];
    <tr><td>@(i + 1)</td><td>@line.Code</td><td>@line.Item</td><td class="right">@line.Qty</td><td class="right">@(line.UnitCost > 0 ? line.UnitCost.ToString("N2") : "—")</td></tr>
}
@if(Model.Lines.Count==0){<tr><td colspan="5" style="text-align:center;padding:24px">No processed lines recorded for this document yet.</td></tr>}
</tbody></table>
<div class="totals">Total quantity: @Model.Lines.Sum(x=>x.Qty)</div><div class="signatures"><div>@(Model.RequestType.Length>0?"Requested by":"Prepared by / Store")</div><div>@(Model.RequestType.Length>0?"Approved / Rejected by":"Approved / Received by")</div></div>
</div></body></html>
