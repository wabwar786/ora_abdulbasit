@model Orapmshms.Models.HotelInventory.InventoryPage
<div class="oi-notice info">Values used by existing items cannot be deleted or renamed until those items are updated.</div>
<div class="oi-grid2">
@foreach(var group in new[]{(key:"Category",name:"Categories",values:Model.Categories),(key:"Type",name:"Item types",values:Model.Types),(key:"Unit",name:"Units",values:Model.Units),(key:"Location",name:"Locations",values:Model.Locations)}){
<section class="oi-card"><div class="oi-card-head"><div><h2>@group.name</h2><p>Manage @group.name.ToLowerInvariant() in the existing database.</p></div></div>
<div class="oi-card-toolbar"><form class="oi-ajax-form oi-toolbar" method="post" action="/Inventory/lookup">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@group.key"/><input name="value" required placeholder="New @group.key" maxlength="150" /><button type="submit" class="oi-btn primary">+ Add</button></form></div>
<div class="oi-table-scroll"><table><thead><tr><th>NAME</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var v in group.values){<tr><td>@v</td><td class="oi-row-actions"><form action="/Inventory/lookup/change" class="oi-ajax-form oi-inline" method="post">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@group.key"/><input type="hidden" name="value" value="@v"/><input type="hidden" name="operation" value="Edit"/><input name="replacement" aria-label="New value for @v" placeholder="Rename" required maxlength="150" /><button class="oi-btn small" type="submit">Save</button></form><form method="post" action="/Inventory/lookup/change" class="oi-ajax-form oi-inline" data-confirm="Delete unused value '@v'?">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@group.key"/><input type="hidden" name="value" value="@v"/><input type="hidden" name="operation" value="Delete"/><button type="submit" class="oi-btn small danger">Delete</button></form></td></tr>}@if(group.values.Count==0){<tr><td colspan="2" class="oi-empty">No entries.</td></tr>}</tbody></table></div>
</section>}
</div>
