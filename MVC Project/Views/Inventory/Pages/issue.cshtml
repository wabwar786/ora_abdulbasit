@model Orapmshms.Models.HotelInventory.InventoryPage
@{var approved=Model.Requests.Where(x=>x.Type=="Issue"&&(x.Status=="Approved"||x.Status=="InProgress")).ToList();}
<section class="oi-card"><div class="oi-card-head"><div><h2>Issue approved stock</h2><p>Issue inventory against approved departmental demand notes.</p></div><a class="oi-btn" href="/Inventory/Requests">Stock requests</a></div>
<div class="oi-table-scroll"><table><thead><tr><th>DEMAND</th><th>DESTINATION</th><th>ITEM</th><th>REQUESTED</th><th>ISSUED</th><th>ISSUE NOW</th><th>DOCUMENTS</th></tr></thead><tbody>@foreach(var r in approved){@foreach(var l in r.Lines.Where(l=>l.Outstanding>0)){<tr><td>DN-@r.Id</td><td>@r.Destination</td><td>@l.ItemName</td><td>@l.Quantity</td><td>@l.Processed</td><td>@if(Model.Items.FirstOrDefault(x=>x.Code==l.ItemCode)?.Kind=="Asset"){<a href="/Inventory/Assets" class="oi-btn small">Use asset register</a>}else{<form class="oi-inline oi-ajax-form oi-row-actions" method="post" action="/Inventory/issue">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.Id"/><input type="hidden" name="lineId" value="@l.Id"/><input type="number" name="quantity" min="1" max="@l.Outstanding" value="@l.Outstanding" required/><button class="oi-btn primary small" type="submit" disabled="@(!Model.WorkflowReady)">Issue</button></form>}</td><td><a href="/Inventory/voucher?type=demand&amp;id=@r.Id" target="_blank" rel="noopener" class="oi-btn small">Demand note</a>@if(l.Processed>0){<a href="/Inventory/voucher?type=issue&amp;id=@r.Id" target="_blank" rel="noopener" class="oi-btn small">Issue voucher</a>}</td></tr>}}@if(!approved.Any(r=>r.Lines.Any(l=>l.Outstanding>0))){<tr><td colspan="7" class="oi-empty">No approved department demands waiting for issue.</td></tr>}</tbody></table></div></section>
<section class="oi-card"><div class="oi-card-head"><div><h2>Issued vouchers</h2><p>View or print existing issue documents.</p></div></div><div class="oi-table-scroll"><table><thead><tr><th>DEMAND</th><th>DESTINATION</th><th>ISSUED QUANTITY</th><th>ACTION</th></tr></thead><tbody>@foreach(var r in Model.Requests.Where(r=>r.Type=="Issue"&&r.Lines.Any(l=>l.Processed>0))){<tr><td>DN-@r.Id</td><td>@r.Destination</td><td>@r.Lines.Sum(l=>l.Processed)</td><td><a href="/Inventory/voucher?type=issue&amp;id=@r.Id" target="_blank" rel="noopener" class="oi-btn small">View / Print voucher</a></td></tr>}</tbody></table></div></section>
