@model Orapmshms.Models.HotelInventory.InventoryPage
<section class="oi-card">
 <div class="oi-card-head"><div><h2>Suppliers</h2><p>Vendors that supply stock to your hotel — contact, location and status.</p></div></div>
 <div class="oi-card-toolbar"><span class="oi-muted">@Model.Suppliers.Count registered supplier(s)</span><div class="oi-toolbar"><input type="search" placeholder="Search suppliers..." data-filter-table="oi-suppliers" aria-label="Search suppliers" /><a class="oi-btn" href="#" data-export-table="oi-suppliers">CSV</a><button type="button" class="oi-btn" data-print-table="oi-suppliers" data-print-title="Supplier Register">Print</button><button class="oi-btn primary" type="button" data-open-dialog="oi-supplier-dialog">+ Add supplier</button></div></div>
 <div class="oi-table-scroll"><table id="oi-suppliers"><thead><tr><th>SR #</th><th>CODE</th><th>BUSINESS NAME</th><th>CONTACT PERSON</th><th>EMAIL</th><th>PHONE</th><th>CITY</th><th>COUNTRY</th><th>ACTION</th></tr></thead><tbody>@{var row=0;}@foreach(var s in Model.Suppliers){row++;<tr><td>@row</td><td>SUP-@s.Id.ToString("D4")</td><td><strong>@s.Business</strong></td><td>@s.Name</td><td>@s.Email</td><td>@s.Phone</td><td>@s.City</td><td>@s.Country</td><td><button type="button" class="oi-btn small" data-open-dialog="oi-supplier-dialog" data-edit-record data-id="@s.Id" data-business="@s.Business" data-name="@s.Name" data-email="@s.Email" data-phone="@s.Phone" data-country="@s.Country" data-city="@s.City" data-address="@s.Address" data-postal="@s.Postal">✎ Edit</button></td></tr>}@if(Model.Suppliers.Count==0){<tr><td colspan="9" class="oi-empty">No suppliers registered for this hotel.</td></tr>}</tbody></table></div>
 <div class="oi-card-foot"><span>Showing @Model.Suppliers.Count supplier(s)</span><strong>Total suppliers: @Model.Suppliers.Count</strong></div>
</section>
<dialog id="oi-supplier-dialog" class="oi-dialog"><div class="oi-dialog-head"><div><h2 data-dialog-title>Add supplier</h2><p>Contact and business details.</p></div><button class="oi-btn icon" type="button" data-close-dialog aria-label="Close dialog">×</button></div>
<form method="post" action="/Inventory/supplier" class="oi-ajax-form" id="oi-supplier-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="0" />
<div class="oi-dialog-body"><h3>Business details</h3><div class="oi-fields cols2"><label>Business name *<input name="Business" required maxlength="250" /></label><label>Contact person *<input name="Name" required maxlength="150" /></label><label>Email<input type="email" name="Email" maxlength="200" /></label><label>Phone<input name="Phone" maxlength="60" /></label></div><h3>Address</h3><div class="oi-fields cols3"><label>Country<input name="Country" maxlength="100" /></label><label>City<input name="City" maxlength="100" /></label><label>Postal code<input name="Postal" maxlength="30" /></label><label class="span3">Street address<input name="Address" maxlength="500" /></label></div></div>
<div class="oi-dialog-foot"><button type="button" class="oi-btn" data-close-dialog>Cancel</button><button class="oi-btn" type="submit" data-save-another="true">Save & add another</button><button class="oi-btn primary" type="submit">✓ Save supplier</button></div></form></dialog>
