@model Orapmshms.Models.HotelInventory.InventoryPage
<section class="oi-card"><div class="oi-card-head"><div><h2>Movement history</h2><p>Every new inventory movement has a dated, printable audit record.</p></div><a class="oi-btn" href="/Inventory/export?kind=movements">Export CSV</a></div><div class="oi-card-toolbar"><input type="search" data-filter-table="oi-history" placeholder="Search movements..."/></div><div class="oi-table-scroll"><table id="oi-history"><thead><tr><th>DATE</th><th>TYPE</th><th>ITEM</th><th>QTY</th><th>FROM</th><th>TO</th><th>REFERENCE</th><th>USER</th><th>DOCUMENT</th></tr></thead><tbody>@foreach(var m in Model.Movements){<tr><td>@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@m.Type</td><td>@m.Item</td><td>@m.Qty</td><td>@m.From</td><td>@m.To</td><td>@m.Reference</td><td>@m.User</td><td><a href="/Inventory/voucher?type=movement&amp;id=@m.Id" class="oi-btn small" target="_blank" rel="noopener">View / Print</a></td></tr>}@if(Model.Movements.Count==0){<tr><td colspan="9" class="oi-empty">No new workflow movements yet.</td></tr>}</tbody></table></div></section>
<section class="oi-card"><div class="oi-card-head"><div><h2>Previous History</h2><p>Historical demand, purchase and issue records are available read-only.</p></div></div><div class="oi-card-toolbar"><input type="search" data-filter-table="oi-legacy-history" placeholder="Search old documents..." /></div><div class="oi-table-scroll"><table id="oi-legacy-history"><thead><tr><th>TYPE</th><th>NUMBER</th><th>SUMMARY</th><th>DATE</th><th>STATUS</th><th>DOCUMENT</th></tr></thead><tbody>@foreach(var d in Model.LegacyDocuments){<tr><td>@(d.Kind=="legacy-demand"?"Demand note":d.Kind=="legacy-purchase"?"Purchase / invoice":"Stock log")</td><td>@d.Number</td><td>@d.Summary</td><td>@d.DateText</td><td>@d.Status</td><td><a href="/Inventory/voucher?type=@d.Kind&amp;id=@d.Id" class="oi-btn small" target="_blank" rel="noopener">View / Print</a></td></tr>}@if(Model.LegacyDocuments.Count==0){<tr><td colspan="6" class="oi-empty">No older matching records for this hotel.</td></tr>}</tbody></table></div><div class="oi-card-foot">Historical receipts are reconstructed from recorded fields. They are not original signed vouchers.</div></section>
