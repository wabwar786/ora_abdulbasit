@model Orapmshms.Models.HotelInventory.InventoryPage
@{var loc=new[]{"Main Store","Dept:Kitchen","Dept:Housekeeping","Dept:Maintenance","Laundry"}.Concat(Model.Rooms.Select(r=>"Room:"+r.No)).Concat(Model.Departments).Distinct(StringComparer.OrdinalIgnoreCase);}
<div class="oi-notice info">Assets are individual items such as TVs, refrigerators and equipment. Assign a unique asset tag to each unit, then track its room, condition, repair and loss.</div>
<section class="oi-card"><div class="oi-card-head"><div><h2>Assets register</h2><p>Individually tagged equipment, current location and condition.</p></div><button class="oi-btn primary" type="button" data-open-dialog="oi-asset-new">+ Register asset</button></div><div class="oi-card-toolbar"><span class="oi-muted">@Model.Assets.Count registered assets</span><input type="search" data-filter-table="oi-assets" placeholder="Search asset tag..." /></div><div class="oi-table-scroll"><table id="oi-assets"><thead><tr><th>ASSET TAG</th><th>ITEM</th><th>SERIAL</th><th>LOCATION</th><th>CONDITION</th><th>ACTION</th></tr></thead><tbody>@foreach(var a in Model.Assets){<tr><td><strong>@a.Tag</strong></td><td>@a.ItemName</td><td>@a.Serial</td><td>@a.Location</td><td><span class="oi-badge @(a.Condition=="Good"?"green":"amber")">@a.Condition</span></td><td><button class="oi-btn small" type="button" data-open-dialog="oi-asset-action" data-asset-tag="@a.Tag">Update asset</button></td></tr>}@if(Model.Assets.Count==0){<tr><td colspan="6" class="oi-empty">No assets registered yet. Create an Asset-type item first.</td></tr>}</tbody></table></div></section>
<dialog id="oi-asset-new" class="oi-dialog"><div class="oi-dialog-head"><div><h2>Register tagged asset</h2><p>One physical unit per unique asset tag.</p></div><button type="button" data-close-dialog class="oi-btn icon">×</button></div><form class="oi-ajax-form" action="/Inventory/asset/tag" method="post">@Html.AntiForgeryToken()<div class="oi-dialog-body"><div class="oi-fields cols2"><label>Asset item *<select name="itemCode" required><option value="">Choose</option>@foreach(var i in Model.Items.Where(i=>i.Kind=="Asset")){<option value="@i.Code">@i.Name</option>}</select></label><label>Tag *<input name="tag" required maxlength="100" placeholder="TV-ROOM205-01" /></label><label>Serial number<input name="serial" maxlength="100" /></label><label>Location *<select name="location" required>@foreach(var v in loc){<option value="@v">@v</option>}</select></label></div></div><div class="oi-dialog-foot"><button type="button" data-close-dialog class="oi-btn">Cancel</button><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">Save asset</button></div></form></dialog>
<dialog id="oi-asset-action" class="oi-dialog"><div class="oi-dialog-head"><div><h2>Update asset</h2><p>Transfers, damage, repair and write-off.</p></div><button type="button" data-close-dialog class="oi-btn icon">×</button></div><form class="oi-ajax-form" action="/Inventory/asset/action" method="post">@Html.AntiForgeryToken()<div class="oi-dialog-body"><div class="oi-fields cols2"><label>Asset tag *<select name="tag" required>@foreach(var a in Model.Assets){<option value="@a.Tag">@a.Tag · @a.ItemName</option>}</select></label><label>Action<select name="action"><option value="Transfer">Transfer location</option><option value="Damage">Mark damaged</option><option value="Repair">Send for repair</option><option value="Recovered">Recovered from repair</option><option value="WriteOff">Write off</option></select></label><label>Destination<select name="destination">@foreach(var v in loc){<option value="@v">@v</option>}</select></label><label>Approved demand # (if issuing from Main Store)<input type="number" name="requestId" min="0" value="0" /></label><label class="span2">Reason / notes<input name="note" maxlength="500" /></label></div></div><div class="oi-dialog-foot"><button class="oi-btn" type="button" data-close-dialog>Cancel</button><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">Save asset action</button></div></form></dialog>
