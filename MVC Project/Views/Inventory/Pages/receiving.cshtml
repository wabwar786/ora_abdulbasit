@model Orapmshms.Models.HotelInventory.InventoryPage
@{var open=Model.Orders.Where(o=>o.Status=="Open").ToList();}
<div class="oi-notice info">Record only the quantity actually delivered. Partially received POs remain open. A direct Kitchen purchase updates Kitchen stock, not Main Store.</div>
<section class="oi-card"><div class="oi-card-head"><div><h2>Receive goods (GRN)</h2><p>Record delivery quantities and automatically update destination stock.</p></div><a href="/Inventory/Purchasing" class="oi-btn">Purchase orders</a></div>
<div class="oi-table-scroll"><table><thead><tr><th>PO</th><th>SUPPLIER</th><th>DESTINATION</th><th>OUTSTANDING</th><th>ACTION</th></tr></thead><tbody>@foreach(var o in open){<tr><td>PO-@o.Id</td><td>@o.Supplier</td><td>@o.Destination</td><td>@o.Lines.Sum(l=>l.Outstanding)</td><td><button class="oi-btn primary small" type="button" data-open-dialog="oi-grn-@o.Id">Receive delivery</button></td></tr>}@if(open.Count==0){<tr><td colspan="5" class="oi-empty">No purchase orders waiting for receipt.</td></tr>}</tbody></table></div></section>
<section class="oi-card"><div class="oi-card-head"><div><h2>Received orders</h2><p>View and print saved goods received notes.</p></div></div><div class="oi-table-scroll"><table><thead><tr><th>ORDER</th><th>SUPPLIER</th><th>RECEIVED</th><th>STATUS</th><th>DOCUMENTS</th></tr></thead><tbody>@foreach(var o in Model.Orders.Where(o=>o.Lines.Any(l=>l.Processed>0))){<tr><td>PO-@o.Id</td><td>@o.Supplier</td><td>@o.Lines.Sum(l=>l.Processed)</td><td>@o.Status</td><td class="oi-row-actions"><a href="/Inventory/voucher?type=grn&amp;id=@o.Id" target="_blank" rel="noopener" class="oi-btn small">View receipt</a><a href="/Inventory/voucher?type=grn&amp;id=@o.Id" target="_blank" rel="noopener" class="oi-btn small">Print GRN</a></td></tr>}@if(!Model.Orders.Any(o=>o.Lines.Any(l=>l.Processed>0))){<tr><td colspan="5" class="oi-empty">No received orders yet.</td></tr>}</tbody></table></div></section>
@foreach(var o in open){<dialog id="oi-grn-@o.Id" class="oi-dialog wide"><div class="oi-dialog-head"><div><h2>Receive PO-@o.Id</h2><p>@o.Supplier · @o.Destination</p></div><button type="button" class="oi-btn icon" data-close-dialog>×</button></div><form action="/Inventory/receive" method="post" class="oi-ajax-form">@Html.AntiForgeryToken()<input type="hidden" name="OrderId" value="@o.Id"/><div class="oi-dialog-body"><div class="oi-table-scroll"><table><thead><tr><th>ITEM</th><th>ORDERED</th><th>RECEIVED</th><th>RECEIVE NOW</th></tr></thead><tbody>@for(var i=0;i<o.Lines.Count;i++){var l=o.Lines[i];<tr><td>@l.ItemName</td><td>@l.Quantity</td><td>@l.Processed</td><td><input type="hidden" name="Lines[@i].OrderLineId" value="@l.Id"/><input type="number" name="Lines[@i].Quantity" min="0" max="@l.Outstanding" value="@l.Outstanding"/></td></tr>}</tbody></table></div></div><div class="oi-dialog-foot"><button type="button" data-close-dialog class="oi-btn">Cancel</button><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">Record goods received</button></div></form></dialog>}
