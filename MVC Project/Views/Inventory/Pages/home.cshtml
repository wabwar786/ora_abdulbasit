@model Orapmshms.Models.HotelInventory.InventoryPage
@{
 var low=Model.Items.Where(i=>i.ReorderAt>0&&i.StoreQty<=i.ReorderAt).ToList();
 var pending=Model.Requests.Where(r=>r.Status=="Pending").ToList();
}
<section class="oi-card">
 <div class="oi-card-head"><div><h2>Inventory overview</h2><p>Quick actions and important stock alerts.</p></div><div class="oi-toolbar"><a class="oi-btn" href="/Inventory/Receiving">Receive delivery</a><a class="oi-btn" href="/Inventory/Issue">Issue stock</a><a class="oi-btn primary" href="/Inventory/Requests">+ Request items</a></div></div>
 <div class="oi-stats"><div><span>ITEMS</span><strong>@Model.Items.Count</strong><small>Active item records</small></div><div><span>MAIN STORE UNITS</span><strong>@Model.Items.Sum(i=>i.StoreQty)</strong><small>StoreTB balances</small></div><div><span>PENDING APPROVALS</span><strong>@pending.Count</strong><small>Awaiting review</small></div><div><span>LOW STOCK ALERTS</span><strong>@low.Count</strong><small>At or below reorder</small></div></div>
 <div class="oi-card-toolbar"><div class="oi-tabs"><button class="oi-btn active" type="button" data-dashboard-tab="low">Low stock <span class="oi-count">@low.Count</span></button><button type="button" class="oi-btn" data-dashboard-tab="pending">Pending approvals <span class="oi-count">@pending.Count</span></button></div><div class="oi-toolbar"><input data-filter-table="oi-overview-low" placeholder="Search items..." aria-label="Search low stock" /><a class="oi-btn" href="/Inventory/Items">Manage items</a></div></div>
 <div data-dashboard-panel="low" class="oi-table-scroll"><table id="oi-overview-low"><thead><tr><th>SR #</th><th>ITEM</th><th>ITEM CODE</th><th>AVAILABLE</th><th>REORDER AT</th><th>SHORT BY</th><th>ACTION</th></tr></thead><tbody>@{var row=0;}@foreach(var i in low){row++;<tr><td>@row</td><td>@i.Name</td><td>@i.Code</td><td><span class="oi-danger-text">@i.StoreQty</span></td><td>@i.ReorderAt</td><td>@Math.Max(0,i.ReorderAt-i.StoreQty)</td><td><a class="oi-btn small" href="/Inventory/Requests">Request</a></td></tr>}@if(low.Count==0){<tr><td class="oi-empty" colspan="7">No low stock alerts.</td></tr>}</tbody></table></div>
 <div data-dashboard-panel="pending" class="oi-table-scroll" hidden><table><thead><tr><th>REQUEST</th><th>TYPE</th><th>DESTINATION</th><th>REQUESTED BY</th><th>ACTION</th></tr></thead><tbody>@foreach(var r in pending){<tr><td>DN-@r.Id</td><td>@r.Type</td><td>@r.Destination</td><td>@r.CreatedBy</td><td><a class="oi-btn small" href="/Inventory/Approvals">Review</a></td></tr>}@if(pending.Count==0){<tr><td class="oi-empty" colspan="5">No pending approvals.</td></tr>}</tbody></table></div>
 <div class="oi-card-foot"><span>FLOW: Request → Approve → Receive / Issue → Stock updated</span><strong>TOTAL LOW STOCK: @low.Count</strong></div>
</section>
