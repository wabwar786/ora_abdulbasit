@model Orapmshms.Models.HotelInventory.InventoryPage
@{var pending=Model.Requests.Where(x=>x.Status=="Pending").ToList();}
<section class="oi-card"><div class="oi-card-head"><div><h2>Pending approvals <span class="oi-badge amber">@pending.Count</span></h2><p>Review each demand before goods are purchased or stock is issued.</p></div></div>
<div class="oi-table-scroll"><table><thead><tr><th>DEMAND</th><th>REQUESTED BY</th><th>ITEMS & QUANTITY</th><th>DESTINATION</th><th>DATE</th><th>DECISION</th></tr></thead><tbody>@foreach(var r in pending){<tr><td><strong>DN-@r.Id</strong><small>@r.Type</small></td><td>@r.CreatedBy</td><td>@string.Join(", ",r.Lines.Select(l=>l.ItemName+" × "+l.Quantity))</td><td>@r.Destination</td><td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="oi-row-actions"><a class="oi-btn small" target="_blank" rel="noopener" href="/Inventory/voucher?type=demand&amp;id=@r.Id">View voucher</a><form class="oi-ajax-form oi-inline" action="/Inventory/review" method="post">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.Id"/><input type="hidden" name="decision" value="Approve"/><button class="oi-btn primary small" type="submit" disabled="@(!Model.WorkflowReady)">✓ Approve</button></form><button class="oi-btn small danger" type="button" data-open-dialog="oi-reject-dialog" data-reject-id="@r.Id">Reject</button></td></tr>}@if(pending.Count==0){<tr><td colspan="6" class="oi-empty">No requests waiting for approval.</td></tr>}</tbody></table></div></section>
<section class="oi-card"><div class="oi-card-head"><div><h2>Reviewed demands</h2><p>Completed and rejected requests remain available as printable documents.</p></div></div><div class="oi-table-scroll"><table><thead><tr><th>DEMAND</th><th>TYPE</th><th>STATUS</th><th>REVIEWED BY</th><th>DOCUMENT</th></tr></thead><tbody>@foreach(var r in Model.Requests.Where(r=>r.Status!="Pending")){<tr><td>DN-@r.Id</td><td>@r.Type</td><td><span class="oi-badge @(r.Status=="Rejected"?"red":"green")">@r.Status</span></td><td>@r.ReviewedBy</td><td><a href="/Inventory/voucher?type=demand&amp;id=@r.Id" target="_blank" rel="noopener" class="oi-btn small">View / Print</a></td></tr>}</tbody></table></div></section>
<dialog id="oi-reject-dialog" class="oi-dialog"><div class="oi-dialog-head"><div><h2>Reject demand note</h2><p>Provide a reason for the requester.</p></div><button type="button" data-close-dialog class="oi-btn icon">×</button></div><form action="/Inventory/review" method="post" class="oi-ajax-form">@Html.AntiForgeryToken()<input name="requestId" type="hidden" value=""/><input name="decision" type="hidden" value="Reject"/><div class="oi-dialog-body"><label class="oi-field">Reason for rejection *<textarea name="note" maxlength="500" rows="3" required placeholder="Explain why the request is rejected"></textarea></label></div><div class="oi-dialog-foot"><button class="oi-btn" data-close-dialog type="button">Cancel</button><button class="oi-btn danger" type="submit" disabled="@(!Model.WorkflowReady)">Confirm rejection</button></div></form></dialog>
