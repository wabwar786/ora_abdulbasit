@model Orapmshms.Models.HotelInventory.InventoryPage
@{var places=new[]{"Main Store","Dept:Kitchen","Dept:Housekeeping","Dept:Maintenance","Dept:Front Desk","Laundry"}.Concat(Model.Rooms.Select(r=>"Room:"+r.No)).Concat(Model.Departments).Concat(Model.Balances.Select(b=>b.Location)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();}
<div class="oi-notice info">Issuing from Main Store requires an approved request. Use <a href="/Inventory/Issue">Issue Stock</a>. This screen handles existing stock transfers, consumption, returns, laundry and condition changes.</div>
<section class="oi-card"><div class="oi-card-head"><div><h2>Record a stock movement</h2><p>Choose a source with available quantity, then select an action.</p></div></div>
<form action="/Inventory/movement" class="oi-ajax-form" method="post" id="oi-movement-form">@Html.AntiForgeryToken()<div class="oi-card-body"><div class="oi-fields cols3">
<label>What do you want to do?<select name="action" id="oi-movement-action"><option value="Transfer">Move between locations</option><option value="Return">Return to Main Store</option><option value="Use">Consume stock</option><option value="LaundryOut">Send reusable items to laundry</option><option value="LaundryBack">Receive items back from laundry</option><option value="Damage">Mark damaged</option><option value="Repair">Send for repair</option><option value="Recovered">Recovered from repair</option><option value="WriteOff">Write off damaged item</option></select></label>
<label>Item<select name="itemCode" id="oi-movement-item" required><option value="">Choose item</option>@foreach(var i in Model.Items.Where(i=>i.Kind!="Asset")){<option value="@i.Code">@i.Name (@i.Kind)</option>}</select></label>
<label>Where is the stock now?<select name="source" id="oi-movement-source" required><option value="">Choose an item first</option></select></label>
<label>Move to<select name="destination" id="oi-movement-destination"><option value="">Choose location</option>@foreach(var v in places){<option value="@v">@v</option>}</select></label>
<label>Quantity *<input name="quantity" id="oi-movement-qty" type="number" min="1" value="1" required /></label><label>Reason / notes<input name="note" placeholder="Optional except write-off" maxlength="500" /></label>
</div><p class="oi-muted" id="oi-available-text">Select an item to see available stock.</p></div><div class="oi-form-actions"><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">✓ Save stock movement</button></div></form>
</section>
<script type="application/json" id="oi-movement-balances">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Balances.Where(b=>b.Quantity>0).Select(b=>new {item=b.ItemCode,location=b.Location,condition=b.Condition,qty=b.Quantity})))</script>
<section class="oi-card"><div class="oi-card-head"><div><h2>Recent movements</h2><p>Every movement creates a ledger record.</p></div><a class="oi-btn" href="/Inventory/History">View history →</a></div><div class="oi-table-scroll"><table><thead><tr><th>DATE</th><th>ACTION</th><th>ITEM</th><th>QTY</th><th>FROM</th><th>TO</th><th>DOCUMENT</th></tr></thead><tbody>@foreach(var m in Model.Movements.Take(20)){<tr><td>@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@m.Type</td><td>@m.Item</td><td>@m.Qty</td><td>@m.From</td><td>@m.To</td><td><a class="oi-btn small" href="/Inventory/voucher?type=movement&amp;id=@m.Id" target="_blank" rel="noopener">View</a></td></tr>}</tbody></table></div></section>
