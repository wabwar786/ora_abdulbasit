@model Orapmshms.Models.HotelInventory.InventoryPage
<section class="oi-card" id="oi-report-workspace"><div class="oi-card-head"><div><h2>Inventory reports</h2><p>View saved report records inside ORA PMS before printing or exporting.</p></div></div><div class="oi-card-toolbar"><div class="oi-report-filters"><label>Report type<select id="oi-report-kind"><option value="stock">Inventory balances</option><option value="purchases">Purchases & goods received</option><option value="demands">Demand notes & approvals</option><option value="issues">Department-wise issuing</option><option value="department">Department stock</option><option value="assets">Asset register</option><option value="movements">Movement history</option></select></label><label>Search<input type="search" id="oi-report-search" placeholder="Item, supplier, location..." /></label><label>From<input type="date" id="oi-report-from" /></label><label>To<input type="date" id="oi-report-to" /></label></div><div class="oi-toolbar"><a id="oi-report-export" class="oi-btn" href="/Inventory/export?kind=stock">CSV</a><a id="oi-report-print" class="oi-btn primary" href="/Inventory/report/print?kind=stock" target="_blank" rel="noopener">Print report</a></div></div>
<div class="oi-card-toolbar"><strong id="oi-report-title">Inventory balances</strong><label>Rows<select id="oi-report-size"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label></div><div class="oi-table-scroll"><table id="oi-report-table"><thead><tr><th>Loading...</th></tr></thead><tbody><tr><td class="oi-empty">Loading report.</td></tr></tbody></table></div><div class="oi-card-foot"><span id="oi-report-range">Loading…</span><div class="oi-toolbar"><button id="oi-report-prev" type="button" class="oi-btn small" disabled>Previous</button><span id="oi-report-page">Page 1 of 1</span><button id="oi-report-next" class="oi-btn small" type="button" disabled>Next</button></div></div></section>
