@model Orapmshms.Models.HotelInventory.InventoryPage
<section class="oi-card"><div class="oi-card-head"><div><h2>Demand notes</h2><p>Create a purchase demand or request stock for a department.</p></div></div>
<div class="oi-card-toolbar"><span class="oi-muted">Pending: @Model.Requests.Count(x=>x.Status=="Pending") · Approved: @Model.Requests.Count(x=>x.Status=="Approved") · Completed: @Model.Requests.Count(x=>x.Status=="Completed")</span><div class="oi-toolbar"><input data-filter-table="oi-requests" type="search" placeholder="Search requests..."/><button class="oi-btn primary" type="button" data-open-dialog="oi-request-dialog">+ Create demand note</button></div></div>
<div class="oi-table-scroll"><table id="oi-requests"><thead><tr><th>DEMAND NO.</th><th>TYPE</th><th>ITEMS</th><th>DESTINATION</th><th>REQUESTED BY</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var r in Model.Requests){<tr><td><strong>DN-@r.Id</strong><small>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td><td>@(r.Type=="Purchase"?"Purchase":"Department issue")</td><td>@string.Join(", ",r.Lines.Select(l=>l.ItemName+" × "+l.Quantity))</td><td>@r.Destination</td><td>@r.CreatedBy</td><td><span class="oi-badge @(r.Status=="Completed"||r.Status=="Approved"?"green":r.Status=="Rejected"?"red":"amber")">@r.Status</span></td><td class="oi-row-actions"><a class="oi-btn small" href="/Inventory/voucher?type=demand&amp;id=@r.Id" target="_blank" rel="noopener">View</a><a class="oi-btn small" href="/Inventory/voucher?type=demand&amp;id=@r.Id" target="_blank" rel="noopener">Print</a></td></tr>}@if(Model.Requests.Count==0){<tr><td colspan="7" class="oi-empty">No demand notes yet. Create your first demand note above.</td></tr>}</tbody></table></div>
<div class="oi-card-foot"><span>Demand notes are printable before and after approval.</span><strong>@Model.Requests.Count demand notes</strong></div></section>
<div class="oi-notice info">Approvals are handled on the dedicated <a href="/Inventory/Approvals">Approvals</a> page.</div>
<dialog id="oi-request-dialog" class="oi-dialog wide"><div class="oi-dialog-head"><div><h2>Create demand note</h2><p>Request several items in one document.</p></div><button type="button" data-close-dialog class="oi-btn icon">×</button></div>
<form class="oi-ajax-form" id="oi-request-form" action="/Inventory/request" method="post">@Html.AntiForgeryToken()
<div class="oi-dialog-body"><div class="oi-fields cols2"><label>Demand type *<select name="Type" id="oi-request-type"><option value="Purchase">Purchase new stock</option><option value="Issue">Issue existing stock</option></select></label><label>Destination *<select name="Destination" id="oi-request-dest"><option value="Main Store">Main Store</option><option value="Dept:Kitchen">Kitchen — direct delivery</option><option value="Dept:Housekeeping">Housekeeping</option><option value="Dept:Maintenance">Maintenance</option><option value="Laundry">Laundry</option>@foreach(var r in Model.Rooms){<option value="Room:@r.No">Room @r.No</option>}</select></label></div>
<h3>Items</h3><div id="oi-request-lines"><div class="oi-request-line" data-line><label>Item<select name="Lines[0].ItemCode" required><option value="">Choose item</option>@foreach(var i in Model.Items){<option value="@i.Code">@i.Name (@i.Code) · @i.Unit</option>}</select></label><label>Quantity<input name="Lines[0].Quantity" type="number" min="1" value="1" required /></label><button type="button" class="oi-btn small" data-remove-line title="Remove row">×</button></div></div>
<button class="oi-btn" type="button" id="oi-add-request-line">+ Add another item</button><div class="oi-fields"><label>Reason / notes<textarea name="Note" rows="2" maxlength="500" placeholder="Optional explanation for approval"></textarea></label></div></div>
<div class="oi-dialog-foot"><button class="oi-btn" data-close-dialog type="button">Cancel</button><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">Send for approval</button></div></form></dialog>
