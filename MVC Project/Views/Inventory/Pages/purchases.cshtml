@model Orapmshms.Models.HotelInventory.InventoryPage
@{var available=Model.Requests.Where(r=>r.Type=="Purchase"&&r.Status=="Approved"&&!Model.Orders.Any(o=>o.RequestId==r.Id)).ToList();}
<div class="oi-notice info">For direct Kitchen purchases, create a purchase demand with destination <strong>Kitchen — direct delivery</strong>. The GRN updates Kitchen stock without increasing Main Store stock.</div>
<section class="oi-card"><div class="oi-card-head"><div><h2>Approved purchase demands</h2><p>Create a supplier purchase order from an approved demand note.</p></div><a href="/Inventory/Requests" class="oi-btn">View requests</a></div>
<div class="oi-table-scroll"><table><thead><tr><th>DEMAND</th><th>ITEMS</th><th>DELIVERY LOCATION</th><th>DATE</th><th>ACTION</th></tr></thead><tbody>
@foreach(var r in available){<tr><td><strong>DN-@r.Id</strong></td><td>@string.Join(", ",r.Lines.Select(l=>l.ItemName+" × "+l.Quantity))</td><td>@r.Destination</td><td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><button class="oi-btn primary small" type="button" data-open-dialog="oi-po-@r.Id">+ Create PO</button></td></tr>}
@if(available.Count==0){<tr><td class="oi-empty" colspan="5">No approved purchase requests waiting for an order. <a href="/Inventory/Requests">Create a request →</a></td></tr>}</tbody></table></div></section>
<section class="oi-card"><div class="oi-card-head"><div><h2>Purchase order register</h2><p>View, print and track receiving against each order.</p></div><a href="/Inventory/Receiving" class="oi-btn">Receive Stock →</a></div>
<div class="oi-card-toolbar"><span class="oi-muted">@Model.Orders.Count purchase orders</span><input type="search" data-filter-table="oi-orders" placeholder="Search orders..."/></div>
<div class="oi-table-scroll"><table id="oi-orders"><thead><tr><th>PO</th><th>SUPPLIER</th><th>RECEIVE AT</th><th>STATUS</th><th>PROGRESS</th><th>DOCUMENTS</th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td><strong>PO-@o.Id</strong></td><td>@o.Supplier</td><td>@o.Destination</td><td><span class="oi-badge @(o.Status=="Received"?"green":"amber")">@o.Status</span></td><td>@o.Lines.Sum(l=>l.Processed)/@o.Lines.Sum(l=>l.Quantity)</td><td class="oi-row-actions"><a href="/Inventory/voucher?type=po&amp;id=@o.Id" class="oi-btn small" target="_blank" rel="noopener">View PO</a><a href="/Inventory/voucher?type=po&amp;id=@o.Id" class="oi-btn small" target="_blank" rel="noopener">Print</a>@if(o.Lines.Any(l=>l.Processed>0)){<a class="oi-btn small" href="/Inventory/voucher?type=grn&amp;id=@o.Id" target="_blank" rel="noopener">GRN</a>}</td></tr>}@if(Model.Orders.Count==0){<tr><td colspan="6" class="oi-empty">No purchase orders yet.</td></tr>}</tbody></table></div></section>
@foreach(var r in available){<dialog id="oi-po-@r.Id" class="oi-dialog wide"><div class="oi-dialog-head"><div><h2>Create PO for DN-@r.Id</h2><p>Delivery destination: @r.Destination</p></div><button type="button" data-close-dialog class="oi-btn icon">×</button></div><form method="post" action="/Inventory/order" class="oi-ajax-form">@Html.AntiForgeryToken()<input type="hidden" name="RequestId" value="@r.Id"/><div class="oi-dialog-body"><div class="oi-fields cols2"><label>Supplier *<select name="Supplier" required><option value="">Choose supplier</option>@foreach(var s in Model.Suppliers){<option value="@s.Business">@s.Business</option>}</select></label><div class="oi-notice info">For a new supplier, first open the Suppliers page and save its details.</div></div><div class="oi-table-scroll"><table><thead><tr><th>ITEM</th><th>QUANTITY</th><th>UNIT COST</th></tr></thead><tbody>@for(var i=0;i<r.Lines.Count;i++){var line=r.Lines[i];var itm=Model.Items.FirstOrDefault(a=>a.Code==line.ItemCode);<tr><td>@line.ItemName<input type="hidden" name="Lines[@i].RequestLineId" value="@line.Id" /></td><td>@line.Quantity</td><td><input name="Lines[@i].UnitCost" type="number" min="0" step="0.01" value="@((itm?.Price??0).ToString("0.00",System.Globalization.CultureInfo.InvariantCulture))" required /></td></tr>}</tbody></table></div></div><div class="oi-dialog-foot"><button type="button" data-close-dialog class="oi-btn">Cancel</button><button class="oi-btn primary" type="submit" disabled="@(!Model.WorkflowReady)">Create purchase order</button></div></form></dialog>}
