@model Orapmshms.Models.HotelInventory.InventoryPage
<section class="oi-card"><div class="oi-card-head"><div><h2>Stock balances</h2><p>Main Store, room, departmental and condition-based inventory.</p></div><a class="oi-btn" href="/Inventory/Reports">Reports</a></div>
<div class="oi-card-toolbar"><span class="oi-muted">@Model.Balances.Count balance entries</span><div class="oi-toolbar"><input type="search" data-filter-table="oi-balances" placeholder="Search item / location..."/><a href="/Inventory/export?kind=stock" class="oi-btn">Export CSV</a><button class="oi-btn" data-print-table="oi-balances" data-print-title="Stock Balances" type="button">Print</button></div></div>
<div class="oi-table-scroll"><table id="oi-balances"><thead><tr><th>LOCATION</th><th>ITEM CODE</th><th>ITEM</th><th>TYPE</th><th>CONDITION</th><th>AVAILABLE</th></tr></thead><tbody>@foreach(var b in Model.Balances.Where(b=>b.Quantity!=0).OrderBy(b=>b.Location).ThenBy(b=>b.Item)){<tr><td>@b.Location</td><td>@b.ItemCode</td><td>@b.Item</td><td>@b.Kind</td><td><span class="oi-badge @(b.Condition=="Good"?"green":"amber")">@b.Condition</span></td><td>@b.Quantity</td></tr>}@if(!Model.Balances.Any(b=>b.Quantity!=0)){<tr><td colspan="6" class="oi-empty">No recorded stock balances.</td></tr>}</tbody></table></div></section>
