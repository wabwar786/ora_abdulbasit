@model Orapmshms.Models.FbrFailedInvoiceReportViewModel
@{
    ViewData["Title"] = "FBR Invoice Report";
    string D(DateTime? date) => date?.ToString("yyyy-MM-dd") ?? "";
}
<link rel="stylesheet" href="~/css/fbr-report-mvc.css" asp-append-version="true" />
<main class="fbr-rpt" id="fbrReportApp"
      data-index-url="@Url.Action("Index", "FbrFailedInvoiceReport")"
      data-results-url="@Url.Action("Results", "FbrFailedInvoiceReport")"
      data-export-url="@Url.Action("Export", "FbrFailedInvoiceReport")"
      data-details-url="@Url.Action("RetryDetails", "FbrFailedInvoiceReport")"
      data-retry-url="@Url.Action("Retry", "FbrFailedInvoiceReport")">
    <div class="rpt-wrap">
        <header class="rpt-top">
            <div>
                <div class="eyebrow">FISCAL REPORTS</div>
                <h1>FBR Invoice Report</h1>
            </div>
            <div class="rpt-top-actions">
                <a id="fbrExport" class="rpt-btn" asp-controller="FbrFailedInvoiceReport" asp-action="Export"
                   asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                   asp-route-from="@D(Model.From)" asp-route-to="@D(Model.To)">Export CSV</a>
                <button class="rpt-btn" type="button" id="fbrRefresh">Refresh</button>
            </div>
        </header>
        <div id="fbrFlash" class="fbr-flash" role="status" aria-live="polite" hidden></div>
        @if (ViewBag.Error != null) { <div class="fbr-flash is-error" role="alert">@ViewBag.Error</div> }
        <section class="panel fbr-filter-panel">
            <form method="get" asp-controller="FbrFailedInvoiceReport" asp-action="Index" id="fbrFilters" class="filters">
                <div class="field search"><label for="fbrSearch">Search</label>
                    <input id="fbrSearch" class="filter-input" type="search" name="search" maxlength="120" placeholder="Guest, reservation or phone" value="@Model.Search" autocomplete="off" />
                </div>
                <div class="field"><label for="fbrStatus">Status</label><select id="fbrStatus" class="filter-input" name="status">
                    <option value="ALL" selected="@(Model.Status == "ALL" ? "selected" : null)">All</option>
                    <option value="FAILED" selected="@(Model.Status == "FAILED" ? "selected" : null)">Failed</option>
                    <option value="POSTED" selected="@(Model.Status == "POSTED" ? "selected" : null)">Posted</option>
                </select></div>
                <div class="field"><label for="fbrFrom">From</label><input id="fbrFrom" class="filter-input" type="date" name="from" value="@D(Model.From)" /></div>
                <div class="field"><label for="fbrTo">To</label><input id="fbrTo" class="filter-input" type="date" name="to" value="@D(Model.To)" /></div>
                <div class="filter-actions"><button class="rpt-btn primary" type="submit">Search</button><a class="rpt-btn" href="@Url.Action("Index","FbrFailedInvoiceReport")" id="fbrReset">Reset</a></div>
            </form>
        </section>
        <div id="fbrReportResults" aria-live="polite" aria-busy="false">
            @await Html.PartialAsync("~/Views/FbrFailedInvoiceReport/_Results.cshtml", Model)
        </div>
    </div>
</main>
<form id="fbrRetryAntiforgery" hidden>@Html.AntiForgeryToken()</form>
<div class="fbr-modal-backdrop" id="fbrRetryModal" role="dialog" aria-modal="true" aria-labelledby="fbrRetryTitle">
    <div class="fbr-modal">
        <div class="fbr-modal-head"><div><h3 id="fbrRetryTitle">Retry fiscal invoice</h3></div><button class="x" type="button" data-close-retry aria-label="Close">×</button></div>
        <div class="fbr-modal-body">
            <div class="fbr-modal-info"><div><span>Guest</span><strong id="fbrGuest">—</strong></div><div><span>Reservation</span><strong id="fbrReg">—</strong></div></div>
            <div class="modal-field"><span class="field-label">Payment method</span><strong id="fbrMethod">—</strong></div>
            <div class="modal-field"><label class="field-label" for="fbrAuthority">Fiscal authority</label><select id="fbrAuthority" class="filter-input"></select></div>
            <div class="fbr-modal-warning">Check the fiscal portal before retrying: a timed-out invoice may already be posted.</div>
            <label class="fbr-reconcile" id="fbrReconcileRow" hidden><input id="fbrReconcileConfirmed" type="checkbox" /><span>I verified the fiscal portal and no invoice was accepted for this reservation.</span></label>
            <div id="fbrPriorAttempt" class="fbr-prior-attempt" hidden></div>
            <div id="fbrRetryError" class="fbr-modal-error" role="alert" hidden></div>
        </div>
        <div class="fbr-modal-footer"><button type="button" class="rpt-btn" data-close-retry>Close</button><button type="button" class="rpt-btn primary" id="fbrSendRetry" disabled>Confirm &amp; Retry</button></div>
    </div>
</div>
<script src="~/js/fbr-report-mvc.js" asp-append-version="true" defer></script>
