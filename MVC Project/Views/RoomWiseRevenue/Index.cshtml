@model Orapmshms.Models.RoomWiseRevenueViewModel
@using System.Linq
@{
    ViewData["Title"] = "Room-wise Revenue Report";
    Layout = "~/Views/Shared/_PmsLayout.cshtml";
}
<link rel="stylesheet" href="~/css/room-wise-revenue.css" asp-append-version="true" />
<main class="rwr-root" id="rwrReport">
    <header class="rwr-header">
        <div>
            <div class="rwr-eyebrow">REPORTS / REVENUE</div>
            <h1>Room-wise Revenue Report</h1>
            <p>Room revenue by occupied night; Extras and F&amp;B on their actual posting dates.</p>
        </div>
        <div class="rwr-actions">
            <a class="rwr-button rwr-button-light" asp-controller="RoomWiseRevenue" asp-action="Export"
               asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
               asp-route-search="@Model.Search" asp-route-source="@Model.Source">Export CSV</a>
            <a class="rwr-button rwr-button-light" asp-controller="RoomWiseRevenue" asp-action="Print"
               asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
               asp-route-search="@Model.Search" asp-route-source="@Model.Source"
               target="_blank" rel="noopener">Print Report</a>
        </div>
    </header>

    <section class="rwr-panel">
        <form asp-controller="RoomWiseRevenue" asp-action="Index" method="get" class="rwr-filters">
            <label>From date
                <input type="date" name="from" required value="@Model.From.ToString("yyyy-MM-dd")" />
            </label>
            <label>To date
                <input type="date" name="to" required value="@Model.To.ToString("yyyy-MM-dd")" />
            </label>
            <label>Reservation Source
                <select name="source" class="rwr-source">
                    <option value="">All Sources</option>
                    @foreach (var source in Model.Sources)
                    {
                        if (string.Equals(source, Model.Source, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@source" selected="selected">@source</option>
                        }
                        else
                        {
                            <option value="@source">@source</option>
                        }
                    }
                </select>
            </label>
            <label class="rwr-search">Room / Guest / Reservation
                <input name="search" value="@Model.Search" maxlength="100"
                       placeholder="Search any room, guest or reservation" />
            </label>
            <button class="rwr-button rwr-button-primary" type="submit">Generate</button>
            <a class="rwr-button rwr-button-light" asp-controller="RoomWiseRevenue" asp-action="Index">Reset</a>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="rwr-error" role="alert">@Model.Error</div>
    }
    else
    {
        <div class="rwr-report-context">
            <strong>@Model.HotelName</strong>
            <span>@Model.From.ToString("dd MMM yyyy") – @Model.To.ToString("dd MMM yyyy")</span>
            <span>Source: @(string.IsNullOrWhiteSpace(Model.Source) ? "All" : Model.Source)</span>
            <span>Room charges by occupied night · Extras and F&amp;B by payments.currentdate</span>
        </div>
        <section class="rwr-panel rwr-results">
            <div class="rwr-table-top">
                <div>
                    <h2>Room Revenue Details</h2>
                    <span>@Model.Rows.Count dated revenue rows · @Model.Reservations reservations</span>
                </div>
                <span class="rwr-saved-tax">Tax is from saved payments only · F&amp;B is reported separately</span>
            </div>
            <div class="rwr-table-scroll">
                <table class="rwr-table rwr-revenue-table">
                    <thead>
                        <tr>
                            <th class="rwr-sr">Sr#</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Room No.</th>
                            <th>Source</th>
                            <th class="rwr-number rwr-col-room">Room Revenue</th>
                            <th class="rwr-number rwr-col-room">Room VAT/GST</th>
                            <th class="rwr-number rwr-col-extra">Extras</th>
                            <th class="rwr-number rwr-col-extra">Extras VAT/GST</th>
                            <th class="rwr-number rwr-col-fnb">F&amp;B</th>
                            <th class="rwr-number rwr-col-fnb">F&amp;B Tax/VAT</th>
                            <th class="rwr-number">Gross Revenue</th>
                            <th class="rwr-number">Net Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr><td class="rwr-empty" colspan="13">No room or posted extras revenue for the selected dates.</td></tr>
                        }
                        else
                        {
                            var sr = 0;
                            foreach (var r in Model.Rows)
                            {
                                <tr class="@(r.RoomNights == 0 && (r.ExtraRevenue != 0 || r.FnbRevenue != 0) ? "rwr-extra-only" : "")">
                                    <td class="rwr-sr">@(++sr)</td>
                                    <td class="rwr-date">@r.RevenueDate.ToString("dd MMM yyyy")</td>
                                    <td class="rwr-description">
                                        <a class="rwr-invoice-link rwr-guest-link"
                                           asp-controller="RoomWiseRevenue" asp-action="Invoice"
                                           asp-route-regId="@r.ReservationNo"
                                           target="_blank" rel="noopener noreferrer"
                                           title="Open invoice for reservation @r.ReservationNo">@(string.IsNullOrWhiteSpace(r.GuestName) ? r.ReservationNo : r.GuestName)</a>
                                        <span class="rwr-description-dates">@r.StayDates</span>
                                    </td>
                                    <td class="rwr-room">@r.RoomNo</td>
                                    <td class="rwr-source-name">@r.SourceName</td>
                                    <td class="rwr-number rwr-col-room">@Model.Format(r.RoomRevenue)</td>
                                    <td class="rwr-number rwr-col-room">@Model.Format(r.RoomVat)</td>
                                    <td class="rwr-number rwr-col-extra">@Model.Format(r.ExtraRevenue)</td>
                                    <td class="rwr-number rwr-col-extra">@Model.Format(r.ExtraVat)</td>
                                    <td class="rwr-number rwr-col-fnb">@Model.Format(r.FnbRevenue)</td>
                                    <td class="rwr-number rwr-col-fnb">@Model.Format(r.FnbVat)</td>
                                    <td class="rwr-number">@Model.Format(r.GrossRevenue)</td>
                                    <td class="rwr-number">@Model.Format(r.NetRevenue)</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.Rows.Count > 0)
                    {
                        <tfoot>
                            <tr>
                                <td colspan="5">Grand Total</td>
                                <td class="rwr-number rwr-col-room">@Model.Format(Model.RoomRevenue)</td>
                                <td class="rwr-number rwr-col-room">@Model.Format(Model.RoomVat)</td>
                                <td class="rwr-number rwr-col-extra">@Model.Format(Model.ExtraRevenue)</td>
                                <td class="rwr-number rwr-col-extra">@Model.Format(Model.ExtraVat)</td>
                                <td class="rwr-number rwr-col-fnb">@Model.Format(Model.FnbRevenue)</td>
                                <td class="rwr-number rwr-col-fnb">@Model.Format(Model.FnbVat)</td>
                                <td class="rwr-number">@Model.Format(Model.GrossRevenue)</td>
                                <td class="rwr-number">@Model.Format(Model.NetRevenue)</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </section>
    }
</main>
<script src="~/js/room-wise-revenue.js" asp-append-version="true"></script>
