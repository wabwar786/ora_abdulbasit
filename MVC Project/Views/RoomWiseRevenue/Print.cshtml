@model Orapmshms.Models.RoomWiseRevenueViewModel
@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "Print Room-wise Revenue Report";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Room-wise Revenue - @Model.HotelName</title>
    <style>
        * { box-sizing:border-box; }
        body { margin:0; padding:14px; font:12px Arial,Helvetica,sans-serif; color:#213146; }
        .toolbar { display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px; }
        .toolbar button { border:0;border-radius:5px;background:#173e6c;color:#fff;padding:7px 12px;cursor:pointer; }
        .toolbar button:last-child { background:#e9eef6;color:#173e6c; }
        .header { display:flex;justify-content:space-between;align-items:flex-end;gap:10px;
                  border-bottom:1.5px solid #173e6c;padding-bottom:7px;margin-bottom:9px; }
        h1 { font-size:20px;margin:0 0 5px; }
        .muted { color:#64758a;font-size:10.5px; }
        .period { text-align:right;line-height:1.45;font-size:11px; }
        table { border-collapse:collapse;width:100%;table-layout:fixed; }
        th,td { border:1px solid #dce4ee;padding:5px 4px;vertical-align:middle;overflow-wrap:break-word; }
        th { background:#eaf1f8;color:#294465;font-size:10.4px;font-weight:700;line-height:1.25; }
        td { font-size:11.8px;line-height:1.3; }
        .money { text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;letter-spacing:-.1px; }
        .date { white-space:nowrap; }
        .guest { font-weight:600;line-height:1.3; }
        .stay { display:block;font-size:10px;font-weight:400;color:#64758a;margin-top:2px;white-space:normal; }
        .room-revenue { background:#eef5ff; }
        .extra-revenue { background:#fff5e6; }
        .fnb-revenue { background:#e9f7ef; }
        tfoot td { background:#e8f0f9;font-weight:700; }
        h2 { font-size:14px;margin:15px 0 7px; }
        .note { margin-top:10px;font-size:10px;color:#5b6e80;line-height:1.45; }
        .warning { margin-top:12px;border:1px solid #ddc89c;padding:8px;background:#fffaf0;font-size:11px; }
        thead { display:table-header-group; }
        tfoot { display:table-row-group; }
        tr { break-inside:avoid;page-break-inside:avoid; }
        @@page { size:A3 landscape;margin:7mm; }
        @@media print {
            body { padding:0; font-size:12px; }
            .toolbar { display:none; }
            th { font-size:10.4px; }
            td { font-size:11.8px; }
            .stay { font-size:10px; }
            th,td { -webkit-print-color-adjust:exact;print-color-adjust:exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Print</button>
        <button type="button" onclick="window.close()">Close</button>
    </div>
    <header class="header">
        <div><h1>Room-wise Revenue Report</h1><div class="muted">@Model.HotelName</div></div>
        <div class="period">
            <div><strong>@Model.From.ToString("dd MMM yyyy") – @Model.To.ToString("dd MMM yyyy")</strong></div>
            <div>Source: @(string.IsNullOrWhiteSpace(Model.Source) ? "All Sources" : Model.Source)</div>
            <div class="muted">Room revenue: occupied nights · Extras/F&amp;B: actual posting dates</div>
        </div>
    </header>
    <table>
        <colgroup>
            <col style="width:2.3%" /><col style="width:6.1%" /><col style="width:15.5%" />
            <col style="width:4.1%" /><col style="width:7%" />
            <col style="width:8%" /><col style="width:8%" />
            <col style="width:7.5%" /><col style="width:7.5%" />
            <col style="width:7.5%" /><col style="width:7.5%" />
            <col style="width:9.5%" /><col style="width:9.5%" />
        </colgroup>
        <thead>
            <tr><th>Sr#</th><th>Date</th><th>Description</th><th>Room No.</th><th>Source</th>
                <th class="money room-revenue">Room Revenue</th><th class="money room-revenue">Room VAT/GST</th>
                <th class="money extra-revenue">Extras</th><th class="money extra-revenue">Extras VAT/GST</th>
                <th class="money fnb-revenue">F&amp;B</th><th class="money fnb-revenue">F&amp;B Tax/VAT</th>
                <th class="money">Gross Revenue</th><th class="money">Net Revenue</th></tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="13" style="text-align:center;">No room or posted extra revenue for this period.</td></tr>
            }
            else
            {
                var serial = 0;
                foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@(++serial)</td>
                        <td class="date">@r.RevenueDate.ToString("dd MMM yyyy")</td>
                        <td><span class="guest">@(string.IsNullOrWhiteSpace(r.GuestName) ? r.ReservationNo : r.GuestName)</span>
                            <span class="stay">@r.StayDates</span></td>
                        <td>@r.RoomNo</td><td>@r.SourceName</td>
                        <td class="money room-revenue">@Model.Format(r.RoomRevenue)</td>
                        <td class="money room-revenue">@Model.Format(r.RoomVat)</td>
                        <td class="money extra-revenue">@Model.Format(r.ExtraRevenue)</td>
                        <td class="money extra-revenue">@Model.Format(r.ExtraVat)</td>
                        <td class="money fnb-revenue">@Model.Format(r.FnbRevenue)</td>
                        <td class="money fnb-revenue">@Model.Format(r.FnbVat)</td>
                        <td class="money">@Model.Format(r.GrossRevenue)</td>
                        <td class="money">@Model.Format(r.NetRevenue)</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr><td colspan="5">Grand Total</td>
                <td class="money room-revenue">@Model.Format(Model.RoomRevenue)</td>
                <td class="money room-revenue">@Model.Format(Model.RoomVat)</td>
                <td class="money extra-revenue">@Model.Format(Model.ExtraRevenue)</td>
                <td class="money extra-revenue">@Model.Format(Model.ExtraVat)</td>
                <td class="money fnb-revenue">@Model.Format(Model.FnbRevenue)</td>
                <td class="money fnb-revenue">@Model.Format(Model.FnbVat)</td>
                <td class="money">@Model.Format(Model.GrossRevenue)</td>
                <td class="money">@Model.Format(Model.NetRevenue)</td></tr>
        </tfoot>
    </table>
    <script>window.addEventListener('load', function () { window.print(); });</script>
</body>
</html>
