@using Orapmshms.Services
@inject IPmsMasterService PmsMasterService
@{
    var master = await PmsMasterService.GetOrBuildAsync(Context, Context.RequestAborted);
    var currentUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    var pageTitle = ViewData["Title"]?.ToString();
    if (string.IsNullOrWhiteSpace(pageTitle)) pageTitle = "ORAPMS";
    var toastMessage = TempData["PmsMasterMessage"]?.ToString() ?? string.Empty;
    var toastType = TempData["PmsMasterMessageType"]?.ToString() ?? "info";
    var openChangePassword = string.Equals(TempData["PmsOpenChangePassword"]?.ToString(), "1", StringComparison.Ordinal);
    var trimmedUserName = (master.UserName ?? string.Empty).Trim();
    var profileInitial = trimmedUserName.Length == 0 ? "U" : char.ToUpperInvariant(trimmedUserName[0]).ToString();

    string NavIcon(string pageName)
    {
        var compact = new string((pageName ?? string.Empty).Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (compact.Contains("dashboard")) return "fa-table-cells-large";
        if (compact.Contains("calendar") || compact.Contains("calender")) return "fa-calendar-days";
        if (compact.Contains("reservation")) return "fa-calendar-plus";
        if (compact.Contains("availability") || compact.Contains("availibilty")) return "fa-chart-column";
        if (compact.Contains("room")) return "fa-bed";
        if (compact.Contains("payment") || compact.Contains("account")) return "fa-wallet";
        if (compact.Contains("house")) return "fa-broom-ball";
        if (compact.Contains("report")) return "fa-chart-line";
        if (compact.Contains("guest") || compact.Contains("customer")) return "fa-users";
        if (compact.Contains("setting")) return "fa-gear";
        return "fa-arrow-up-right-from-square";
    }

    string CategoryIcon(string category)
    {
        var value = (category ?? string.Empty).ToLowerInvariant();
        if (value.Contains("front") || value.Contains("operation")) return "fa-table-cells-large";
        if (value.Contains("room")) return "fa-bed";
        if (value.Contains("account") || value.Contains("commercial")) return "fa-wallet";
        if (value.Contains("channel")) return "fa-building";
        if (value.Contains("guest") || value.Contains("crm")) return "fa-users";
        if (value.Contains("report")) return "fa-chart-line";
        if (value.Contains("setting")) return "fa-gear";
        return "fa-layer-group";
    }

    string SectionName(string category)
    {
        var value = (category ?? string.Empty).ToLowerInvariant();
        if (value.Contains("front") || value.Contains("room") || value.Contains("operation")) return "Operations";
        if (value.Contains("account") || value.Contains("channel") || value.Contains("commercial")) return "Commercial";
        return "Management";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - ORA PMS</title>
    <meta name="description" content="ORA PMS hotel management system." />
    <link rel="icon" type="image/png" href="~/img/smartPMS-01.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pms-master.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="pms-master-body"
      data-open-change-password="@(openChangePassword ? "1" : "0")">

    <aside id="sidebar" class="pms-master-sidebar">
        <div class="pms-sidebar-brand">
            <div class="pms-brand-logo">O</div>
            <div class="pms-brand-text"><strong>ORA PMS</strong><span>Hotel Management System</span></div>
            <button type="button" id="pmsDesktopNavToggle" class="pms-master-toggle" onclick="pmsToggleNav(); return false;" aria-label="Collapse navigation" aria-expanded="true">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </div>

        <div class="pms-sidebar-scroll">
            @{ string lastSection = string.Empty; }
            @foreach (var category in master.LeftNavigation)
            {
                var navSection = SectionName(category.Name);
                if (!navSection.Equals(lastSection, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="pms-nav-section">@navSection</div>
                    lastSection = navSection;
                }

                <a href="#" class="pms-category-link" aria-label="@category.Name" onclick="pmsToggleMenu(this); return false;">
                    <i class="pms-cat-ico fa-solid @CategoryIcon(category.Name)"></i>
                    <span class="pms-cat-text">@category.Name</span>
                    <span class="pms-cat-arrow"><i class="fa-solid fa-chevron-right"></i></span>
                </a>
                <div class="pms-submenu">
                    @foreach (var item in category.Items)
                    {
                        <a class="pms-sidebar-menu-link"
                           data-page="@item.PageName"
                           href="@item.Url"
                           onclick="pmsSetSelectedSidebar(this)"
                           target="@(item.OpenInNewTab ? "_blank" : null)"
                           rel="@(item.OpenInNewTab ? "noopener" : null)">
                            <i class="pms-menu-ico fa-regular fa-circle-dot"></i>
                            <span class="pms-menu-text">@item.Menu</span>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="pms-sidebar-credits">Powered by<br /><a href="https://techgeni.co.uk" target="_blank" rel="noopener">Tech Geni Ltd.</a></div>
    </aside>
    <button type="button" id="pmsSidebarBackdrop" class="pms-sidebar-backdrop" onclick="pmsCloseMobileNav(); return false;" aria-label="Close navigation" tabindex="-1"></button>

    <header id="header" class="pms-master-header">
        <div class="pms-header-row">
            <div class="pms-quick-wrap">
                <button type="button" id="pmsMobileNavToggle" class="pms-mobile-nav-toggle" onclick="pmsToggleNav(); return false;" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="pms-topbar" id="topbar">
                    <button type="button" id="pmsTopbarPrev" class="pms-scroll-button" onclick="pmsScrollTopbar('left'); return false;" aria-label="Previous menu items" hidden>
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="pms-topbar-scroll">
                        <ul class="pms-topbar-list" id="pmsTopbarList">
                            @foreach (var item in master.TopNavigation)
                            {
                                <li>
                                    <a class="pms-topbar-link"
                                       href="@item.Url"
                                       data-page="@item.PageName"
                                       target="@(item.OpenInNewTab ? "_blank" : null)"
                                       rel="@(item.OpenInNewTab ? "noopener" : null)">
                                        <i class="fa-solid @NavIcon(item.PageName)"></i>
                                        <span>@item.Menu</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <button type="button" id="pmsTopbarNext" class="pms-scroll-button" onclick="pmsScrollTopbar('right'); return false;" aria-label="More menu items" hidden>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="pms-top-actions">
                <a class="pms-top-btn pms-help" href="@master.HelpUrl" target="_blank" rel="noopener" title="Help" aria-label="Help"><i class="fa-regular fa-circle-question"></i></a>

                @if (master.Properties.Count > 0)
                {
                    <form class="pms-property-form" asp-controller="PmsMaster" asp-action="ChangeProperty" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <select name="hotelId" class="pms-property-select" onchange="this.form.submit()" aria-label="Property">
                            @foreach (var property in master.Properties)
                            {
                                if (property.Selected) { <option value="@property.HotelId" selected>@property.Name</option> }
                                else { <option value="@property.HotelId">@property.Name</option> }
                            }
                        </select>
                    </form>
                }

                <div class="pms-profile-wrap">
                    <button type="button" id="pmsProfileButton" class="pms-profile-button pms-profile-button-compact" onclick="pmsToggleProfile(); return false;" aria-label="Profile">
                        <span class="pms-avatar">@profileInitial</span>
                    </button>

                    <div id="pmsProfilePopup" class="pms-profile-popup">
                        <div class="pms-profile-popup-inner">
                            <div class="pms-profile-head">
                                <span class="pms-profile-avatar">@profileInitial</span>
                                <div class="pms-profile-meta"><div class="pms-profile-name">@master.UserName</div><div class="pms-profile-sub">@master.Role · ORA PMS</div></div>
                                <button type="button" class="pms-popup-x" onclick="pmsToggleProfile(); return false;">×</button>
                            </div>
                            <div class="pms-profile-actions">
                                <div class="pms-mobile-top-links">
                                    @foreach (var item in master.TopNavigation)
                                    {
                                        <a class="pms-profile-link" href="@item.Url" target="@(item.OpenInNewTab ? "_blank" : null)" rel="@(item.OpenInNewTab ? "noopener" : null)">
                                            <span class="pms-plink-ico"><i class="fa-solid @NavIcon(item.PageName)"></i></span><span class="pms-plink-text">@item.Menu</span><span class="pms-plink-arrow">›</span>
                                        </a>
                                    }
                                </div>
                                <button type="button" class="pms-profile-link" onclick="pmsOpenChangePassword(); return false;">
                                    <span class="pms-plink-ico"><i class="fa-solid fa-lock"></i></span><span class="pms-plink-text">Change password</span><span class="pms-plink-arrow">›</span>
                                </button>
                                <form asp-controller="LoginHMS" asp-action="Logout" method="post" class="pms-logout-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="pms-profile-link danger"><span class="pms-plink-ico"><i class="fa-solid fa-arrow-right-from-bracket"></i></span><span class="pms-plink-text">Sign out</span><span class="pms-plink-arrow">›</span></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main id="main" class="pms-master-content">
        @if (master.ShowSubscriptionWarning)
        {
            <div class="pms-sub-expiry-alert">
                <div class="pms-sub-expiry-inner">
                    <div class="pms-sub-expiry-left"><i class="fa-solid fa-triangle-exclamation"></i><span>Your subscription will expire in <strong>@master.SubscriptionDaysRemaining day(s)</strong> on <strong>@master.SubscriptionExpiryDate?.ToString("dd MMM yyyy")</strong>.</span></div>
                    <a class="pms-sub-renew-btn" href="@master.RenewUrl">Renew now</a>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <div id="pmsMasterOverlay" class="pms-screenblur" onclick="pmsCloseMasterModal();"></div>

    <section id="pmsChangePasswordModal" class="pms-master-modal pms-password-modal" role="dialog" aria-modal="true" aria-label="Change Password">
        <div class="pms-modal-head"><h4>Change password</h4><button type="button" class="pms-modal-close" onclick="pmsCloseMasterModal(); return false;">×</button></div>
        <form asp-controller="PmsMaster" asp-action="ChangePassword" method="post" autocomplete="off">
            @Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@currentUrl" />
            <div class="pms-modal-body">
                <div class="pms-field"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required /></div>
                <div class="pms-field"><label>New Password</label><input type="password" name="newPassword" autocomplete="new-password" required /></div>
                <div class="pms-field"><label>Confirm New Password</label><input type="password" name="confirmPassword" autocomplete="new-password" required /></div>
            </div>
            <button type="submit" class="pms-change-submit">Change password</button>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(toastMessage)) { <div id="pmsMasterToast" class="pms-master-toast @toastType">@toastMessage</div> }

    <script src="~/js/pms-master.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
