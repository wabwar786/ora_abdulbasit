@model Orapmshms.Models.Restaurant.RestaurantHomeViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Restaurant Point of Sale";
    Layout = "_PmsLayout";
}
<link rel="stylesheet" href="~/css/restaurant-pos.css" asp-append-version="true" />
<div class="restaurant-page r-pos r-pos-classic r-pos-modern" id="restaurant-pos"
     data-variant-url="@Url.Action("Variants", "Restaurant")"
     data-side-url="@Url.Action("Sides", "Restaurant")"
     data-preview-url="@Url.Action("PrintPreview", "Restaurant")"
     data-tax-url="@Url.Action("TaxQuote", "Restaurant")"
     data-bill-panel-url="@Url.Action("BillPanel", "Restaurant")"
     data-room-post-status-url="@Url.Action("RoomPostStatus", "Restaurant")"
     data-inhouse-rooms-url="@Url.Action("InHouseRooms", "Restaurant")"
     data-room-payment-context-url="@Url.Action("RoomPaymentContext", "Restaurant")"
     data-checkin-record-payment-url="@Url.Action("RecordPayment", "CheckIn")"
     data-payment-methods-url="@Url.Action("PaymentMethods", "CheckIn")"
     data-paynow-link-url="@Url.Action("GenerateLink", "PayNow")"
     data-restaurant-home-url="@Url.Action("Home", "Restaurant")"
     data-card-start-url="@Url.Action("StartDineCard", "Restaurant")"
     data-card-finish-url="@Url.Action("FinalizeDineCard", "Restaurant")"
     data-current-bill-mode="@(Model.BillType == "Room" ? "room" : "dine-in")">
    @if (ViewBag.Error is string loadError)
    {
        <div class="restaurant-alert error" role="alert">@loadError</div>
    }
    @if (TempData["RestaurantError"] is string err)
    {
        <div class="restaurant-alert error" role="alert">@err</div>
    }
    @if (TempData["RestaurantNotice"] is string message)
    {
        <div class="restaurant-alert success" role="status">@message</div>
    }

    <div class="r-pos-status" id="r-pos-status" role="status" aria-live="polite" hidden></div>

    <main class="r-main">
        <section class="restaurant-panel r-menu" aria-labelledby="r-menu-title">
            <div class="r-classic-menu-heading">
                <div class="r-classic-title">
                    <h1 id="r-menu-title">Restaurant POS <span class="r-modern-counter">@Model.Items.Count items</span></h1>
                    <p>Tap an item image to add it to the bill.</p>
                </div>
                <div class="r-classic-tools">
                    <a class="restaurant-btn r-classic-inventory" href="@Url.Action("Inventory", "Restaurant")">Items Management</a>
                    <a class="restaurant-btn r-classic-inventory" href="@Url.Action("Index", "RestaurantItemSales")" target="_blank" rel="noopener noreferrer" title="Open Restaurant Item Sales in a new tab">Sales Report</a>
                    <form method="get" action="@Url.Action("Home", "Restaurant")" class="r-classic-search">
                        @if (!string.IsNullOrWhiteSpace(Model.Category))
                        {
                            <input type="hidden" name="category" value="@Model.Category" />
                        }
                        <input type="search" name="search" value="@Model.Search" placeholder="Search item by name" aria-label="Search item by name" />
                        <button type="submit" class="r-classic-search-icon" aria-label="Search menu">⌕</button>
                    </form>
                </div>
            </div>
            @if (Model.Categories.Any(x => x.Show.Equals("Yes", StringComparison.OrdinalIgnoreCase)))
            {
                <nav class="r-menu-categories" aria-label="Menu categories">
                    <a class="@(string.IsNullOrEmpty(Model.Category) ? "active" : "")" href="@Url.Action("Home", "Restaurant", new { search = Model.Search })">All Items</a>
                    @foreach (var cat in Model.Categories.Where(x => x.Show.Equals("Yes", StringComparison.OrdinalIgnoreCase)))
                    {
                        <a class="@(Model.Category == cat.Id ? "active" : "")" href="@Url.Action("Home", "Restaurant", new { category = cat.Id, search = Model.Search })">@cat.Name</a>
                    }
                </nav>
            }
            <div class="r-product-grid">
                @foreach (var item in Model.Items)
                {
                    <article class="r-product" aria-label="@item.Name" data-category="@item.CategoryId" data-search="@item.Name.ToLowerInvariant()">
                        <button type="button" class="r-product-picture r-product-photo-add" aria-label="Add @item.Name to bill" title="Add @item.Name">
                            <img src="@ProductImage(item.Image)" alt="" loading="lazy" onerror="this.src='/img/restaurant-placeholder.svg'" />
                        </button>
                        <div class="r-product-category-tag">@(Model.Categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name ?? "Menu")</div>
                        <div class="r-product-name">@item.Name</div>
                        <div class="r-classic-product-price">@Model.Currency @item.Price.ToString("0.##")</div>
                        @* Direct add: the quantity on this card is posted without opening a dialog. *@
                        <form asp-controller="Restaurant" asp-action="AddToCart" method="post"
                              class="r-classic-product-actions r-product-add-form" data-pos-async="add"
                              data-barcode="@item.Barcode" data-name="@item.Name">
                            <input type="hidden" name="Barcode" value="@item.Barcode" />
                            <div class="r-classic-stepper" aria-label="Quantity for @item.Name">
                                <button type="button" class="r-product-step-down" aria-label="Decrease quantity of @item.Name">−</button>
                                <input class="r-product-qty" name="Quantity" type="number" value="1" min="1" max="999" required inputmode="numeric" aria-label="Quantity of @item.Name" />
                                <button type="button" class="r-product-step-up" aria-label="Increase quantity of @item.Name">+</button>
                            </div>
                            <button type="submit" class="r-classic-add">Add</button>
                        </form>
                    </article>
                }
                @if (Model.Items.Count == 0)
                {
                    <div class="restaurant-empty r-pos-empty" role="status"><div class="r-pos-empty-icon" aria-hidden="true">⌕</div><h3>No menu items found</h3><p>Try another search term or choose a different category.</p><button type="button" class="r-pos-empty-reset" data-empty-reset>Clear filters</button></div>
                }
            </div>
        </section>

        @await Html.PartialAsync("_BillPanel", Model)
    </main>

    <!-- Unified cashier checkout for Dine In and Room Charge.
         Discount and GST are persisted through existing POS endpoints before settlement.
         Card/PDQ settlements continue to use the verified existing payment routes. -->
    <div class="r-touch-pay-overlay" id="r-touch-pay-dialog" hidden>
        <button type="button" class="r-touch-pay-shade" data-touch-pay-close aria-label="Close checkout"></button>
        <section class="r-touch-pay-window r-unified-checkout" role="dialog" aria-modal="true" aria-labelledby="r-touch-pay-title"
                 data-dine-pdq="@Model.CanPdqPayment.ToString().ToLowerInvariant()" data-dine-online="@Model.CanOnlineCardPayment.ToString().ToLowerInvariant()">
            <header class="r-touch-pay-head">
                <div><h2 id="r-touch-pay-title">Payment — Bill #<b id="r-touch-pay-number">@Model.BillNumber</b></h2><span id="r-unified-context">@(Model.BillType == "Room" ? "Room Bill" : "Walk-in")</span><span id="r-unified-guest">@(Model.BillType == "Room" ? $"{Model.GuestName} · Room {Model.RoomNo} · Reg {Model.RoomRegId}" : "")</span></div>
                <button type="button" class="r-touch-pay-x" data-touch-pay-close aria-label="Close">×</button>
            </header>
            <div class="r-touch-pay-body">
                <div class="r-unified-top">
                    <div class="r-unified-due"><small>Total amount</small><strong id="r-touch-pay-amount">@Model.Currency 0.00</strong><span id="r-unified-breakdown"></span></div>
                </div>
                <div id="r-unified-editor">
                <div class="r-unified-section-title"><strong>Bill type</strong></div>
                <div class="r-order-type" role="group" aria-label="Choose bill type">
                    <button type="button" data-order-type="counter" aria-pressed="false">Walk-in</button>
                    <button type="button" data-order-type="takeaway" aria-pressed="false">Takeaway</button>
                    <button type="button" data-order-type="room" aria-pressed="false">Room Bill</button>
                </div>
                <div class="r-selected-room" id="r-selected-room" hidden><div><small>Selected guest</small><strong id="r-selected-room-name"></strong><span id="r-selected-room-detail"></span></div><button type="button" id="r-room-picker-open" class="r-pay-secondary r-change-room">Change</button></div>
                </div> <!-- bill editor -->
                <div id="r-unified-notice" class="r-unified-notice" role="status" aria-live="polite" hidden></div>
                <div id="r-unified-payment-stage" class="r-unified-payment-stage">
                    <div class="r-unified-section-title r-unified-payment-heading"><strong>Payment method</strong></div>
                    <div class="r-pay-tabs" role="tablist" aria-label="Payment channel" hidden>
                        <button class="r-pay-tab active" type="button" role="tab" id="r-pay-tab-manual" aria-controls="r-pay-panel-manual" aria-selected="true" data-checkout-tab="manual"><span class="r-pay-tab-icon">▤</span>Manual payment</button>
                        <button class="r-pay-tab" type="button" role="tab" id="r-pay-tab-pdq" aria-controls="r-pay-panel-pdq" aria-selected="false" data-checkout-tab="pdq"><span class="r-pay-tab-icon">▣</span>PDQ Terminal</button>
                        <button class="r-pay-tab" type="button" role="tab" id="r-pay-tab-online" aria-controls="r-pay-panel-online" aria-selected="false" data-checkout-tab="online"><span class="r-pay-tab-icon">◈</span>Online Card</button>
                    </div>
                    <div id="r-manual-method-grid" class="r-manual-method-grid" role="group" aria-label="Payment method"></div>
                    <div class="r-pay-tab-body" id="r-pay-panel-manual" role="tabpanel" aria-labelledby="r-pay-tab-manual">
                        <div class="r-pay-field" id="r-manual-select-wrap" hidden><label for="r-pay-manual-method">Payment method</label>
                            <select id="r-pay-manual-method" class="r-pay-control">
                                <option value="">Select payment method</option>
                                @foreach (var method in Model.PaymentMethods.Where(m =>
                                    !m.Equals("PDQ Payment", StringComparison.OrdinalIgnoreCase) &&
                                    !m.Equals("PDQ Terminal", StringComparison.OrdinalIgnoreCase) &&
                                    !m.Equals("Online Card", StringComparison.OrdinalIgnoreCase)))
                                { <option value="@method">@method</option> }
                            </select>
                        </div>
                        <div id="r-cash-tender" hidden>
                            <div class="r-pay-field"><label for="r-cash-received">Received amount</label><input id="r-cash-received" type="number" class="r-pay-control" min="0" step="0.01" inputmode="decimal" /></div>
                            <div class="r-cash-quick" role="group" aria-label="Cash received shortcuts"><button type="button" data-cash-exact>Exact</button><button type="button" data-cash-add="10">+10</button><button type="button" data-cash-add="50">+50</button><button type="button" data-cash-add="100">+100</button></div>
                            <div class="r-cash-change"><span id="r-cash-change-label">Change to return</span><strong id="r-cash-change">—</strong></div>
                        </div>
                        <div class="r-pay-field" id="r-pay-card-fields" hidden>
                            <label for="r-pay-card-type">Card type (external terminal)</label>
                            <div class="r-pay-two-fields"><select id="r-pay-card-type" class="r-pay-control"><option value="">Choose card type</option><option>Visa</option><option>Mastercard</option><option>Amex</option><option>Other</option></select>
                            <input class="r-pay-control" id="r-pay-card-ref" type="text" maxlength="100" placeholder="Receipt / transaction reference" autocomplete="off" /></div>
                        </div>
                        <div class="r-pay-field" id="r-pay-manual-note-wrap" hidden><label for="r-pay-manual-note">Payment note (optional)</label><input id="r-pay-manual-note" class="r-pay-control" maxlength="200" placeholder="Cashier reference or note" /></div>
                        <p class="r-pay-tip" id="r-manual-card-tip" hidden>Never enter a full card number or CVV.</p>
                    </div>
                    <div class="r-pay-tab-body" id="r-pay-panel-pdq" role="tabpanel" aria-labelledby="r-pay-tab-pdq" hidden>
                        <div class="r-pay-provider"><strong>Connected PDQ terminal</strong><span>Send amount to your hotel's configured reader. Confirmed card settlement is verified by the payment ledger.</span></div>
                    </div>
                    <div class="r-pay-tab-body" id="r-pay-panel-online" role="tabpanel" aria-labelledby="r-pay-tab-online" hidden>
                        <div class="r-pay-provider"><strong>Secure online card</strong><span>Open the approved payment page. The bill stays pending until the payment is confirmed.</span></div>
                        <div class="r-pay-link" id="r-pay-link" hidden><input id="r-pay-link-value" class="r-pay-control" readonly aria-label="Payment URL"/><button type="button" id="r-pay-link-copy">Copy link</button></div>
                    </div>
                    <div class="r-pay-field r-room-collect-amount" id="r-room-collect-amount" hidden><label for="r-room-pay-amount">Collect now</label><input class="r-pay-control" type="number" min="0.01" step="0.01" id="r-room-pay-amount" inputmode="decimal" /></div>
                </div>
                <div class="r-checkout-tools" id="r-checkout-tools" role="group" aria-label="Bill actions">
                    <button type="button" id="r-hold-btn" class="r-pay-secondary">Hold Bill</button>
                    <button type="button" id="r-print-btn" class="r-pay-secondary">Preview / Print</button>
                </div>
                <div class="r-pay-result" id="r-pay-result" hidden role="status" aria-live="polite">
                    <span class="r-pay-result-icon">✓</span><div><strong id="r-pay-result-title">Bill posted</strong><p id="r-pay-result-text">The charge has been saved.</p></div>
                </div>
                <div class="r-pay-footer">
                    <p id="r-unified-payment-hint" class="r-touch-pay-safety">Select a method and continue.</p>
                    <div class="r-pay-footer-actions">
                        <button type="button" id="r-checkout-cancel" class="r-pay-secondary" data-touch-pay-close>Cancel (Esc)</button>
                        <button type="button" id="r-unified-folio-only" class="r-pay-secondary" hidden>Post to Folio • Pay Later</button>
                        <button type="button" id="r-unified-confirm" class="r-touch-pay-record" disabled>Continue</button>
                    </div>
                    <button type="button" id="r-pay-verify" class="r-pay-secondary r-pay-full" hidden>Check payment status</button>
                    <div class="r-pay-finished" id="r-pay-finished" hidden>
                        <button type="button" class="r-pay-secondary" id="r-pay-print">Print receipt</button>
                        <button type="button" class="r-touch-pay-record" id="r-pay-done">Done / New bill</button>
                    </div>
                </div>
                @if (Model.CanPdqPayment) { <button type="button" data-dine-gateway="pdq" id="r-unified-dine-pdq" hidden aria-hidden="true" tabindex="-1"></button> }
                @if (Model.CanOnlineCardPayment) { <button type="button" data-dine-gateway="online" id="r-unified-dine-online" hidden aria-hidden="true" tabindex="-1"></button> }
            </div>
        </section>
    </div>

<div class="r-room-picker-overlay" id="r-room-picker-dialog" hidden>
    <div class="r-room-picker-shade" data-room-picker-close></div>
    <section class="r-room-picker-panel" role="dialog" aria-modal="true" aria-labelledby="r-room-picker-title">
        <header class="r-room-picker-head">
            <div><span class="r-room-picker-kicker">IN-HOUSE GUESTS</span><h2 id="r-room-picker-title">Select room</h2></div>
            <button type="button" class="r-room-picker-dismiss" data-room-picker-close aria-label="Close">×</button>
        </header>
        <div class="r-room-picker-body">
            <input id="r-room-picker-search" type="search" autocomplete="off" aria-label="Search room or guest"
                   placeholder="Search room number or guest name…" />
            <div class="r-room-picker-list" id="r-room-picker-list" role="listbox" aria-label="Currently occupied rooms"></div>
            <p class="r-room-picker-status" id="r-room-picker-status" role="status" aria-live="polite"></p>
        </div>
        <footer class="r-room-picker-footer r-picker-actions"><span id="r-room-picker-choice" class="r-room-picker-choice">Select a room to continue.</span><button type="button" class="r-room-picker-cancel" data-room-picker-close>Back</button><button type="button" id="r-room-picker-confirm" class="r-room-picker-confirm" disabled>Continue</button></footer>
        <form asp-controller="Restaurant" asp-action="SelectRoom" method="post" id="r-room-picker-form" hidden>
            <input type="hidden" name="regId" id="r-room-picker-reg" />
            <input type="hidden" name="roomNo" id="r-room-picker-number" />
            <input type="hidden" name="transferBill" id="r-room-picker-transfer" />
            <input type="hidden" name="continueCheckout" id="r-room-picker-continue" value="false" />
        </form>
    </section>
</div>


<div class="restaurant-dialog" id="r-cancel-dialog" hidden>
    <div class="restaurant-dialog-shade" data-close="r-cancel-dialog"></div>
    <div class="restaurant-dialog-panel" role="dialog" aria-modal="true" aria-labelledby="r-cancel-title">
        <div class="restaurant-dialog-title"><h2 id="r-cancel-title">Cancel Kitchen Item</h2><button type="button" class="restaurant-dialog-close" data-close="r-cancel-dialog" aria-label="Close">×</button></div>
        <p class="restaurant-form-hint">This item was already sent to the kitchen. A cancellation notice must be printed and delivered to the kitchen.</p>
        <form asp-controller="Restaurant" asp-action="CancelKitchenItem" method="post" id="r-cancel-form" target="_blank" data-pos-async="cancel">
            <input type="hidden" name="RowId" id="r-cancel-row" />
            <label>Item <input id="r-cancel-item" readonly /></label>
            <label>Reason (required) <textarea name="Reason" id="r-cancel-reason" minlength="3" maxlength="250" rows="3" required class="restaurant-input" placeholder="Reason for kitchen cancellation"></textarea></label>
            <div class="restaurant-dialog-actions"><button type="button" class="restaurant-btn r-secondary" data-close="r-cancel-dialog">Back</button>
                <button type="submit" class="restaurant-btn r-danger">Cancel &amp; Print Notice</button></div>
        </form>
    </div>
</div>
<div class="r-modern-modal" id="r-qty-dialog" hidden>
    <div class="r-modern-modal-shade" data-pos-dismiss="r-qty-dialog"></div>
    <section class="r-modern-modal-panel r-modern-qty-dialog" role="dialog" aria-modal="true" aria-labelledby="r-qty-modal-title">
        <div class="r-modern-modal-head"><div><h2 id="r-qty-modal-title">Update Quantity</h2><p id="r-qty-item-name"></p></div><button type="button" class="r-modern-close" data-pos-dismiss="r-qty-dialog" aria-label="Close">×</button></div>
        <label for="r-qty-display" class="r-modern-input-label">Quantity</label>
        <input id="r-qty-display" type="text" value="1" inputmode="numeric" autocomplete="off" readonly aria-live="polite" />
        <div class="r-numpad" aria-label="Quantity keypad">
            @foreach (var n in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "⌫" })
            {
                <button type="button" class="r-numpad-key" data-digit="@n">@n</button>
            }
        </div>
        <div class="r-modern-dialog-buttons"><button type="button" class="r-modern-cancel" data-pos-dismiss="r-qty-dialog">Cancel</button><button type="button" id="r-qty-apply" class="r-modern-apply">Apply Quantity</button></div>
    </section>
</div>
<div class="r-modern-modal" id="r-discount-dialog" hidden>
    <div class="r-modern-modal-shade" data-pos-dismiss="r-discount-dialog"></div>
    <section class="r-modern-modal-panel" role="dialog" aria-modal="true" aria-labelledby="r-discount-modal-title">
        <div class="r-modern-modal-head"><div><h2 id="r-discount-modal-title">Edit Discount</h2><p>Choose a percentage or fixed amount.</p></div><button type="button" class="r-modern-close" data-pos-dismiss="r-discount-dialog" aria-label="Close">×</button></div>
        <div class="r-discount-mode" role="group" aria-label="Discount type"><button type="button" data-discount-mode="percent">Percentage (%)</button><button type="button" data-discount-mode="amount">Amount</button></div>
        <label class="r-modern-input-label" for="r-discount-editor">Discount</label><input type="number" id="r-discount-editor" min="0" step="0.01" inputmode="decimal" />
        <p class="r-modern-preview" id="r-discount-preview"></p>
        <div class="r-modern-dialog-buttons"><button type="button" class="r-modern-cancel" data-pos-dismiss="r-discount-dialog">Cancel</button><button type="button" class="r-modern-apply" id="r-discount-apply">Apply Discount</button></div>
    </section>
</div>
<div class="r-modern-modal" id="r-tax-dialog" hidden>
    <div class="r-modern-modal-shade" data-pos-dismiss="r-tax-dialog"></div>
    <section class="r-modern-modal-panel" role="dialog" aria-modal="true" aria-labelledby="r-tax-modal-title">
        <div class="r-modern-modal-head"><div><h2 id="r-tax-modal-title">Edit GST / VAT</h2><p>Use the hotel's default rate or a custom rate for this bill.</p></div><button type="button" class="r-modern-close" data-pos-dismiss="r-tax-dialog" aria-label="Close">×</button></div>
        <form asp-controller="Restaurant" asp-action="SetTaxRate" method="post" id="r-tax-form" data-pos-async="tax">
            <input type="hidden" name="billNumber" id="r-tax-bill" />
            <label class="r-modern-input-label" for="r-tax-edit-rate">Tax rate (%)</label><input type="number" name="rate" id="r-tax-edit-rate" min="0" max="100" step="0.01" inputmode="decimal" required />
            <p class="r-modern-preview" id="r-tax-preview"></p>
            <p class="r-modern-help">Manual tax rates apply to this bill in your current POS session; the chosen rate is recorded in the payment notes when you close the bill.</p>
            <div class="r-modern-dialog-buttons"><button type="button" class="r-modern-cancel" id="r-tax-reset">Hotel Default</button><button type="submit" class="r-modern-apply" id="r-tax-apply">Apply Tax</button></div>
        </form>
    </section>
</div>
@functions {
    string ProductImage(string? image)
    {
        // Resolve both new image paths and existing Web Forms / previous MVC database values.
        if (string.IsNullOrWhiteSpace(image)) return "/img/restaurant-placeholder.svg";
        var value = image.Trim().Replace('\\', '/');
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps) return value;
        if (value.StartsWith("/img/", StringComparison.OrdinalIgnoreCase)) return value;
        if (value.StartsWith("img/", StringComparison.OrdinalIgnoreCase)) return "/" + value;
        const string previousUpload = "/restaurant/uploads/";
        if (value.StartsWith(previousUpload, StringComparison.OrdinalIgnoreCase))
            return "/img/pos-uploads/" + value.Substring(previousUpload.Length);
        if (value.StartsWith(previousUpload.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
            return "/img/pos-uploads/" + value.Substring(previousUpload.Length - 1);
        if (value.Contains("/Uploads/", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Uploads/", StringComparison.OrdinalIgnoreCase))
            return "/img/" + Uri.EscapeDataString(System.IO.Path.GetFileName(value));
        return "/img/restaurant-placeholder.svg";
    }
}
<script src="~/js/restaurant.js" asp-append-version="true"></script>
<script src="~/js/restaurant-pos.js" asp-append-version="true"></script>
<script src="~/js/restaurant-room-picker.js" asp-append-version="true"></script>
<script src="~/js/restaurant-room-checkout.js" asp-append-version="true"></script>
<script src="~/js/restaurant-dine-card-payments.js" asp-append-version="true"></script>
<script src="~/js/restaurant-touch-ui.js" asp-append-version="true"></script>
