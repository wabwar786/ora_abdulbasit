         <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
       <script>
           function exportTableWithDates({ tableId, startDateId, endDateId, baseFileName = "Report" }) {
               const table = document.getElementById(tableId);
               const startDate = document.getElementById(startDateId)?.value || "";
               const endDate = document.getElementById(endDateId)?.value || "";

               // Clean/sanitize for filename
               const formatDate = (date) => date.replaceAll('/', '-').replaceAll('\\', '-');

               const safeStart = startDate ? formatDate(startDate) : "from";
               const safeEnd = endDate ? formatDate(endDate) : "to";

               const fileName = `${baseFileName}_${safeStart}_to_${safeEnd}.xlsx`;

               const workbook = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });
               XLSX.writeFile(workbook, fileName);
           }
       </script>
      <script>
          let leftCurrentDate = new Date();  // Tracks left calendar month
          let rightCurrentDate = new Date(leftCurrentDate.getFullYear(), leftCurrentDate.getMonth() + 1, 1);  // Right calendar is always 1 month ahead

          let startDate = null;
          let endDate = null;
          let selectingStartDate = true;
          let config = {
              mode: 'range',
              textboxId: '',
              hiddenStartId: '',
              hiddenEndId: '',
              popupid: 'calendarPopup',
              leftmonthid: 'leftMonthHeader',
              rightmonthheader: 'rightMonthHeader',
              leftcalander:'leftCalendar',
              rightcalander:'rightCalendar'
          };
          function showCalendarFor(targetTextboxId, hiddenStart, hiddenEnd, mode = 'range', popupid = 'calendarPopup', leftmonthid = 'leftMonthHeader', rightmonthheader = 'rightMonthHeader', leftcalander = 'leftCalendar', rightcalander = 'rightCalendar') {
              config = {
                  textboxId: targetTextboxId,
                  hiddenStartId: hiddenStart,
                  hiddenEndId: hiddenEnd,
                  mode: mode,
                  popupid: popupid,
                  leftmonthid: leftmonthid,
                  rightmonthheader: rightmonthheader,
                  leftcalander: leftcalander,
                  rightcalander: rightcalander

              };

              const popup = document.getElementById(popupid);
              popup.style.display = 'block';
              renderCalendars();
          }

          function renderCalendars() {
              document.getElementById(config.leftmonthid).textContent = `${monthNames[leftCurrentDate.getMonth()]} ${leftCurrentDate.getFullYear()}`;
              document.getElementById(config.rightmonthheader).textContent = `${monthNames[rightCurrentDate.getMonth()]} ${rightCurrentDate.getFullYear()}`;

              renderMonth(config.leftcalander, leftCurrentDate);
              renderMonth(config.rightcalander, rightCurrentDate);
              updateSelectedRangeText();
          }



          function renderMonth(containerId, monthDate) {
              const container = document.getElementById(containerId);
              container.innerHTML = '';

              dayNames.forEach(day => {
                  const dayHeader = document.createElement('div');
                  dayHeader.className = 'day-header';
                  dayHeader.textContent = day;
                  container.appendChild(dayHeader);
              });

              const firstDay = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
              const lastDay = new Date(monthDate.getFullYear(), monthDate.getMonth() + 1, 0);
              const startWeekDay = firstDay.getDay();

              // Previous month's tail days to fill the first week
              for (let i = 0; i < startWeekDay; i++) {
                  const prevDate = new Date(firstDay);
                  prevDate.setDate(firstDay.getDate() - (startWeekDay - i));
                  container.appendChild(createDayCell(prevDate, true));
              }

              // Current month's days
              for (let day = 1; day <= lastDay.getDate(); day++) {
                  const date = new Date(monthDate.getFullYear(), monthDate.getMonth(), day);
                  container.appendChild(createDayCell(date, false));
              }

              // Do NOT add overflow days from next month in left calendar
              if (containerId === 'rightCalendar') {
                  // Pad with next month's start days to complete final row
                  const lastDayWeekday = lastDay.getDay(); // 0=Sun ... 6=Sat
                  if (lastDayWeekday < 6) {
                      for (let i = 1; i <= (6 - lastDayWeekday); i++) {
                          const nextDate = new Date(lastDay);
                          nextDate.setDate(lastDay.getDate() + i);
                          container.appendChild(createDayCell(nextDate, true));
                      }
                  }
              }
          }


          function createDayCell(date, isOtherMonth) {
              const dayCell = document.createElement('div');
              dayCell.className = 'day-cell';
              dayCell.textContent = date.getDate();

              if (isOtherMonth) dayCell.classList.add('other-month');
              if (new Date().toDateString() === date.toDateString()) dayCell.classList.add('today');
              if (startDate && date.toDateString() === startDate.toDateString()) dayCell.classList.add('start-date');
              if (endDate && date.toDateString() === endDate.toDateString()) dayCell.classList.add('end-date');
              if (startDate && endDate && date > startDate && date < endDate) dayCell.classList.add('in-range');

              dayCell.onclick = (e) => {
                  e.stopPropagation(); // ✅ Prevent click from closing the popup
                  selectDate(date);
              };
              return dayCell;
          }

          function selectDate(date) {
              if (config.mode === 'single') {
                  startDate = date;
                  endDate = null;
                  applySelection();
              } else {
                  if (selectingStartDate || !startDate || (startDate && endDate)) {
                      startDate = date;
                      endDate = null;
                      selectingStartDate = false;
                      renderCalendars();
                  } else {
                      if (date < startDate) {
                          endDate = startDate;
                          startDate = date;
                      } else {
                          endDate = date;
                      }
                      selectingStartDate = true;
                      applySelection();
                  }
              }
          }
          function previousLeftMonth() {
              leftCurrentDate.setMonth(leftCurrentDate.getMonth() - 1);
              renderCalendars();
          }

          function nextLeftMonth() {
              leftCurrentDate.setMonth(leftCurrentDate.getMonth() + 1);
              renderCalendars();
          }

          function previousRightMonth() {
              rightCurrentDate.setMonth(rightCurrentDate.getMonth() - 1);
              renderCalendars();
          }

          function nextRightMonth() {
              rightCurrentDate.setMonth(rightCurrentDate.getMonth() + 1);
              renderCalendars();
          }



          function clearSelection() {
              startDate = null;
              endDate = null;
              selectingStartDate = true;

              const txt = document.getElementById(config.textboxId);
              if (txt) txt.value = '';

              if (config.hiddenStartId) document.getElementById(config.hiddenStartId).value = '';
              if (config.hiddenEndId) document.getElementById(config.hiddenEndId).value = '';

              renderCalendars();
          }

          function applySelection() {
              const start = startDate ? formatDate(startDate) : '';
              const end = endDate ? formatDate(endDate) : '';
              const txt = document.getElementById(config.textboxId);

              if (config.mode === 'single') {
                  if (txt) txt.value = start;
              } else {
                  if (txt) txt.value = end ? `${start} - ${end}` : `${start} - `;
              }

              if (config.hiddenStartId) document.getElementById(config.hiddenStartId).value = start;
              if (config.hiddenEndId) document.getElementById(config.hiddenEndId).value = end;

              document.getElementById(config.popupid).style.display = 'none';
          }

          function formatDate(date) {
              if (!date || !(date instanceof Date)) return '';
              const month = String(date.getMonth() + 1).padStart(2, '0');
              const day = String(date.getDate()).padStart(2, '0');
              return `${day}/${month}/${date.getFullYear()}`;
          }

          function updateSelectedRangeText() {
              const rangeText = document.getElementById('selectedRangeText');
              const start = startDate ? formatDate(startDate) : '';
              const end = endDate ? formatDate(endDate) : '';

              if (config.mode === 'single') {
                  rangeText.textContent = start ? `Selected: ${start}` : 'Select a date';
              } else {
                  if (start && end) {
                      rangeText.textContent = `${start} - ${end}`;
                  } else if (start) {
                      rangeText.textContent = `${start} - Select end date`;
                  } else {
                      rangeText.textContent = 'Select date range';
                  }
              }
          }

          // ✅ Fixed document click handler to not close when clicking inside popup
          document.addEventListener('click', function (event) {
              const popup = document.getElementById(config.popupid);
              if (
                  popup &&
                  !popup.contains(event.target) &&
                  !event.target.closest('.calendar-icon')
              ) {
                  popup.style.display = 'none';
              }
          });

          const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
              'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
          const dayNames = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
      </script>

    </form>
    <script type="text/javascript">
        // ===== universal click logger =====
        (function () {
            // config
            var BATCH_SIZE = 15;          // send when >= 15 clicks
            var FLUSH_MS = 1500;        // or every 1.5s
            var MAX_TEXT = 200;         // clamp text length
            var IGNORE_SEL = [
                '.toast .btn-close', '.modal .btn-close',
                '[data-nolog="1"]',  // mark elements you want to exclude
                'input[type=password]'
            ];

            function matchesIgnore(el) {
                try {
                    for (var i = 0; i < IGNORE_SEL.length; i++) {
                        if (el.matches && el.matches(IGNORE_SEL[i])) return true;
                        if (el.closest && el.closest(IGNORE_SEL[i])) return true;
                    }
                } catch (e) { }
                return false;
            }

            function collectDataAttrs(el) {
                try {
                    if (!el || !el.dataset) return null;
                    var out = [];
                    for (var k in el.dataset) {
                        if (!el.dataset.hasOwnProperty(k)) continue;
                        // Skip explicit opt-out
                        if (k === "nolog") continue;
                        var val = el.dataset[k];
                        if (typeof val === "string" && val.length > 128) val = val.substr(0, 128) + '…';
                        out.push(k + '=' + val);
                    }
                    return out.length ? out.join('&') : null;
                } catch (e) { return null; }
            }

            function textOf(el) {
                try {
                    var t = (el.innerText || el.value || el.textContent || '').trim();
                    if (t.length > MAX_TEXT) t = t.substr(0, MAX_TEXT) + '…';
                    return t;
                } catch (e) { return ''; }
            }

            var queue = [];
            var flushTimer = null;

            function scheduleFlush() {
                if (flushTimer) return;
                flushTimer = setTimeout(function () {
                    flushTimer = null;
                    flush();
                }, FLUSH_MS);
            }

            function flush() {
                if (!queue.length) return;

                // shallow copy then clear
                var batch = queue.slice(0);
                queue = [];

                try {
                    if (window.PageMethods && typeof PageMethods.LogClicks === 'function') {
                        PageMethods.LogClicks(batch,
                            function () { /* ok */ },
                            function () { /* drop on error */ });
                    } else {
                        // fallback: image beacon (no CORS issues)
                        // new Image().src = '/pixel.gif?c=' + encodeURIComponent(JSON.stringify(batch));
                    }
                } catch (e) { /* fail silently */ }
            }

            document.addEventListener('click', function (ev) {
                var el = ev.target;
                if (!el) return;

                // bubble to a more meaningful clickable (button/a/input/label/etc.)
                var meaningful = el.closest ? el.closest('button,a,input,label,div,span,[role="button"]') : el;
                if (!meaningful) meaningful = el;

                if (matchesIgnore(meaningful)) return;

                var rect = document.documentElement;
                var item = {
                    pageUrl: location.href,
                    elementTag: (meaningful.tagName || '').toLowerCase(),
                    elementId: meaningful.id || null,
                    elementName: meaningful.name || null,
                    elementText: textOf(meaningful),
                    css: (meaningful.className || '').toString().trim().substr(0, 512),
                    data: collectDataAttrs(meaningful),
                    x: ev.clientX || null,
                    y: ev.clientY || null,
                    w: rect ? rect.clientWidth : null,
                    h: rect ? rect.clientHeight : null,
                    referrer: document.referrer || null,
                    extraJson: JSON.stringify({
                        ua: navigator.userAgent || '',
                        t: Date.now()
                    })
                };

                queue.push(item);
                if (queue.length >= BATCH_SIZE) flush(); else scheduleFlush();
            });

            // flush on unload
            window.addEventListener('beforeunload', function () { flush(); });
        })();
</script>
    <script>

        function toggleTopbarMenu() {

            document.body.classList.toggle("topbar-hidden");

            var hidden =
                document.body.classList.contains("topbar-hidden");

            localStorage.setItem(
                "topbar_hidden",
                hidden ? "1" : "0"
            );
        }

        document.addEventListener("DOMContentLoaded", function () {

            var saved =
                localStorage.getItem("topbar_hidden");

            if (saved === "1") {
                document.body.classList.add("topbar-hidden");
            }

        });

    </script>
    <script>
        function toggleNav() {
            if (window.innerWidth <= 768) {
                document.body.classList.toggle("mobile-sidebar-open");
            } else {
                document.body.classList.toggle("sidebar-collapsed");
            }
        }

        function toggleFullHeader() {
            document.body.classList.toggle("header-hidden");

            localStorage.setItem(
                "header_hidden",
                document.body.classList.contains("header-hidden") ? "1" : "0"
            );
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (localStorage.getItem("sidebar_collapsed") === "1") {
                document.body.classList.add("sidebar-collapsed");
            }

            if (localStorage.getItem("header_hidden") === "1") {
                document.body.classList.add("header-hidden");
            }
        });
    </script>
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            setTimeout(function () {

                const sidebar = document.getElementById("sidebar");

                if (!sidebar) return;

                // find active submenu item
                const activeMenu = sidebar.querySelector(".submenu a.active-menu");

                // if active menu already exists
                if (activeMenu) {

                    const submenu = activeMenu.closest(".submenu");

                    if (submenu) {
                        submenu.style.display = "block";

                        const categoryLink = submenu.previousElementSibling;

                        if (categoryLink && categoryLink.classList.contains("category-link")) {
                            categoryLink.classList.add("open");
                        }
                    }

                    return;
                }

                // no active menu found
                // open first category automatically

                const firstCategory = sidebar.querySelector(".category-link");

                if (firstCategory) {

                    firstCategory.classList.add("open");

                    const submenu = firstCategory.nextElementSibling;

                    if (submenu && submenu.classList.contains("submenu")) {
                        submenu.style.display = "block";
                    }
                }

            }, 100);

        });

    </script>
</body>
</html>