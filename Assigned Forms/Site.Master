        <script>
            function rememberSidebarBeforeNav(menuLink) {
                // ensure parent category is saved as open
                var categoryLink = null;

                // menuLink -> inside submenu div -> previous sibling is category <a>
                var submenuDiv = menuLink.closest(".submenu");
                if (submenuDiv) categoryLink = submenuDiv.previousElementSibling;

                if (categoryLink && categoryLink.classList.contains("category-link")) {
                    // keep it open and save
                    submenuDiv.style.display = "block";
                    categoryLink.classList.add("open");
                    saveOpenCategories();
                    localStorage.setItem("sidebar_last_menu_id", menuLink.id || "");
                }
            }
        </script>

        
        <script type="text/javascript">
            // ==========================
            // Notifications (unchanged)
            // ==========================
            function clicksaveprintNotification() {
                document.getElementById('<%= loading.ClientID %>').style.display = 'block';
      document.getElementById('<%= hiddensaveprint.ClientID %>').click();
            }

            // ==========================
            // ✅ ROLE HELPERS (NEW)
            // ==========================
            function getRoleLower() {
                // hdnrole must exist in Site.Master: <asp:HiddenField ID="hdnrole" runat="server" />
                var el = document.getElementById('<%= hdnrole1.ClientID %>');
                return (el ? (el.value || "") : "").trim().toLowerCase();
            }

            function applyLayoutByRole() {
                var sidebar = document.getElementById("sidebar");
                var main = document.getElementById("main1");
                if (!sidebar || !main) return;

                var role = getRoleLower();
                var mediaQueryList = window.matchMedia("(max-width: 768px)");

                // ✅ Council: sidebar always closed
                if (role === "council") {
                    sidebar.style.width = "0";
                    main.style.marginLeft = "0";
                    return;
                }

                // ✅ Non-council: responsive default
                if (mediaQueryList.matches) {
                    sidebar.style.width = "0";
                    main.style.marginLeft = "0";
                } else {
                    sidebar.style.width = "190px";
                    main.style.marginLeft = "190px";
                }
            }

            // ==========================
            // ✅ DOM READY (UPDATED)
            // ==========================
            document.addEventListener("DOMContentLoaded", function () {
                applyLayoutByRole();

                // update layout when screen size changes
                var mediaQueryList = window.matchMedia("(max-width: 768px)");
                if (mediaQueryList.addEventListener) {
                    mediaQueryList.addEventListener("change", applyLayoutByRole);
                } else {
                    // old browsers
                    mediaQueryList.addListener(applyLayoutByRole);
                }

                updateScrollButtons();
            });

            // ✅ run after UpdatePanel async postback too
            if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    applyLayoutByRole();
                    updateScrollButtons();
                });
            }

            // ==========================
            // ✅ TOGGLE NAV (UPDATED)

                function toggleNav() {
                    document.body.classList.toggle("sidebar-collapsed");

                var isCollapsed = document.body.classList.contains("sidebar-collapsed");
                localStorage.setItem("sidebar_collapsed", isCollapsed ? "1" : "0");
    }

                document.addEventListener("DOMContentLoaded", function () {
        var saved = localStorage.getItem("sidebar_collapsed");

                if (saved === "1") {
                    document.body.classList.add("sidebar-collapsed");
        } else {
                    document.body.classList.remove("sidebar-collapsed");
        }

                activateCurrentSidebarPage();
    });

            function openPage(page) {
                toggleNav();
                window.location.href = page;
            }

            // ==========================
            // Popups (unchanged)
            // ==========================
            function openChangePasswordPopup() {
                var popup1 = document.getElementById('<%= ChangePasswordpopup.ClientID %>');
      var popup = document.getElementById('<%= popupprofile.ClientID %>');
      var overlay4 = document.getElementById('<%= overlay.ClientID %>');
                popup1.style.display = 'block';
                popup.style.display = 'none';
                overlay4.style.display = 'block';
            }

            function CloseChangePasswordPopup() {
                var popup1 = document.getElementById('<%= ChangePasswordpopup.ClientID %>');
    var overlay4 = document.getElementById('<%= overlay.ClientID %>');
    popup1.style.display = 'none';
    overlay4.style.display = 'none';
  }

  function openNotificationPopup() {
    var popup1 = document.getElementById('<%= Notificationpopup.ClientID %>');
    var popup = document.getElementById('<%= popupprofile.ClientID %>');
    var overlay4 = document.getElementById('<%= overlay.ClientID %>');
    popup1.style.display = 'block';
    popup.style.display = 'none';
    overlay4.style.display = 'block';
  }

  function CloseNotificationPopup() {
    var popup1 = document.getElementById('<%= Notificationpopup.ClientID %>');
    var overlay4 = document.getElementById('<%= overlay.ClientID %>');
                popup1.style.display = 'none';
                overlay4.style.display = 'none';
            }

            // ==========================
            // Highlight / menu state (unchanged)
            // ==========================
            window.onload = function () {
                var path = window.location.pathname;
                var pageName = path.substring(path.lastIndexOf("/") + 1).split(".")[0];
                console.log("Page Name: " + pageName);
                getLastInsertedCategoryAndMenu();
            };

            function setSelectedSidebar(menuElement) {
                var menuID = menuElement.id;
                var categoryID = menuElement.closest(".menu-container").previousElementSibling.id;

                localStorage.clear();
                localStorage.setItem('selectedMenuID', menuID);
                localStorage.setItem('selectedCategoryID', categoryID);
            }

            function setSelectedTopbar(menuElement) {
                var menuID = menuElement.id;

                localStorage.clear();
                localStorage.setItem('selectedMenuID', menuID);
            }

            function getLastInsertedCategoryAndMenu() {
                var selectedCategoryID = localStorage.getItem('selectedCategoryID');
                var selectedMenuID = localStorage.getItem('selectedMenuID');

                if (selectedCategoryID) {
                    var categoryElement = document.getElementById(selectedCategoryID);
                    if (categoryElement) toggleMenu(categoryElement);
                }

                if (selectedMenuID) applyHighlight(selectedMenuID, selectedCategoryID);
            }

            function applyHighlight(selectedMenuId, selectedCategoryId) {
                var element = document.getElementById(selectedMenuId);
                if (element) {
                    if (selectedCategoryId) element.classList.add('highlighted');
                    else element.classList.add('highlighted-top');
                    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }

            function toggleMenu(categoryElement) {
                var menuContainer = categoryElement.nextElementSibling;
                if (menuContainer) {
                    if (menuContainer.style.display === 'none' || menuContainer.style.display === '') {
                        menuContainer.style.display = 'block';
                    } else {
                        menuContainer.style.display = 'none';
                    }
                }
            }

            // ==========================
            // Topbar scroll buttons (unchanged)
            // ==========================
            function updateScrollButtons() {
                const scrollableContent = document.getElementById('scrollable-contentrctsearh');
                if (!scrollableContent) return;

                const scrollLeft1 = scrollableContent.scrollLeft;
                const scrollWidth1 = scrollableContent.scrollWidth;
                const containerWidth1 = scrollableContent.clientWidth;

                const leftButton = document.getElementById('btn_left_contentrctsearh');
                const rightButton = document.getElementById('btn_right_contentrctsearh');

                if (leftButton) leftButton.style.display = (scrollLeft1 === 0) ? 'none' : 'block';
                if (rightButton) rightButton.style.display = (scrollLeft1 + containerWidth1 >= scrollWidth1) ? 'none' : 'block';
            }

            function scrollContent(direction, containerId) {
                const container = document.getElementById(containerId);
                if (!container) return;

                const scrollAmount = 100;
                if (direction === 'left') container.scrollLeft -= scrollAmount;
                else if (direction === 'right') container.scrollLeft += scrollAmount;

                updateScrollButtons();
            }

            // ==========================
            // Inputs helpers (unchanged)
            // ==========================
            function isNumberKey(evt) {
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57)) return false;
                return true;
            }

            function isNumberKeyAndDot(evt) {
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                var input = evt.target.value;

                if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode !== 46) return false;
                if (charCode === 46 && input.includes(".")) return false;

                return true;
            }
        </script>

