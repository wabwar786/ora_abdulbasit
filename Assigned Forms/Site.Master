          font-weight: 500;
      }

      .calendar-actions {
          display: flex;
          gap: 10px;
      }

      .btn {
          padding: 8px 16px;
          border: 1px solid #e0e0e0;
          border-radius: 4px;
          cursor: pointer;
          font-size: 14px;
          transition: all 0.3s ease;
      }

      .btn-clear {
          background: white;
