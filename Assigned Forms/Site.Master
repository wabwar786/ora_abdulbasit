            <!-- ✅ UI ONLY CSS (scoped to these classes, won’t touch your calendar / inner pages) -->
            <style>
                .help-wrap{ margin-right:5px; }

.help-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  height:36px;
  width:36px;
  border-radius:12px;
  background:linear-gradient(135deg,#eef2ff,#f5f3ff);
  border:1px solid rgba(15,23,42,.08);
  box-shadow:0 10px 24px rgba(2,6,23,.06);
  text-decoration:none;
}

.help-icon i{
  font-size:18px;
  color:#f0582a;
}

.help-icon:hover{
  transform:translateY(-1px);
  box-shadow:0 14px 30px rgba(2,6,23,.10);
}

.help-icon:active{
  transform:translateY(0px);
}

                .top-actions-wrap{ width:100%; display:flex; justify-content:flex-end; }
                .top-actions{
                    display:flex; align-items:center; justify-content:flex-end; gap:10px;
                    padding:6px 8px;
                   /* border-radius:14px;*/
                    background: rgba(255,255,255,.85);
                    backdrop-filter: blur(12px);
                 /*   box-shadow: 0 10px 25px rgba(0,0,0,.08);
                    border: 1px solid rgba(15,23,42,.08);*/
                }
                .icon-wrap{ position:relative; display:flex; align-items:center; }

                .top-icon-btn{
                    border:none !important;
                    background: rgba(15,23,42,.06);
                    width:36px; height:36px;
                    border-radius:12px;
                    padding:7px;
                    transition: transform .18s ease, background .18s ease;
                }
                .top-icon-btn:hover{ background: rgba(15,23,42,.10); transform: translateY(-1px); }

                .notif-badge{
                    position:absolute;
                    top:-6px; right:-6px;
                    background: linear-gradient(135deg,#ff3b30,#ff8a00);
                    color:#fff !important;
                    font-size:10px !important;
                    font-weight:700 !important;
                    min-width:18px; height:18px;
                    border-radius:999px;
                    display:flex; align-items:center; justify-content:center;
                    padding:0 6px;
                    box-shadow: 0 8px 18px rgba(255,59,48,.25);
                    border: 2px solid #fff;
                }

                .prop-dd{ min-width:140px; }
                .top-dd{
                    height:36px;
                    border-radius:12px !important;
                    border: 1px solid rgba(15,23,42,.15) !important;
                    box-shadow:none !important;
                    background:#fff !important;
                    font-size:12px !important;
                }

                .currency-pill{
                    height:36px;
                    background: rgba(52,187,150,.12);
                    border: 1px solid rgba(52,187,150,.22);
                    color:#0f172a !important;
                    font-weight:600 !important;
                    font-size:12px !important;
                    white-space:nowrap;
                }

                .profile-wrap{ position:relative; }
                .profile-btn{
                    border:none !important;
                    background: rgba(15,23,42,.06);
                    width:36px; height:36px;
                    border-radius:999px;
                    padding:6px;
                    transition: transform .18s ease, background .18s ease;
                }
                .profile-btn:hover{ background: rgba(15,23,42,.10); transform: translateY(-1px); }

                .profile-popup{
                    position:absolute;
                    right:0;
                    top:44px;
                    width:320px;
                    z-index:9999;
                }
                .profile-popup-inner{
                    background: rgba(255,255,255,.92);
                    backdrop-filter: blur(18px);
                    border-radius:18px;
                    border: 1px solid rgba(15,23,42,.10);
                    box-shadow: 0 24px 60px rgba(0,0,0,.16);
                    overflow:hidden;
                    animation: popDrop .18s ease-out;
                }
                @keyframes popDrop{
                    from{ transform: translateY(-8px); opacity:0; }
                    to{ transform: translateY(0); opacity:1; }
                }

                .profile-head{
                    display:flex;
                    align-items:center;
                    gap:10px;
                    padding:14px 14px 12px 14px;
                    background: linear-gradient(135deg, rgba(52,187,150,.18), rgba(252,182,59,.12));
                    border-bottom: 1px solid rgba(15,23,42,.08);
                }
                .profile-avatar{
                    width:38px; height:38px;
                    border-radius:12px;
                    background:#fff;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    overflow:hidden;
                    border: 1px solid rgba(15,23,42,.08);
                }
                .profile-avatar img{ width:22px; height:22px; opacity:.95; }
                .profile-meta{ flex:1; min-width:0; }
                .profile-name{
                    font-weight:700;
                    font-size:13px;
                    color:#0f172a;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;
                }
                .profile-sub{ font-size:11px; color: rgba(15,23,42,.65); }

                .popup-x{
                    border:none;
                    width:30px; height:30px;
                    border-radius:10px;
                    background: rgba(15,23,42,.06);
                    cursor:pointer;
                    font-size:18px;
                    line-height:30px;
                    color:#0f172a;
                }
                .popup-x:hover{ background: rgba(15,23,42,.10); }

                .profile-actions{ padding:10px; }

                .profile-link{
                    display:flex;
                    align-items:center;
                    gap:10px;
                    width:100%;
                    padding:10px 10px;
                    border-radius:12px;
                    text-decoration:none !important;
                    background: transparent;
                    border: 1px solid transparent;
                    color:#0f172a !important;
                    transition: background .16s ease, border-color .16s ease, transform .16s ease;
                    margin-bottom:6px;
                }
                .profile-link:hover{
                    background: rgba(15,23,42,.06);
                    border-color: rgba(15,23,42,.08);
                    transform: translateY(-1px);
                }
                .profile-link.danger:hover{
                    background: rgba(255,59,48,.08);
                    border-color: rgba(255,59,48,.16);
                }

                .plink-ico{
                    width:30px; height:30px;
                    border-radius:10px;
                    background:#fff;
                    border: 1px solid rgba(15,23,42,.08);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    overflow:hidden;
                }
                .plink-ico img{ width:16px; height:16px; }

                .plink-text{
                    flex:1;
                    font-size:12px;
                    font-weight:600;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;
                }
                .plink-arrow{ font-size:16px; color: rgba(15,23,42,.55); }

                @media (max-width:768px){
                    .top-actions{ gap:8px; padding:6px; }
                    .prop-dd{ min-width:120px; }
                    .profile-popup{ width:92vw; right:0; }
                }
            </style>

            <!-- ✅ JS (DO NOT TOUCH OTHER JS) -->
            <script type="text/javascript">
                function PopupProfileClick() {
                    var pop = document.getElementById('<%= popupprofile.ClientID %>');
                    if (!pop) return;

                    if (pop.style.display === 'block') {
                        pop.style.display = 'none';
                    } else {
                        pop.style.display = 'block';
                    }
                }

                // Close popup on outside click (safe for UpdatePanel)
                (function () {
                    function wireOutsideClose() {
                        var pop = document.getElementById('<%= popupprofile.ClientID %>');
                        var btn = document.getElementById('<%= ImageButton1.ClientID %>');
                        if (!pop || !btn) return;

                        document.addEventListener('click', function (e) {
                            if (pop.style.display !== 'block') return;
                            if (pop.contains(e.target) || btn.contains(e.target)) return;
                            pop.style.display = 'none';
                        }, true);
                    }

                    if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () { wireOutsideClose(); });
                    }
                    document.addEventListener('DOMContentLoaded', wireOutsideClose);
                })();
            </script>

        </ContentTemplate>

        <Triggers>
            <asp:AsyncPostBackTrigger ControlID="Timer1" EventName="Tick" />
        </Triggers>
    </asp:UpdatePanel>
</div>





