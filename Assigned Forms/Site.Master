    <style>
        :root {
    --sidebar-width: 190px;
    --header-height: 64px;
}

body {
    transition: padding-left .22s ease;
}

#sidebar {
    width: var(--sidebar-width);
    height: 100vh;
    position: fixed;
    top: 0 !important;
    left: 0;
    z-index: 1000;
    background: #ffffff;
    overflow-y: auto;
    overflow-x: hidden;
    transition: transform .22s ease;
}

#header {
    left: var(--sidebar-width) !important;
    width: calc(100% - var(--sidebar-width)) !important;
    height: var(--header-height);
    transition: left .22s ease, width .22s ease;
}

body.sidebar-collapsed #sidebar {
    transform: translateX(-100%);
}

body.sidebar-collapsed #header {
    left: 0 !important;
    width: 100% !important;
}

body.sidebar-collapsed #main,
body.sidebar-collapsed #main1,
body.sidebar-collapsed .main,
body.sidebar-collapsed .content,
body.sidebar-collapsed .page-content {
    margin-left: 0 !important;
}

#main,
#main1,
.main,
.content,
.page-content {
    margin-left: var(--sidebar-width) !important;
    transition: margin-left .22s ease;
}

.header-sidebar-toggle {
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 12px;
    background: #eef2f7;
    color: #334155;
    font-size: 16px;
    margin: 12px 8px 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.header-sidebar-toggle:hover {
    background: #dbeafe;
    color: #0f766e;
}

.sidebar-brand {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
   /* border-bottom: 1px solid #e5e7eb;*/
}

.sidebar-logo {
    height: 42px;
    max-width: 145px;
    object-fit: contain;
}

.sidebar-menu-btn {
    width: 30px;
    height: 30px;
    cursor: pointer;
}


/* ================= TOPBAR TOGGLE ================= */

.topbar-toggle-btn{
    width:36px;
    height:36px;
    border:none;
    border-radius:12px;

    display:flex;
    align-items:center;
    justify-content:center;

    background: linear-gradient(135deg,#eff6ff,#f8fafc);

    color:#334155;
    font-size:16px;

    border:1px solid rgba(15,23,42,.08);

    box-shadow:
        0 8px 18px rgba(15,23,42,.06),
        inset 0 1px 0 rgba(255,255,255,.7);

    transition: all .18s ease;
}

.topbar-toggle-btn:hover{
    transform: translateY(-1px);
    background: linear-gradient(135deg,#dbeafe,#eff6ff);
    color:#2563eb;
}

.topbar-toggle-btn:active{
    transform: scale(.96);
}

/* ================= TOPBAR ANIMATION ================= */

#topbar{
    transition:
        opacity .22s ease,
        transform .22s ease,
        width .22s ease;
}

body.topbar-hidden #topbar{
    opacity:0;
    transform:translateX(-20px);

    width:0 !important;
    overflow:hidden;

    pointer-events:none;
}

/* expand right section */
body.topbar-hidden .top-actions-wrap{
    margin-left:auto;
}
