          border-radius: 4px 0 0 4px;
      }

      .day-cell.end-date {
          background: #20b2aa;
          color: white;
          border-radius: 0 4px 4px 0;
      }

      .day-cell.start-date.end-date {
          border-radius: 4px;
      }

      .calendar-footer {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-top: 20px;
          padding-top: 15px;
          border-top: 1px solid #e0e0e0;
      }

      .date-range-text {
