    <style>
                .alertpopup {
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(20px);
                    border-radius: 24px;
                    padding: 40px;
                    max-width:500px;
                    width: 90%;
                    box-shadow: 
                        0 25px 50px rgba(0, 0, 0, 0.2),
                        0 0 0 1px rgba(255, 255, 255, 0.1);
                    animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    overflow: hidden;
                    transform: translate(-50%, -50%);
                    z-index:999;
                }
                .popupoverlay {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.6);
                    backdrop-filter: blur(8px);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    animation: fadeIn 0.3s ease-out;
                }
                .icon-container {
                    display: flex;
                    justify-content: center;
                    margin-bottom: 24px;
                }
                .warning-icon {
                    width: 80px;
                    height: 80px;
                    background: linear-gradient(135deg, #ff6b6b, #ff8e53);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    animation: pulse 2s infinite;
                    box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
                }
                .warning-icon svg {
                    width: 40px;
                    height: 40px;
                    color: white;
                }
                .alertpopup h2 {
                    font-size: 28px;
                    font-weight: 700;
                    color: #2d3748;
                    text-align: center;
                    margin-bottom: 16px;
                    background: linear-gradient(135deg, #2d3748, #4a5568);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }
                .alertpopup p {
                    font-size: 15px;
                    color: #4a5568;
                    text-align: center;
                    line-height: 1.6;
                    margin-bottom: 32px;
                }
                .highlight {
                    font-size:16px;
                    color: #e53e3e;
                    font-weight: 600;
                }
                .button-group {
                    display: flex;
                    gap: 16px;
                    justify-content: center;
                }
                .btn {
                    padding: 14px 32px;
                    border-radius: 12px;
                    border: none;
                    font-size: 16px;
                    font-weight: 600;
                    cursor: pointer;
                    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    position: relative;
                    overflow: hidden;
                    min-width: 120px;
                }
                .btn::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 100%;
                    height: 100%;
                    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                    transition: left 0.5s;
                }
                .btn:hover::before {
                    left: 100%;
                }
                .btn-cancel {
                    background: #ff7961;
                    color: white;
                    border: 2px solid #e2e8f0;
                }
                .btn-cancel:hover {
                    background: #ff7961cf;
                    border-color: #cbd5e0;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
                }
                .btn-confirm {
                    background: linear-gradient(135deg, #ff6b6b, #ee5a52);
                    color: white;
                    box-shadow: 0 8px 25px rgba(255, 107, 107, 0.3);
                }
                .btn-confirm:hover {
                    background: linear-gradient(135deg, #ee5a52, #e53e3e);
                    transform: translateY(-2px);
                    box-shadow: 0 12px 35px rgba(255, 107, 107, 0.4);
                }

                .btn:active {
                    transform: translateY(0);
                }

                @keyframes fadeIn {
                    from {
                        opacity: 0;
                    }
                    to {
                        opacity: 1;
                    }
                }

               @keyframes popIn {
                    from {
                        opacity: 0;
                        transform: translate(-50%, -50%) scale(0.8);
                    }
                    to {
                        opacity: 1;
                        transform: translate(-50%, -50%) scale(1);
                    }
                }


                @keyframes pulse {
                    0%, 100% {
                        transform: scale(1);
                    }
                    50% {
                        transform: scale(1.05);
                    }
                }

                @keyframes gradientShift {
                    0%, 100% {
                        background-position: 0% 0%;
                    }
                    50% {
                        background-position: 100% 0%;
                    }
                }

                /* Mobile responsiveness */
                @media (max-width: 480px) {
                    .popup {
                        padding: 32px 24px;
                        margin: 20px;
                    }

                    .popup h2 {
                        font-size: 24px;
                    }

                    .button-group {
                        flex-direction: column;
                    }

                    .btn {
                        width: 100%;
                    }
                }

                /* Dark mode support */
                @media (prefers-color-scheme: dark) {
                    .popup {
                        background: rgba(26, 32, 44, 0.95);
                        color: #e2e8f0;
                    }
                    .popup h2 {
                        background: linear-gradient(135deg, #e2e8f0, #cbd5e0);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                    }
                    .popup p {
                        color: #a0aec0;
                    }
                    .btn-cancel {
                        background: #2d3748;
                        color: #e2e8f0;
                        border-color: #4a5568;
                    }
                    .btn-cancel:hover {
                        background: #4a5568;
                        border-color: #718096;
                    }
                }
body{
    font-family: 'Montserrat', sans-serif;
}
/* ================= PROFESSIONAL SIDEBAR ================= */

#sidebar {
    width: 230px;
    height: 100vh;
    position: fixed;
    top: 0 !important;
    left: 0;
    z-index: 1000;
    overflow-y: auto;
    overflow-x: hidden;
    background: #ffffff;
    font-family: 'Montserrat', sans-serif;
    box-shadow: 8px 0 24px rgba(15, 23, 42, .08);
   /* border-right: 1px solid #e5e7eb;*/
     scrollbar-width: none;
    scrollbar-color: #cbd5e1 #f8fafc;
    padding-bottom: 90px; /* important for footer space */
}

.sidebar-brand {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
  /*  border-bottom: 1px solid #e5e7eb;*/
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 5;
    box-shadow: 0 2px 10px rgba(15,23,42,.04);
}

.sidebar-menu-btn {
    width: 32px;
    height: 32px;
    object-fit: contain;
    cursor: pointer;
}

.sidebar-logo {
    height: 42px;
    max-width: 150px;
    object-fit: contain;
}

/* Chrome / Edge */
#sidebar::-webkit-scrollbar {
    width: 2px;
}

#sidebar::-webkit-scrollbar-track {
    background: #f8fafc;
    border-radius: 20px;
}

#sidebar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 20px;
    border: 2px solid #f8fafc;
}

#sidebar::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
}


#sidebar a {
    text-decoration: none !important;
}

/* Category */
#sidebar .category-link {
    display: flex !important;
    align-items: center;
    gap: 2px;
    min-height: 38px;
    padding: 0 3px !important;
    margin: 5px 3px 0 3px !important;
    border-radius: 8px;
    background: #0000000d !important;
    color: #dbeafe !important;
    border: 1px solid transparent;
    transition: all .18s ease;
}

#sidebar .category-link:hover {
    background: rgba(59,130,246,.14) !important;
    border-color: rgba(147,197,253,.16);
    color: #fff !important;
}

#sidebar .category-link.open {
    background: rgba(59,130,246,.14) !important;
    color: #fff !important;
}

#sidebar .cat-ico {
    width: 26px;
    height: 26px;
    min-width: 26px;
    border-radius: 0px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.10);
    color: #68696d;
    font-size: 15px;
}

#sidebar .cat-text {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    font-weight: 500;
    color: rgb(69 63 63 / 75%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#sidebar .cat-arrow {
    width: 18px;
    height: 18px;
    min-width: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgb(69 63 63 / 75%);
    font-size: 8px;
    transition: transform .18s ease;
}

#sidebar .category-link.open .cat-arrow {
    transform: rotate(180deg);
}

/* Submenu */
#sidebar .submenu {
    display: none;
    margin: 4px 4px 4px 4px;
    padding: 2px 0 2px 4px;
    border-left: 1px dashed rgba(255,255,255,.16);
}

#sidebar .submenu a {
    display: flex !important;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 0 0px !important;
    margin: 3px 0 3px 0px;
    border-radius: 8px;
    background: transparent !important;
    color: #cbd5e1 !important;
    border: 1px solid transparent;
    transition: all .16s ease;
}

#sidebar .submenu a:hover {
    background: #dbecff !IMPORTANT;
    color: #fff !important;
    transform: translateX(2px);
}

#sidebar .submenu a.active-menu {
    background: #dbecff !important;
    color: #111827 !important;
    font-weight: normal;
}

#sidebar .submenu a.active-menu .menu-ico,
#sidebar .submenu a.active-menu .menu-text {
    color: #111827 !important;
}

#sidebar .menu-ico {
    width: 18px;
    min-width: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #93c5fd;
}

#sidebar .menu-text {
    flex: 1;
    min-width: 0;
    font-size: 11px;
    font-weight: normal;
    color: black;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#sidebar .credits {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 190px;
    height: 40px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background: #071426;
    border-top: 1px solid rgba(255,255,255,.08);

    z-index: 1001;

    font-size: 10px;
    color: rgba(255,255,255,.75);

    box-shadow: 0 -4px 14px rgba(0,0,0,.12);
}

#sidebar .credits p {
    margin: 0;
    line-height: 14px;
}

#sidebar .credits a {
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
}

/* collapsed sidebar */
body.sidebar-collapsed #sidebar .credits {
    display: none;
}

/* mobile */
@media only screen and (max-width: 768px) {

    #sidebar .credits {
        width: 260px;
    }
}
/* Mobile */
@media only screen and (max-width: 768px) {
    #sidebar {
        width: 0;
        transition: width .2s ease;
    }

    #sidebar.open {
        width: 100%;
    }
}






