<%--    added by Waseem--%>
    <script>
        (function () {

            // ✅ Category icons (edit as you like)
            const categoryIcons = {
                "Front Desk": "fa-solid fa-bell-concierge",
                "Reservation": "fa-solid fa-calendar-check",
                "Accounts": "fa-solid fa-file-invoice-dollar",
                "Reports": "fa-solid fa-chart-line",
                "House Keeping": "fa-solid fa-broom",
                "Maintenance": "fa-solid fa-screwdriver-wrench",
                "Restaurant": "fa-solid fa-utensils",
                "Inventory": "fa-solid fa-boxes-stacked",
                "Settings": "fa-solid fa-gear",
                "Users": "fa-solid fa-user-gear",
                "Council": "fa-solid fa-building-columns",
                "Dashboard": "fa-solid fa-gauge-high",
                "Support": "fa-solid fa-headset"
            };

            // ✅ Menu icons (submenu icons by menu text)
            const menuIcons = {
                "Calendar": "fa-solid fa-calendar-days",
                "Generate Reservation": "fa-solid fa-file-circle-plus",
                "Payment Link": "fa-solid fa-link",
                "Make Payment": "fa-solid fa-credit-card",
                "Check In": "fa-solid fa-right-to-bracket",
                "Check Out": "fa-solid fa-right-from-bracket",
                "Invoice": "fa-solid fa-receipt",
                "Customer List": "fa-solid fa-users",
                "Reservation List": "fa-solid fa-list-check",
                "Room Status": "fa-solid fa-bed",
                "Block Room": "fa-solid fa-ban",
                "Bulk Check In": "fa-solid fa-layer-group",
                "Bulk Check Out": "fa-solid fa-layer-group",
                "Occupancy Report": "fa-solid fa-chart-pie",
                "Income Comparison": "fa-solid fa-scale-balanced",
                "Users": "fa-solid fa-user",
                "Roles": "fa-solid fa-user-shield",
                "Audit Log": "fa-solid fa-clipboard-list",
                "Notifications": "fa-solid fa-bell"
            };

            const fallbackCat = "fa-solid fa-layer-group";
            const fallbackMenu = "fa-regular fa-circle-dot";

            function normalize(s) {
                return (s || "").replace(/\s+/g, " ").trim().toLowerCase();
            }

            function setIcon(el, classes) {
                if (!el) return;
                // remove previous FA classes
                el.className = el.className.replace(/\bfa-\S+/g, "").trim();
                // apply new
                classes.split(" ").forEach(c => el.classList.add(c));
            }

            function applySidebarIcons() {
                const sidebar = document.getElementById("sidebar");
                if (!sidebar) return;

                // --- Categories
                const catLinks = sidebar.querySelectorAll('a[id^="category_"]');
                catLinks.forEach(a => {
                    const span = a.querySelector("span"); // category text span
                    const text = span ? span.textContent.trim() : "";
                    const key = Object.keys(categoryIcons).find(k => normalize(k) === normalize(text));
                    const iconClass = key ? categoryIcons[key] : fallbackCat;

                    const ico = a.querySelector(".cat-ico");
                    setIcon(ico, iconClass);
                });

                // --- Menus
                const menuLinks = sidebar.querySelectorAll('.menu-container a[id^="menu_"]');
                menuLinks.forEach(a => {
                    const span = a.querySelector("span");
                    const text = span ? span.textContent.trim() : "";
                    const key = Object.keys(menuIcons).find(k => normalize(k) === normalize(text));
                    const iconClass = key ? menuIcons[key] : fallbackMenu;

                    const ico = a.querySelector(".menu-ico");
                    setIcon(ico, iconClass);
                });
            }

            document.addEventListener("DOMContentLoaded", applySidebarIcons);

            // ✅ also re-run after UpdatePanel postback (ASP.NET)
            if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    applySidebarIcons();
                });
            }

        })();
    </script>



