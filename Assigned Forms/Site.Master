</div>
    <asp:Repeater ID="catRepeater" runat="server" OnItemDataBound="mainRepeater_ItemDataBound">
        <ItemTemplate>

            <a id="category_<%# Container.ItemIndex %>_<%# Eval("category") %>"
               class="nav-link category-link"
               onclick="toggleMenu(this); event.stopPropagation();">

                <i class="cat-ico fa-solid fa-layer-group"></i>

                <span class="cat-text">
                    <%# Eval("category") %>
                </span>

                <span class="cat-arrow">
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </a>

            <div class="menu-container submenu">
                <asp:Repeater ID="menuRepeater" runat="server">
                    <ItemTemplate>
                        <a id="menu_<%# Container.ItemIndex %>_<%# Eval("menu") %>"
                           class="nav-link sidebar-menu-link"
                           data-page="<%# Eval("page_name") %>"
                           onclick="rememberSidebarBeforeNav(this); setSelectedSidebar(this);"
                           href='<%# BuildSignedMenuUrl(Eval("page_name"), Eval("userid"), Eval("username"), Eval("hotelid"), Eval("role"), Eval("hotelrole"), Eval("hotelname")) %>'>

                            <i class="menu-ico fa-regular fa-circle-dot"></i>

                            <span class="menu-text">
                                <%# Eval("menu") %>
                            </span>
                        </a>
                    </ItemTemplate>
                </asp:Repeater>
            </div>

        </ItemTemplate>
    </asp:Repeater>

    <div class="credits">
        Powered By
        <p style="margin:0;">
            <a href="https://Techgeni.co.uk">Tech Geni Ltd.</a>
        </p>
    </div>
</div>

      <script>
          document.addEventListener("DOMContentLoaded", function () {
              activateCurrentSidebarPage();
          });

          function getCurrentPageName() {
              var path = window.location.pathname || "";
              var file = path.substring(path.lastIndexOf("/") + 1);
              return file.replace(".aspx", "").toLowerCase();
          }

          function closeAllSidebarMenus() {
              document.querySelectorAll("#sidebar .submenu").forEach(function (submenu) {
                  submenu.style.display = "none";
              });

              document.querySelectorAll("#sidebar .category-link").forEach(function (cat) {
                  cat.classList.remove("open");
              });

              document.querySelectorAll("#sidebar .sidebar-menu-link").forEach(function (menu) {
                  menu.classList.remove("active-menu");
              });
          }

          function activateCurrentSidebarPage() {
              var currentPage = getCurrentPageName();
              if (!currentPage) return;

              closeAllSidebarMenus();

              var matchedMenu = null;

              document.querySelectorAll("#sidebar .sidebar-menu-link").forEach(function (menu) {
                  var page = (menu.getAttribute("data-page") || "").toLowerCase();

                  if (page === currentPage) {
                      matchedMenu = menu;
                  }
              });

              if (!matchedMenu) return;

              matchedMenu.classList.add("active-menu");

              var submenu = matchedMenu.closest(".submenu");
              if (submenu) {
                  submenu.style.display = "block";

                  var category = submenu.previousElementSibling;
                  if (category && category.classList.contains("category-link")) {
                      category.classList.add("open");
                  }
              }
          }

          function toggleMenu(a) {
              var submenu = a.nextElementSibling;
              if (!submenu || !submenu.classList.contains("submenu")) return;

              var isOpen = submenu.style.display === "block";

              closeAllSidebarMenus();

              if (!isOpen) {
                  submenu.style.display = "block";
                  a.classList.add("open");
              } else {
                  activateCurrentSidebarPage();
              }
          }

          function setSelectedSidebar(a) {
              document.querySelectorAll("#sidebar .sidebar-menu-link").forEach(function (menu) {
                  menu.classList.remove("active-menu");
              });

              a.classList.add("active-menu");

              var submenu = a.closest(".submenu");
              if (submenu) {
                  closeAllSidebarMenus();
                  submenu.style.display = "block";
                  a.classList.add("active-menu");

                  var category = submenu.previousElementSibling;
                  if (category && category.classList.contains("category-link")) {
                      category.classList.add("open");
                  }
              }
          }

          function rememberSidebarBeforeNav(a) {
              if (!a) return;

              var page = a.getAttribute("data-page") || "";
              if (page) {
                  localStorage.setItem("sidebar_current_page", page.toLowerCase());
              }
          }

          if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
              Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                  activateCurrentSidebarPage();
              });
          }
      </script>



        <div class="screenblur" style=" display:none;" id="overlay" runat="server"></div>
        
        
        <div id="ChangePasswordpopup" runat="server" class="popupchangepassword">
           <div style="">
               <div style="margin-bottom:15px;">
                  <div class=" justify-content-between" style="display:flex; padding:7px; border-top-left-radius: 10px; border-top-right-radius: 10px; background-color:#e49e3a;">
                     <div style=" display:flex; padding-left:10px;">
                        <h4><span style=" vertical-align:middle; font-size:20px; margin-left:5px; font-weight:bold;">CHANGE PASSWORD</span></h4>
                     </div>
                     <div style=" vertical-align:middle; padding-right:10px; ">
                        <img runat="server"  onclick="CloseChangePasswordPopup(); return false;" ID="Imgchangepas" src="img/icons8-cross-50.png" style=" vertical-align:bottom; background-color:White; height:30px; width:30px;"/>
                     </div>
                  </div>
                  <div class="row" style="display:flex; align-items:center; margin:10px;">
                    <Label style=" margin-bottom:7px; padding:0px; white-space:nowrap;">Current Password</Label>
                    <asp:TextBox TextMode="password" autocomplete="new-password" type="password" ID="txt_changepaspopup" runat="server" CssClass="form-control"></asp:TextBox>
                  </div>
                  <div class="row" style="display:flex; align-items:center; margin:10px;">
                    <Label style=" margin-bottom:7px; padding:0px; white-space:nowrap;">New Password</Label>
                    <asp:TextBox TextMode="password" autocomplete="new-password" type="password" ID="txt_passwordchangenewpopup" runat="server" CssClass="form-control"></asp:TextBox>
                  </div>
                  <div class="row" style="display:flex; align-items:center; margin:10px;">
