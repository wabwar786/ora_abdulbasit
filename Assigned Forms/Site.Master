                            <div class="col-md-2 col-4">
                                <asp:Button  ID="Button1" Text="Clear All"  OnClick="clearNotifications" style="border:none; width:100%; padding:5px;  border-radius:3px; color:#0024ff; background-color:white; font-size:10px;" runat="server" />
