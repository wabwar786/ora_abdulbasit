      }

      .btn-clear:hover {
          background: #f0f0f0;
      }

      .btn-apply {
          background: #20b2aa;
          color: white;
          border-color: #20b2aa;
      }

      .btn-apply:hover {
          background: #1a9690;
      }

      .today {
          position: relative;
      }

      .today::after {
          content: '';
          position: absolute;
          bottom: 2px;
          left: 50%;
          transform: translateX(-50%);
          width: 4px;
          height: 4px;
          background: #20b2aa;
          border-radius: 50%;
      }
